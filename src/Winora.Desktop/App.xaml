<Application x:Class="Winora.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ctl="clr-namespace:Winora.Desktop.Controls">
 <Application.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries>
   <ui:ThemesDictionary Theme="Light"/><ui:ControlsDictionary/>
   <ResourceDictionary Source="Styles/Tokens.xaml"/>
   <ResourceDictionary Source="Styles/DensityComfortable.xaml"/>
   <ResourceDictionary Source="Styles/Theme.xaml"/>
   <ResourceDictionary Source="Styles/Components.xaml"/>
   <ResourceDictionary Source="Styles/PageFrame.xaml"/>
   <ResourceDictionary Source="Styles/Review.xaml"/>
   <ResourceDictionary Source="Styles/SettingsPage.xaml"/>
   <ResourceDictionary Source="Styles/PagesV2.xaml"/>
   <ResourceDictionary Source="Styles/ListRows.xaml"/>
   <ResourceDictionary Source="Styles/TunePages.xaml"/>
   <ResourceDictionary Source="Styles/Inputs.xaml"/>
   <ResourceDictionary Source="Styles/DiskCard.xaml"/>
   <ResourceDictionary Source="Styles/SplitButton.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <!-- Defined beside the merged dictionaries so BasedOn can see the WPF-UI implicit styles. -->
  <!-- A bar or ring that no page named gets a name when it loads (Controls/A11y.cs). -->
  <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"><Setter Property="ctl:A11y.AutoName" Value="True"/><Setter Property="Background" Value="{DynamicResource WinoraBarTrackBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WinoraBarBorderBrush}"/></Style>
  <Style x:Key="WinoraLtrText" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="FontFamily" Value="{StaticResource WinoraMonoFontFamily}"/><Setter Property="FontSize" Value="{StaticResource WinoraFontSizeCaption}"/><Setter Property="MinHeight" Value="{StaticResource MinHitTarget}"/><Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <!-- Selectable read-only text for the details pane: looks like text, can be selected and copied, shows a focus outline for keyboard users. -->
  <Style x:Key="WinoraSelectableText" TargetType="TextBox">
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="{StaticResource WinoraFontSizeBody}"/><Setter Property="Padding" Value="{StaticResource WinoraSpace.H4V2}"/><Setter Property="Margin" Value="{StaticResource WinoraSpace.Ln4}"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource WinoraCornerRadiusSmall}" Padding="{TemplateBinding Padding}">
     <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Two-choice selector: a horizontal group of buttons, one selected. Arrow keys move the selection. -->
  <Style x:Key="SegmentedItem" TargetType="ListBoxItem">
   <Setter Property="MinHeight" Value="{DynamicResource WinoraControlHeight}"/><Setter Property="MinWidth" Value="72"/><Setter Property="Padding" Value="{StaticResource WinoraSpace.H12V2}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource WinoraCornerRadiusSmall}" Margin="{StaticResource WinoraSpace.None}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SegmentedList" TargetType="ListBox">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentedItem}"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="KeyboardNavigation.TabNavigation" Value="Once"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></Setter.Value></Setter>
   <!-- No template of the base list box: it paints a white background when the list is disabled, which hides the labels in the dark theme. -->
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource WinoraControlBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource WinoraCornerRadiusSmall}" Padding="{StaticResource WinoraSpace.A2}" HorizontalAlignment="Stretch"><ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}"><Setter Property="MinHeight" Value="{DynamicResource MinHitTarget}"/></Style>
  <Style TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}"><Setter Property="MinHeight" Value="{DynamicResource WinoraControlHeight}"/><Setter Property="MinWidth" Value="{DynamicResource WinoraControlHeight}"/><Setter Property="Padding" Value="{StaticResource WinoraSpace.H12V4}"/><Setter Property="CornerRadius" Value="6"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}"><Setter Property="MinHeight" Value="{DynamicResource MinHitTarget}"/><Setter Property="MinWidth" Value="180"/></Style>
  <Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource DefaultUiToggleSwitchStyle}"><Setter Property="MinHeight" Value="{DynamicResource MinHitTarget}"/></Style>
  <!-- The settings rows (WPF-UI CardControl) take the Winora card surface and edge, so they match the cards built from WinoraCardBorder. -->
  <Style TargetType="ui:CardControl" BasedOn="{StaticResource DefaultUiCardControlStyle}">
   <Setter Property="Background" Value="{DynamicResource WinoraSurfaceCardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WinoraCardBorderBrush}"/><Setter Property="BorderThickness" Value="{DynamicResource WinoraBorderThickness}"/>
  </Style>
 </ResourceDictionary></Application.Resources>
</Application>
