<UserControl x:Class="Winora.Desktop.Controls.RowMenuButton"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ctl="clr-namespace:Winora.Desktop.Controls"
 Focusable="False">
 <ui:Button x:Name="Kebab" ctl:MenuButton.OpensMenuOnClick="True" Appearance="Transparent" BorderThickness="0" Background="Transparent" Padding="{StaticResource WinoraSpace.A8}" VerticalAlignment="Center" IsTabStop="{Binding Tabbable, RelativeSource={RelativeSource AncestorType=ctl:RowMenuButton}}">
  <ui:SymbolIcon Symbol="MoreVertical20" FontSize="16"/>
  <ui:Button.ContextMenu>
   <ContextMenu x:Name="Menu">
    <MenuItem x:Name="DetailsItem" Visibility="Collapsed"/>
    <MenuItem x:Name="ResetItem" Visibility="Collapsed"/>
    <MenuItem x:Name="UndoItem" Visibility="Collapsed"/>
    <MenuItem x:Name="CopyItem" Visibility="Collapsed"/>
   </ContextMenu>
  </ui:Button.ContextMenu>
 </ui:Button>
</UserControl>
