<UserControl x:Class="Winora.Desktop.Controls.GlobalSearchBox"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ctl="clr-namespace:Winora.Desktop.Controls"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Focusable="False" IsTabStop="False" shell:WindowChrome.IsHitTestVisibleInChrome="True" Width="340" VerticalAlignment="Center">
 <Grid>
  <TextBlock x:Name="LabelText" Text="{Binding Text[SearchBoxName]}" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" AutomationProperties.Name="{Binding Text[SearchBoxName]}"/>
  <ui:TextBox x:Name="Box" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding Text[SearchPlaceholder]}" ClearButtonEnabled="False" Icon="{ui:SymbolIcon Search20}"
   MinHeight="32" Margin="{StaticResource WinoraSpace.V4}"
   AutomationProperties.Name="{Binding Text[SearchBoxName]}" AutomationProperties.HelpText="{Binding Text[SearchBoxHelp]}" AutomationProperties.LabeledBy="{Binding ElementName=LabelText}"
   PreviewKeyDown="OnBoxKeyDown" GotKeyboardFocus="OnBoxGotFocus"/>
  <TextBlock x:Name="Announcement" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite"/>
  <Popup x:Name="Results" PlacementTarget="{Binding ElementName=Box}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None" IsOpen="{Binding IsOpen, Mode=OneWay}" Focusable="False">
   <Border Margin="{StaticResource WinoraSpace.T4B12}" Padding="{StaticResource WinoraSpace.A4}" CornerRadius="{StaticResource WinoraCornerRadius}" BorderThickness="1" Background="{DynamicResource WinoraSurfaceRaisedBrush}" BorderBrush="{DynamicResource WinoraCardBorderBrush}"
    MinWidth="{Binding ActualWidth, ElementName=Box}" MaxWidth="480" AutomationProperties.Name="{Binding Text[SearchResultsName]}"
    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" PreviewKeyDown="OnFlyoutKeyDown" LostKeyboardFocus="OnFlyoutLostFocus">
    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/></Border.Effect>
    <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" Focusable="False">
     <StackPanel>
      <ctl:EmptyState Icon="Search24" Headline="{Binding NoResultsText}" Message="{Binding Text[SearchNoMatchHint]}" ActionText="{Binding Text[SearchClear]}" ActionHelp="{Binding Text[SearchClearHelp]}" ActionCommand="{Binding ClearCommand}"
       Visibility="{Binding NoResults, Converter={StaticResource BoolToVisibility}}"/>
      <ItemsControl ItemsSource="{Binding Groups}" IsTabStop="False" Focusable="False">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <StackPanel Margin="{StaticResource WinoraSpace.B4}">
          <TextBlock Text="{Binding Title}" Style="{StaticResource WinoraCaption}" FontWeight="SemiBold" Margin="{StaticResource WinoraSpace.L8T4R8B2}" AutomationProperties.HeadingLevel="Level2"/>
          <ItemsControl ItemsSource="{Binding Rows}" IsTabStop="False" Focusable="False">
           <ItemsControl.ItemTemplate>
            <DataTemplate>
             <Button x:Name="RowButton" Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" Padding="{StaticResource WinoraSpace.H8V4}" Margin="{StaticResource WinoraSpace.V1}" Background="Transparent" BorderThickness="2" BorderBrush="Transparent"
              Click="OnRowClick" AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.HelpText="{Binding DataContext.Text[SearchRowHelp], RelativeSource={RelativeSource AncestorType=UserControl}}">
              <Button.Template>
               <ControlTemplate TargetType="Button">
                <Border x:Name="Frame" CornerRadius="{StaticResource WinoraCornerRadiusSmall}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                 <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                 <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
                </ControlTemplate.Triggers>
               </ControlTemplate>
              </Button.Template>
              <Grid>
               <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
               <ui:SymbolIcon Symbol="{Binding Icon, Converter={x:Static ctl:IconKeys.Symbol}}" FontSize="24" Margin="{StaticResource WinoraSpace.T2R8}" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
               <StackPanel Grid.Column="1">
                <ctl:HighlightedText Parts="{Binding Parts}" Style="{StaticResource WinoraBody}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Breadcrumb}" Style="{StaticResource WinoraCaption}" TextWrapping="Wrap"/>
                <WrapPanel Margin="{StaticResource WinoraSpace.T4}" Visibility="{Binding HasRisk, Converter={StaticResource BoolToVisibility}}">
                 <ctl:RiskChip Level="{Binding Risk}" Text="{Binding RiskText}" Margin="{StaticResource WinoraSpace.R4}"/>
                 <ctl:SourceChip SourceClass="{Binding Source}" Text="{Binding SourceText}" Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}"/>
                </WrapPanel>
               </StackPanel>
              </Grid>
             </Button>
             <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
               <Setter TargetName="RowButton" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
               <Setter TargetName="RowButton" Property="BorderBrush" Value="{DynamicResource WinoraFocusBrush}"/>
              </DataTrigger>
             </DataTemplate.Triggers>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ui:Button Content="{Binding ShowAllText}" Command="{Binding ShowAllCommand}" Appearance="Transparent" Margin="{StaticResource WinoraSpace.L4T2}" HorizontalAlignment="Left"
           Visibility="{Binding CanShowAll, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding ShowAllText}"/>
         </StackPanel>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Popup>
 </Grid>
</UserControl>
