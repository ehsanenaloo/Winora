<UserControl x:Class="Winora.Desktop.Controls.ActionCenterStrip"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ctl="clr-namespace:Winora.Desktop.Controls"
 Focusable="False" IsTabStop="False" Visibility="{Binding ShowStrip, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="ActionCenterStrip"
 AutomationProperties.Name="{Binding StripRegionName}">
 <!-- The strip sits at the bottom of the content area while the Action center is closed and has something to say. Clicking the text opens the pane on the matching tab. -->
 <Border Background="{DynamicResource WinoraSurfaceRaisedBrush}" BorderBrush="{DynamicResource WinoraCardBorderBrush}" BorderThickness="0,1,0,0" Padding="{StaticResource WinoraSpace.H16V4}" MinHeight="44">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.LiveSetting="Off">
    <ui:ProgressRing Margin="{StaticResource WinoraSpace.R8}" IsIndeterminate="{Binding StripIsRun}" Visibility="{Binding StripIsRun, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Text[Working]}"/>
    <ui:SymbolIcon Symbol="PanelRight20" FontSize="16" Margin="{StaticResource WinoraSpace.R8}" Visibility="{Binding StripIsStaged, Converter={StaticResource BoolToVisibility}}"/>
    <ui:SymbolIcon Symbol="{Binding StripNoteLevel, Converter={x:Static ctl:ActionCenterLook.Symbol}}" Foreground="{Binding StripNoteLevel, Converter={x:Static ctl:ActionCenterLook.Brush}}" FontSize="16" Margin="{StaticResource WinoraSpace.R8}"
     Visibility="{Binding StripIsNote, Converter={StaticResource BoolToVisibility}}"/>
    <TextBlock Text="{Binding StripTitle}" Style="{StaticResource WinoraBodyStrong}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="420" AutomationProperties.AutomationId="ActionCenterStripText"/>
    <ctl:ActivityBar Style="{StaticResource {x:Type ProgressBar}}" Width="120" Height="4" Margin="{StaticResource WinoraSpace.L12}" Minimum="0" Maximum="1" Value="{Binding StripShare, Mode=OneWay}" IsWorking="False" VerticalAlignment="Center"
     Visibility="{Binding StripIsDeterminate, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding StripTitle}"/>
    <TextBlock Text="{Binding StripShareText}" Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.L8}" VerticalAlignment="Center" Visibility="{Binding StripIsRun, Converter={StaticResource BoolToVisibility}}"/>
    <TextBlock Text="{Binding StripNothingApplied}" Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.L12}" VerticalAlignment="Center" Visibility="{Binding StripIsStaged, Converter={StaticResource BoolToVisibility}}"/>
    <TextBlock Text="{Binding StripMore}" Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.L8}" VerticalAlignment="Center" Visibility="{Binding HasStripMore, Converter={StaticResource BoolToVisibility}}"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <ui:Button Content="{Binding StripStopText}" Command="{Binding StripStopCommand}" AutomationProperties.HelpText="{Binding Text[ACStopHelp]}" Margin="{StaticResource WinoraSpace.L8}" Visibility="{Binding StripIsRun, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="ActionCenterStripStop"/>
    <ui:Button Content="{Binding StripReviewText}" Command="{Binding ReviewCommand}" Appearance="Primary" AutomationProperties.HelpText="{Binding ReviewHelp}" Margin="{StaticResource WinoraSpace.L8}" Visibility="{Binding StripIsStaged, Converter={StaticResource BoolToVisibility}}"
     AutomationProperties.AutomationId="ActionCenterStripReview"/>
    <ui:Button Content="{Binding StripViewText}" Command="{Binding OpenCommand}" AutomationProperties.HelpText="{Binding Text[ACViewHelp]}" Margin="{StaticResource WinoraSpace.L8}" Visibility="{Binding StripIsNote, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="ActionCenterStripView"/>
    <ui:Button Content="{Binding StripOpenText}" Command="{Binding OpenCommand}" Appearance="Transparent" AutomationProperties.HelpText="{Binding Text[ACViewHelp]}" Margin="{StaticResource WinoraSpace.L8}"
     Visibility="{Binding StripShowsOpen, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="ActionCenterStripOpen"/>
   </StackPanel>
  </Grid>
 </Border>
</UserControl>
