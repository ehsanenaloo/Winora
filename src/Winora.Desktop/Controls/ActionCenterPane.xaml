<UserControl x:Class="Winora.Desktop.Controls.ActionCenterPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ctl="clr-namespace:Winora.Desktop.Controls"
 Focusable="False" IsTabStop="False" AutomationProperties.AutomationId="ActionCenter" AutomationProperties.Name="{Binding ButtonName}">
 <UserControl.Resources>
  <!-- The tab strip: two text tabs with a count; the selected one has a line under it. Arrow keys move between them (TabControl). -->
  <Style x:Key="WinoraActionCenterTab" TargetType="TabItem">
   <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/><Setter Property="Padding" Value="{StaticResource WinoraSpace.H12V8}"/><Setter Property="FocusVisualStyle" Value="{DynamicResource WinoraFocusRect}"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding Header, RelativeSource={RelativeSource Self}}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="Frame" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" MinHeight="36" Cursor="Hand">
     <ContentPresenter ContentSource="Header" VerticalAlignment="Center" TextElement.FontSize="13" TextElement.FontWeight="SemiBold"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="WinoraActionCenterTabs" TargetType="TabControl">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="{StaticResource WinoraSpace.None}"/><Setter Property="ItemContainerStyle" Value="{StaticResource WinoraActionCenterTab}"/>
   <Setter Property="KeyboardNavigation.TabNavigation" Value="Local"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border BorderBrush="{DynamicResource WinoraCardBorderBrush}" BorderThickness="0,0,0,1" Padding="{StaticResource WinoraSpace.H8}"><TabPanel IsItemsHost="True" Background="Transparent"/></Border>
     <!-- The part name lets UI Automation expose the selected tab's content as children of its tab item; without it a screen reader sees an empty panel. -->
     <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A card of the lists: the surface and edge of every card of the app. -->
  <Style x:Key="WinoraActionCenterCard" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource WinoraSurfaceCardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WinoraCardBorderBrush}"/><Setter Property="BorderThickness" Value="{StaticResource WinoraBorderThickness}"/>
   <Setter Property="CornerRadius" Value="{StaticResource WinoraCornerRadius}"/><Setter Property="Padding" Value="{StaticResource WinoraSpace.A12}"/><Setter Property="Margin" Value="{StaticResource WinoraSpace.T8}"/>
  </Style>
  <Style x:Key="WinoraActionCenterIconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
   <Setter Property="Appearance" Value="Transparent"/><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="{StaticResource WinoraSpace.None}"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style x:Key="WinoraActionCenterHeading" TargetType="TextBlock" BasedOn="{StaticResource WinoraBodyStrong}"><Setter Property="Margin" Value="{StaticResource WinoraSpace.T16}"/></Style>
 </UserControl.Resources>
 <Border Background="{DynamicResource WinoraSurfaceRaisedBrush}" BorderBrush="{DynamicResource WinoraCardBorderBrush}" BorderThickness="1,0,0,0" Width="360">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="{StaticResource WinoraSpace.L16T8R8B4}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="Heading" Text="{Binding Name}" Style="{StaticResource WinoraCardTitle}" VerticalAlignment="Center" Focusable="True" FocusVisualStyle="{x:Null}"
     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
    <ui:Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource WinoraActionCenterIconButton}" Command="{Binding CloseCommand}" AutomationProperties.Name="{Binding Text[ACClose]}" AutomationProperties.HelpText="{Binding Text[ACCloseHelp]}" ToolTip="{Binding Text[ACClose]}"
     AutomationProperties.AutomationId="ActionCenterClose"><ui:SymbolIcon Symbol="Dismiss16" FontSize="16"/></ui:Button>
   </Grid>
   <TabControl x:Name="Tabs" Grid.Row="1" Style="{StaticResource WinoraActionCenterTabs}" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" AutomationProperties.Name="{Binding Text[ACTabs]}">
    <!-- Changes: staged changes of every page, grouped by page -->
    <TabItem x:Name="ChangesTab" Header="{Binding ChangesTabTitle}" AutomationProperties.AutomationId="ActionCenterChangesTab">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{StaticResource WinoraSpace.L12T4R12B12}" Focusable="False">
       <StackPanel>
        <StackPanel Margin="{StaticResource WinoraSpace.L4T32R4}" Visibility="{Binding ShowEmptyChanges, Converter={StaticResource BoolToVisibility}}">
         <TextBlock Text="{Binding Text[ACEmptyTitle]}" Style="{StaticResource WinoraBodyStrong}"/>
         <TextBlock Text="{Binding Text[ACEmptyBody]}" Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.T4}"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Groups}" IsTabStop="False">
         <ItemsControl.ItemTemplate><DataTemplate>
          <StackPanel Margin="{StaticResource WinoraSpace.T12}" AutomationProperties.Name="{Binding AutomationName}">
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
             <TextBlock Text="{Binding Title}" Style="{StaticResource WinoraBodyStrong}" AutomationProperties.HeadingLevel="Level3"/>
             <TextBlock Text="{Binding CountText}" Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.L4}" VerticalAlignment="Center"/>
            </StackPanel>
            <ui:Button Grid.Column="1" Content="{Binding DataContext.Text[ACOpen], RelativeSource={RelativeSource AncestorType=ctl:ActionCenterPane}}" Command="{Binding OpenCommand}" Appearance="Transparent"
             AutomationProperties.Name="{Binding OpenName}" AutomationProperties.HelpText="{Binding DataContext.Text[ACOpenHelp], RelativeSource={RelativeSource AncestorType=ctl:ActionCenterPane}}" MinHeight="28" Padding="{StaticResource WinoraSpace.H8V2}"/>
           </Grid>
           <ItemsControl ItemsSource="{Binding Items}" IsTabStop="False">
            <ItemsControl.ItemTemplate><DataTemplate>
             <Border Style="{StaticResource WinoraActionCenterCard}" AutomationProperties.Name="{Binding AutomationName}">
              <StackPanel>
               <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" Style="{StaticResource WinoraBodyStrong}" VerticalAlignment="Center"/>
                <ui:Button Grid.Column="1" Style="{StaticResource WinoraActionCenterIconButton}" Command="{Binding RemoveCommand}" Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                 AutomationProperties.Name="{Binding DiscardName}" AutomationProperties.HelpText="{Binding DataContext.Text[ACRemoveChangeHelp], RelativeSource={RelativeSource AncestorType=ctl:ActionCenterPane}}" ToolTip="{Binding DiscardName}"><ui:SymbolIcon Symbol="Dismiss16" FontSize="14"/></ui:Button>
               </Grid>
               <Grid Margin="{StaticResource WinoraSpace.T8}" Visibility="{Binding HasValues, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding BeforeLabel}" Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.R8B4}"/>
                <TextBlock Grid.Column="1" Text="{Binding Before}" Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.B4}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="2,0,0,0" Padding="{StaticResource WinoraSpace.L8T2B2}" Margin="{StaticResource WinoraSpace.Ln8}">
                 <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding AfterLabel}" Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.R8}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                  <TextBlock Grid.Column="1" Text="{Binding After}" Style="{StaticResource WinoraBodyStrong}"/>
                 </Grid>
                </Border>
               </Grid>
               <ctl:RiskChip Level="{Binding RiskValue}" Text="{Binding RiskText}" HorizontalAlignment="Left" Margin="{StaticResource WinoraSpace.T8}" Visibility="{Binding ShowRisk, Converter={StaticResource BoolToVisibility}}"/>
              </StackPanel>
             </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
           </ItemsControl>
          </StackPanel>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </ScrollViewer>
      <!-- Only with staged changes: with none, the empty message above says it once and there is nothing to review or discard. -->
      <Border x:Name="ChangesFooter" Grid.Row="1" Background="{DynamicResource WinoraSurfaceCardBrush}" BorderBrush="{DynamicResource WinoraCardBorderBrush}" BorderThickness="0,1,0,0" Padding="{StaticResource WinoraSpace.H16V12}"
       Visibility="{Binding HasStaged, Converter={StaticResource BoolToVisibility}}">
       <StackPanel>
        <TextBlock x:Name="Summary" Text="{Binding SummaryText}" Style="{StaticResource WinoraBodyStrong}" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ActionCenterSummary"/>
        <TextBlock Text="{Binding NoteText}" Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.T2B8}"/>
        <StackPanel Margin="{StaticResource WinoraSpace.B8}" Visibility="{Binding HasScope, Converter={StaticResource BoolToVisibility}}">
         <TextBlock Text="{Binding ScopeText}" Style="{StaticResource WinoraCaption}"/>
         <TextBlock Text="{Binding ScopeNote}" Style="{StaticResource WinoraCaption}" Foreground="{DynamicResource WinoraTextTertiaryBrush}"/>
        </StackPanel>
        <StackPanel Margin="{StaticResource WinoraSpace.B8}" Visibility="{Binding ShowBusyNote, Converter={StaticResource BoolToVisibility}}">
         <TextBlock Text="{Binding BusyNote}" Style="{StaticResource WinoraCaption}"/>
         <ui:Button Content="{Binding ViewText}" Command="{Binding ViewActivityCommand}" Appearance="Transparent" HorizontalAlignment="Left" MinHeight="28" Padding="{StaticResource WinoraSpace.H8V2}" AutomationProperties.HelpText="{Binding Text[ACViewHelp]}" AutomationProperties.AutomationId="ActionCenterViewBusy"/>
        </StackPanel>
        <ui:Button x:Name="ReviewButton" Command="{Binding ReviewCommand}" Appearance="Primary" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding ReviewText}"
         AutomationProperties.HelpText="{Binding ReviewHelp}" AutomationProperties.AutomationId="ActionCenterReview"/>
        <ui:Button x:Name="DiscardButton" Command="{Binding DiscardCommand}" Appearance="Transparent" HorizontalAlignment="Stretch" Margin="{StaticResource WinoraSpace.T4}"
         AutomationProperties.Name="{Binding DiscardText}" AutomationProperties.HelpText="{Binding DiscardHelp}" AutomationProperties.AutomationId="ActionCenterDiscard"/>
       </StackPanel>
      </Border>
     </Grid>
    </TabItem>
    <!-- Activity: what runs now and what happened -->
    <TabItem x:Name="ActivityTab" Header="{Binding ActivityTabTitle}" AutomationProperties.AutomationId="ActionCenterActivityTab">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{StaticResource WinoraSpace.L12T4R12B12}" Focusable="False">
       <StackPanel>
        <TextBlock Text="{Binding RunningHeading}" Style="{StaticResource WinoraActionCenterHeading}" AutomationProperties.HeadingLevel="Level3"/>
        <TextBlock Text="{Binding Text[ACNothingRunning]}" Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.T4}" Visibility="{Binding ShowNoRuns, Converter={StaticResource BoolToVisibility}}"/>
        <ItemsControl ItemsSource="{Binding Runs}" IsTabStop="False">
         <ItemsControl.ItemTemplate><DataTemplate>
          <Border Style="{StaticResource WinoraActionCenterCard}" AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.AutomationId="ActionCenterRun">
           <StackPanel>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <TextBlock Text="{Binding Title}" Style="{StaticResource WinoraBodyStrong}"/>
             <TextBlock Grid.Column="1" Text="{Binding ElapsedText}" Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.L8T2}" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding ElapsedText}"/>
            </Grid>
            <ctl:ActivityBar Style="{StaticResource {x:Type ProgressBar}}" Margin="{StaticResource WinoraSpace.T8}" Minimum="0" Maximum="1" Value="{Binding Share, Mode=OneWay}" IsWorking="{Binding IsIndeterminate}" Height="4" AutomationProperties.Name="{Binding Title}"/>
            <WrapPanel Margin="{StaticResource WinoraSpace.T8}">
             <TextBlock Text="{Binding PageName}" Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.R8}"/>
             <TextBlock Text="{Binding ShareText}" Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.R8}"/>
             <TextBlock Text="{Binding KindText}" Style="{StaticResource WinoraCaption}" Foreground="{DynamicResource WinoraTextTertiaryBrush}"/>
            </WrapPanel>
            <WrapPanel Margin="{StaticResource WinoraSpace.T8}">
             <ui:Button Content="{Binding StopText}" Command="{Binding StopCommand}" Margin="{StaticResource WinoraSpace.R8}" AutomationProperties.HelpText="{Binding DataContext.Text[ACStopHelp], RelativeSource={RelativeSource AncestorType=ctl:ActionCenterPane}}" ToolTip="{Binding StopReason}" AutomationProperties.AutomationId="ActionCenterStop"/>
             <ui:Button Content="{Binding DataContext.Text[ACGoToPage], RelativeSource={RelativeSource AncestorType=ctl:ActionCenterPane}}" Command="{Binding GoCommand}" Appearance="Transparent" AutomationProperties.HelpText="{Binding DataContext.Text[ACGoToPageHelp], RelativeSource={RelativeSource AncestorType=ctl:ActionCenterPane}}"/>
            </WrapPanel>
            <TextBlock Text="{Binding StopReason}" Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.T4}" Visibility="{Binding HasStopReason, Converter={StaticResource BoolToVisibility}}"/>
           </StackPanel>
          </Border>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Text[ACOneAtATime]}" Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.T8}" Visibility="{Binding ShowOneAtATime, Converter={StaticResource BoolToVisibility}}"/>
        <TextBlock Text="{Binding RecentHeading}" Style="{StaticResource WinoraActionCenterHeading}" Margin="{StaticResource WinoraSpace.T20}" AutomationProperties.HeadingLevel="Level3"/>
        <StackPanel Margin="{StaticResource WinoraSpace.T8}" Visibility="{Binding ShowNoNotes, Converter={StaticResource BoolToVisibility}}">
         <TextBlock Text="{Binding Text[ACNoActivityTitle]}" Style="{StaticResource WinoraBodyStrong}"/>
         <TextBlock Text="{Binding Text[ACNoActivityBody]}" Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.T4}"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Notes}" IsTabStop="False">
         <ItemsControl.ItemTemplate><DataTemplate>
          <Border Style="{StaticResource WinoraActionCenterCard}" AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.AutomationId="ActionCenterNote">
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ui:SymbolIcon Symbol="{Binding Level, Converter={x:Static ctl:ActionCenterLook.Symbol}}" Foreground="{Binding Level, Converter={x:Static ctl:ActionCenterLook.Brush}}" FontSize="16" Margin="{StaticResource WinoraSpace.T2R8}" VerticalAlignment="Top"
             AutomationProperties.Name="{Binding LevelName}"/>
            <StackPanel Grid.Column="1">
             <TextBlock Text="{Binding Text}" Style="{StaticResource WinoraBody}"/>
             <WrapPanel Margin="{StaticResource WinoraSpace.T4}">
              <TextBlock Text="{Binding PageName}" Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.R8}"/>
              <TextBlock Text="{Binding TimeText}" Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.R8}"/>
              <TextBlock Text="{Binding NewText}" Style="{StaticResource WinoraCaption}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}"/>
             </WrapPanel>
             <ui:Button Content="{Binding DataContext.Text[ACGoToPage], RelativeSource={RelativeSource AncestorType=ctl:ActionCenterPane}}" Command="{Binding GoCommand}" Appearance="Transparent" HorizontalAlignment="Left" Margin="{StaticResource WinoraSpace.Ln8T4}"
              AutomationProperties.HelpText="{Binding DataContext.Text[ACGoToPageHelp], RelativeSource={RelativeSource AncestorType=ctl:ActionCenterPane}}" MinHeight="28" Padding="{StaticResource WinoraSpace.H8V2}" Visibility="{Binding HasPage, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <ui:Button Grid.Column="2" Style="{StaticResource WinoraActionCenterIconButton}" Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding DataContext.Text[ACRemoveNote], RelativeSource={RelativeSource AncestorType=ctl:ActionCenterPane}}"
             AutomationProperties.HelpText="{Binding DataContext.Text[ACRemoveNoteHelp], RelativeSource={RelativeSource AncestorType=ctl:ActionCenterPane}}" ToolTip="{Binding DataContext.Text[ACRemoveNote], RelativeSource={RelativeSource AncestorType=ctl:ActionCenterPane}}"><ui:SymbolIcon Symbol="Dismiss16" FontSize="14"/></ui:Button>
           </Grid>
          </Border>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Text[ACKeepNote]}" Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.T16}" Foreground="{DynamicResource WinoraTextTertiaryBrush}"/>
       </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="1" Background="{DynamicResource WinoraSurfaceCardBrush}" BorderBrush="{DynamicResource WinoraCardBorderBrush}" BorderThickness="0,1,0,0" Padding="{StaticResource WinoraSpace.H16V12}">
       <StackPanel>
        <WrapPanel>
         <ui:Button Content="{Binding Text[ACMarkAllRead]}" Command="{Binding MarkAllReadCommand}" Margin="{StaticResource WinoraSpace.R8B4}" AutomationProperties.HelpText="{Binding Text[ACMarkAllReadHelp]}" AutomationProperties.AutomationId="ActionCenterMarkRead"/>
         <ui:Button Content="{Binding Text[ACClearAll]}" Command="{Binding ClearAllCommand}" Margin="{StaticResource WinoraSpace.R8B4}" AutomationProperties.HelpText="{Binding Text[ACClearAllHelp]}" AutomationProperties.AutomationId="ActionCenterClear"/>
        </WrapPanel>
        <ui:Button Content="{Binding Text[ACShowHistory]}" Command="{Binding ShowHistoryCommand}" Appearance="Transparent" HorizontalAlignment="Stretch" AutomationProperties.HelpText="{Binding Text[ACShowHistoryHelp]}" AutomationProperties.AutomationId="ActionCenterHistory"/>
       </StackPanel>
      </Border>
     </Grid>
    </TabItem>
   </TabControl>
  </Grid>
 </Border>
</UserControl>
