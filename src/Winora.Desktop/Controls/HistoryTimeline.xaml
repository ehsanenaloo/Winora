<UserControl x:Class="Winora.Desktop.Controls.HistoryTimeline"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ctl="clr-namespace:Winora.Desktop.Controls"
 Focusable="False" IsTabStop="False">
 <ui:ListView x:Name="TimelineList" SelectedItem="{Binding Selected, Mode=TwoWay}" MaxHeight="{Binding ListMaxHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
  ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
  AutomationProperties.Name="{Binding Text[HistoryTimeline]}" AutomationProperties.HelpText="{Binding Text[HistoryTimelineHelp]}">
  <ui:ListView.ItemsSource>
   <MultiBinding Converter="{x:Static ctl:RowGroups.ByDay}"><Binding Path="Rows"/><Binding Path="GroupByDay"/></MultiBinding>
  </ui:ListView.ItemsSource>
  <ui:ListView.ItemContainerStyle>
   <Style TargetType="ui:ListViewItem" BasedOn="{StaticResource {x:Type ui:ListViewItem}}">
    <Setter Property="MinHeight" Value="64"/><Setter Property="Padding" Value="{StaticResource WinoraSpace.None}"/><Setter Property="Margin" Value="{StaticResource WinoraSpace.B8}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
   </Style>
  </ui:ListView.ItemContainerStyle>
  <ui:ListView.GroupStyle>
   <GroupStyle>
    <GroupStyle.HeaderTemplate><DataTemplate><TextBlock Style="{StaticResource WinoraSectionHeading}" Text="{Binding Name}" Margin="{StaticResource WinoraSpace.L4T12B8}" AutomationProperties.HeadingLevel="Level2"/></DataTemplate></GroupStyle.HeaderTemplate>
   </GroupStyle>
  </ui:ListView.GroupStyle>
  <ui:ListView.ItemTemplate>
   <DataTemplate>
    <Border Style="{StaticResource WinoraSurfaceCard}" Padding="{StaticResource WinoraSpace.H16V12}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ui:SymbolIcon Symbol="{Binding ResultSymbol, Converter={x:Static ctl:IconKeys.Symbol}}" FontSize="24" Margin="{StaticResource WinoraSpace.T2R12}" VerticalAlignment="Top"/>
      <StackPanel Grid.Column="1">
       <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Title}" TextWrapping="Wrap"/>
       <WrapPanel Margin="{StaticResource WinoraSpace.T4}">
        <ctl:StatusBadge StatusTone="{Binding Tone}" Text="{Binding ResultLabel}" Margin="{StaticResource WinoraSpace.R8}"/>
        <ctl:StatusBadge Kind="Restart" Text="{Binding RestartText}" Margin="{StaticResource WinoraSpace.R8}" Visibility="{Binding RestartNeeded, Converter={StaticResource BoolToVisibility}}"/>
        <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding AreaLabel}" VerticalAlignment="Center" Margin="{StaticResource WinoraSpace.R8}"/>
        <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding TimeText}" VerticalAlignment="Center" Margin="{StaticResource WinoraSpace.R8}"/>
        <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding CountText}" VerticalAlignment="Center" Visibility="{Binding IsBatch, Converter={StaticResource BoolToVisibility}}"/>
       </WrapPanel>
       <StackPanel Orientation="Horizontal" Margin="{StaticResource WinoraSpace.T4}" Visibility="{Binding HasReason, Converter={StaticResource BoolToVisibility}}">
        <ui:SymbolIcon Symbol="Info16" FontSize="14" Margin="{StaticResource WinoraSpace.T2R4}" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <TextBlock x:Name="ReasonLine" Style="{StaticResource WinoraCaption}" Text="{Binding ReasonText}" TextWrapping="Wrap"/>
       </StackPanel>

       <!-- A single change: what happened and the technical references. -->
       <StackPanel Margin="{StaticResource WinoraSpace.T12}" Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding Outcome}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.B8}" Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVisibility}}"/>
        <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding DataContext.Text[CreatedLabel], RelativeSource={RelativeSource AncestorType=ui:ListView}}"/>
        <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding When}" Margin="{StaticResource WinoraSpace.B8}"/>
        <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding DataContext.Text[OperationIdLabel], RelativeSource={RelativeSource AncestorType=ui:ListView}}"/>
        <TextBox Style="{StaticResource WinoraLtrText}" Text="{Binding Id, Mode=OneWay}" Margin="{StaticResource WinoraSpace.T2B8}" AutomationProperties.Name="{Binding DataContext.Text[OperationIdLabel], RelativeSource={RelativeSource AncestorType=ui:ListView}}"/>
        <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding DataContext.Text[ResultCodeLabel], RelativeSource={RelativeSource AncestorType=ui:ListView}}"/>
        <TextBox Style="{StaticResource WinoraLtrText}" Text="{Binding Code, Mode=OneWay}" Margin="{StaticResource WinoraSpace.T2}" AutomationProperties.Name="{Binding DataContext.Text[ResultCodeLabel], RelativeSource={RelativeSource AncestorType=ui:ListView}}"/>
       </StackPanel>

       <!-- A batch: its members, each with its own undo. -->
       <ItemsControl ItemsSource="{Binding Members}" Visibility="{Binding ShowMembers, Converter={StaticResource BoolToVisibility}}" IsTabStop="False" Focusable="False" Margin="{StaticResource WinoraSpace.T12}">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Grid Margin="{StaticResource WinoraSpace.B8}" AutomationProperties.Name="{Binding AutomationName}">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding Title}" TextWrapping="Wrap"/>
            <WrapPanel Margin="{StaticResource WinoraSpace.T2}">
             <ctl:StatusBadge StatusTone="{Binding Tone}" Text="{Binding ResultLabel}" Margin="{StaticResource WinoraSpace.R8}"/>
             <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding TimeText}" VerticalAlignment="Center"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding ReasonText}" TextWrapping="Wrap" Visibility="{Binding HasReason, Converter={StaticResource BoolToVisibility}}"/>
           </StackPanel>
           <ui:Button Grid.Column="1" Content="{Binding UndoLabel}" Command="{Binding UndoCommand}" CommandParameter="{Binding}" Margin="{StaticResource WinoraSpace.L8}" VerticalAlignment="Top" Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}"
            AutomationProperties.Name="{Binding UndoName}" AutomationProperties.HelpText="{Binding DataContext.Text[HistUndoHelp], RelativeSource={RelativeSource AncestorType=ui:ListView}}"/>
          </Grid>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>

      <StackPanel Grid.Column="2" Margin="{StaticResource WinoraSpace.L12}" VerticalAlignment="Top">
       <ui:Button x:Name="RowUndo" Content="{Binding UndoLabel}" Command="{Binding DataContext.UndoRowCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon ArrowUndo24}"
        HorizontalAlignment="Stretch" Visibility="{Binding ShowUndo, Converter={StaticResource BoolToVisibility}}"
        AutomationProperties.Name="{Binding UndoName}" AutomationProperties.HelpText="{Binding UndoHelp}"/>
       <ui:Button x:Name="RowRestoreBefore" Content="{Binding RestoreBeforeLabel}" Command="{Binding DataContext.RestoreBeforeRowCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon ArrowUndo24}"
        HorizontalAlignment="Stretch" Visibility="{Binding ShowRestoreBefore, Converter={StaticResource BoolToVisibility}}"
        AutomationProperties.Name="{Binding RestoreBeforeName}" AutomationProperties.HelpText="{Binding RestoreBeforeHelp}"/>
       <ui:Button x:Name="RowDismiss" Content="{Binding DismissLabel}" Command="{Binding DataContext.DismissRowCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}" CommandParameter="{Binding}" Margin="{StaticResource WinoraSpace.T4}"
        HorizontalAlignment="Stretch" Visibility="{Binding ShowDismiss, Converter={StaticResource BoolToVisibility}}"
        AutomationProperties.Name="{Binding DismissName}" AutomationProperties.HelpText="{Binding DismissHelp}"/>
       <ctl:ExpandButton x:Name="RowDetails" IsExpanded="{Binding IsExpanded, Mode=OneWay}" Content="{Binding DetailsLabel}" Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}" CommandParameter="{Binding}" Appearance="Transparent" Margin="{StaticResource WinoraSpace.T4}"
        HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding DetailsName}"/>
      </StackPanel>
     </Grid>
    </Border>
   </DataTemplate>
  </ui:ListView.ItemTemplate>
 </ui:ListView>
</UserControl>
