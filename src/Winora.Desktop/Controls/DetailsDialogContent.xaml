<UserControl x:Class="Winora.Desktop.Controls.DetailsDialogContent"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:ctl="clr-namespace:Winora.Desktop.Controls"
 xmlns:local="clr-namespace:Winora.Desktop" xmlns:vm="clr-namespace:Winora.Desktop;assembly=Winora.Presentation"
 AutomationProperties.Name="{Binding Title}" Focusable="False">
 <UserControl.Resources>
  <DataTemplate x:Key="FieldTemplate" DataType="{x:Type vm:DetailField}">
   <StackPanel Margin="{StaticResource WinoraSpace.B8}">
    <TextBlock x:Name="FieldLabel" Style="{StaticResource WinoraCaption}" Text="{Binding Label}"/>
    <TextBox Text="{Binding Value, Mode=OneWay}" AutomationProperties.LabeledBy="{Binding ElementName=FieldLabel}" AutomationProperties.Name="{Binding Label}">
     <TextBox.Style>
      <Style TargetType="TextBox" BasedOn="{StaticResource WinoraSelectableText}">
       <Style.Triggers><DataTrigger Binding="{Binding IsLtr}" Value="True"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="FontFamily" Value="{StaticResource WinoraMonoFontFamily}"/><Setter Property="FontSize" Value="{StaticResource WinoraFontSizeCaption}"/><Setter Property="HorizontalAlignment" Value="Left"/></DataTrigger></Style.Triggers>
      </Style>
     </TextBox.Style>
    </TextBox>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="SectionTemplate" DataType="{x:Type vm:DetailsSection}">
   <Border Style="{StaticResource WinoraCardBorder}" AutomationProperties.Name="{Binding Heading}">
    <StackPanel>
     <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Heading}" Margin="{StaticResource WinoraSpace.B8}" AutomationProperties.HeadingLevel="Level3" Visibility="{Binding HasHeading, Converter={StaticResource BoolToVisibility}}"/>
     <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldTemplate}" IsTabStop="False" Focusable="False"/>
    </StackPanel>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="ActionTemplate" DataType="{x:Type vm:DetailsActionItem}">
   <ui:Button Content="{Binding Label}" Command="{Binding Command}" Margin="{StaticResource WinoraSpace.R8B8}" MinHeight="36"
    AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Help}">
    <ui:Button.Style>
     <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Style.Triggers>
       <DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="Appearance" Value="Primary"/></DataTrigger>
       <DataTrigger Binding="{Binding IsDanger}" Value="True"><Setter Property="Appearance" Value="Danger"/></DataTrigger>
      </Style.Triggers>
     </Style>
    </ui:Button.Style>
   </ui:Button>
  </DataTemplate>
  <!-- The choice of a High risk setting: staged here, applied through the same review as every other change. -->
  <DataTemplate DataType="{x:Type vm:SettingChoiceEditor}">
   <Border Style="{StaticResource WinoraCardBorder}" Visibility="{Binding Row.IsReviewOnly, Converter={StaticResource BoolToVisibility}}">
    <StackPanel>
     <TextBlock x:Name="SetValueLabel" Style="{StaticResource WinoraBodyStrong}" Text="{Binding Text[DetailsSetValue]}" AutomationProperties.HeadingLevel="Level3" Margin="{StaticResource WinoraSpace.B8}"/>
     <ctl:ChoiceRow Choices="{Binding Row.Choices}" SelectedChoice="{Binding Row.SelectedChoice, Mode=TwoWay}" IsEnabled="{Binding Row.CanChoose}" ControlName="{Binding Row.Title}"
      ControlHelp="{Binding Text[ChoiceHelp]}" LabeledBy="{Binding ElementName=SetValueLabel}"/>
     <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Row.PendingText}" Visibility="{Binding Row.IsPending, Converter={StaticResource BoolToVisibility}}" Margin="{StaticResource WinoraSpace.T4}" AutomationProperties.LiveSetting="Polite"/>
     <ui:Button Content="{Binding Text[SetReset]}" Command="{Binding Row.ResetCommand}" Icon="{ui:SymbolIcon ArrowReset24}" Margin="{StaticResource WinoraSpace.T8}" HorizontalAlignment="Left"
      AutomationProperties.Name="{Binding Text[SetReset]}" AutomationProperties.HelpText="{Binding Row.ResetHelp}"/>
    </StackPanel>
   </Border>
  </DataTemplate>
 </UserControl.Resources>
 <StackPanel MinWidth="540" MaxWidth="600">
  <!-- No scroll viewer here: the dialog scrolls its content, so long details show one scroll bar. -->
  <StackPanel>
   <StackPanel Margin="{StaticResource WinoraSpace.R8}">
    <!-- Header card: name, tags, one quiet line and Copy details. -->
    <Border Style="{StaticResource WinoraCardBorder}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock x:Name="HeaderTitle" Style="{StaticResource WinoraBodyStrong}" Text="{Binding Title}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level3"/>
       <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Subtitle}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T2}" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontFamily="{StaticResource WinoraMonoFontFamily}"
        Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}"/>
       <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource WinoraBadgeItemTemplate}" ItemsPanel="{StaticResource WinoraChipPanel}" IsTabStop="False" Focusable="False" Margin="{StaticResource WinoraSpace.T8}"
        Visibility="{Binding HasChips, Converter={StaticResource BoolToVisibility}}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="{StaticResource WinoraSpace.L12}">
       <ui:Button Content="{Binding CopyLabel}" Command="{Binding CopyCommand}" Icon="{ui:SymbolIcon Copy24}" AutomationProperties.Name="{Binding CopyLabel}"/>
       <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Status}" Margin="{StaticResource WinoraSpace.T4}" HorizontalAlignment="Right" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
     </Grid>
    </Border>
    <ContentPresenter Content="{Binding Editor}" Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}"/>
    <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}" IsTabStop="False" Focusable="False"/>
    <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ActionTemplate}" IsTabStop="False" Focusable="False" Visibility="{Binding HasActions, Converter={StaticResource BoolToVisibility}}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>
   </StackPanel>
  </StackPanel>
 </StackPanel>
</UserControl>
