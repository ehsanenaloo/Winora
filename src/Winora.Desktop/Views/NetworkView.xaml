<UserControl x:Class="Winora.Desktop.NetworkView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:local="clr-namespace:Winora.Desktop" xmlns:vm="clr-namespace:Winora.Desktop;assembly=Winora.Presentation" xmlns:ctl="clr-namespace:Winora.Desktop.Controls"
 AutomationProperties.Name="{Binding Title}" Focusable="False">
 <UserControl.Resources>
  <DataTemplate x:Key="AdapterTemplate" DataType="{x:Type vm:NetworkAdapterRow}">
   <Border Style="{StaticResource WinoraActionCard}" AutomationProperties.Name="{Binding AutomationName}">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center">
      <WrapPanel>
       <CheckBox x:Name="PickBox" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" Margin="{StaticResource WinoraSpace.R8}" VerticalAlignment="Center"
        AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.HelpText="{Binding DataContext.AdapterPickHelp, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Name}" TextWrapping="Wrap"/>
       </CheckBox>
       <ctl:StatusBadge Kind="Neutral" Text="{Binding KindText}"/>
      </WrapPanel>
      <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding VirtualText}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T4}" Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVisibility}}"/>
      <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding AddressesText}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T4}"/>
      <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding DnsText}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T2}"/>
      <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding EffectiveText}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T2}"/>
      <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding EncryptionText}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T2}"/>
     </StackPanel>
     <ui:Button Grid.Column="1" Style="{StaticResource WinoraRowButton}" Content="{Binding IncludeLabel}" Command="{Binding IncludeCommand}" Margin="{StaticResource WinoraSpace.L16}" Visibility="{Binding ShowInclude, Converter={StaticResource BoolToVisibility}}"
      ctl:A11y.Label="{Binding IncludeLabel}" ctl:A11y.Item="{Binding Name}" AutomationProperties.HelpText="{Binding IncludeHelp}"/>
    </Grid>
   </Border>
  </DataTemplate>

 </UserControl.Resources>

 <ctl:SettingsPage x:Name="Workspace">
  <ctl:SettingsPage.Header>
   <ctl:PageHeader Title="{Binding Title}" Subtitle="{Binding Text[NetIntro]}">
     <ctl:PageHeader.Actions><WrapPanel><ui:Button Margin="{StaticResource WinoraSpace.A4}" x:Name="RefreshButton" ToolTip="{Binding Text[DiscRefresh]}" Style="{StaticResource WinoraHeaderIconButton}" Command="{Binding RefreshCommand}" Icon="{ui:SymbolIcon ArrowClockwise24}"
      AutomationProperties.Name="{Binding Text[DiscRefresh]}" AutomationProperties.HelpText="{Binding Text[NetRefreshHelp]}"/></WrapPanel></ctl:PageHeader.Actions>
    </ctl:PageHeader>
  </ctl:SettingsPage.Header>
  <ctl:SettingsPage.Tabs>
   <ctl:TabRail x:Name="Rail" ContentTabs="{Binding ElementName=Tabs}" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Text[V2PaTabsHelp]}" Visibility="{Binding Visibility, ElementName=Tabs}"/>
  </ctl:SettingsPage.Tabs>
  <ctl:SettingsPage.Banners>
   <StackPanel>
    <ctl:AdminNotice IsOpen="{Binding ShowNeedsAdministrator, Mode=OneWay}" Title="{Binding NeedsAdministratorTitle}" Message="{Binding NeedsAdministratorText, Mode=OneWay}" ShowLink="{Binding ShowAdminHowTo}" LinkText="{Binding Text[AdminNoticeLink]}" LinkHelp="{Binding Text[AdminNoticeLinkHelp]}"/>
    <ctl:LoadingSkeleton x:Name="LoadingState" Message="{Binding Text[Working]}" Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}"/>
    <ctl:ErrorState x:Name="ErrorPanel" Headline="{Binding Text[NetLoadFailedTitle]}" Message="{Binding LoadError}" ActionText="{Binding Text[TryAgain]}" ActionCommand="{Binding RefreshCommand}" ActionHelp="{Binding Text[NetRefreshHelp]}"
     Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibility}}"/>
    <ctl:InfoBanner x:Name="NoticeBar" IsOpen="{Binding ShowNoticeBanner, Mode=OneWay}" IsClosable="False" Severity="{Binding NoticeSeverity, Converter={x:Static ctl:BannerLook.Severity}}" Title="{Binding Text[NetResult]}" Message="{Binding Notice}" Margin="{StaticResource WinoraSpace.B8}"
     AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Notice}"/>
    <ctl:InfoBanner x:Name="UndoOfferBar" IsOpen="{Binding ShowUndoOffer, Mode=OneWay}" IsClosable="False" Severity="Informational" Message="{Binding Text[NetUndoNowHelp]}" Margin="{StaticResource WinoraSpace.B8}">
     <ui:Button x:Name="UndoOfferButton" Content="{Binding Text[NetUndoNow]}" Command="{Binding UndoLastCommand}" Appearance="Primary" Icon="{ui:SymbolIcon ArrowUndo24}" Margin="{StaticResource WinoraSpace.T8}" HorizontalAlignment="Left"
      AutomationProperties.Name="{Binding Text[NetUndoNow]}" AutomationProperties.HelpText="{Binding Text[NetUndoNowHelp]}"/>
    </ctl:InfoBanner>

    
   </StackPanel>
  </ctl:SettingsPage.Banners>
  <ctl:SettingsPage.Body>
   <ctl:TabBody x:Name="Tabs" Style="{StaticResource WinoraTabContentStyle}" Visibility="{Binding ShowContent, Converter={StaticResource BoolToVisibility}}" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
     <TabItem Header="{Binding Text[NetProviderHeading]}" AutomationProperties.Name="{Binding Text[NetProviderHeading]}">
      <StackPanel Margin="{StaticResource WinoraSpace.T16}">
    <!-- Provider -->
    <ctl:SettingCard x:Name="ProviderCardView" Row="{Binding ProviderCard}" Text="{Binding Text}"/>
    <ctl:SettingCard x:Name="DohCardView" Row="{Binding DohCard}" Text="{Binding Text}"/>
    <Border Style="{StaticResource WinoraActionCard}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding ProviderSource}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.B8}" Visibility="{Binding HasProviderSource, Converter={StaticResource BoolToVisibility}}"/>
       <StackPanel Margin="{StaticResource WinoraSpace.B8}" Visibility="{Binding ShowCustom, Converter={StaticResource BoolToVisibility}}">
        <TextBlock x:Name="CustomLabel" Style="{StaticResource WinoraBodyStrong}" Text="{Binding Text[NetCustomLabel]}"/>
        <TextBox x:Name="CustomBox" Text="{Binding CustomServers, UpdateSourceTrigger=PropertyChanged}" MinWidth="320" MaxLength="200" HorizontalAlignment="Left" Margin="{StaticResource WinoraSpace.T4}"
         AutomationProperties.LabeledBy="{Binding ElementName=CustomLabel}" AutomationProperties.Name="{Binding Text[NetCustomLabel]}" AutomationProperties.HelpText="{Binding Text[NetCustomHelp]}"/>
       </StackPanel>
       <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding SelectionText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
     </Grid>
    </Border>

      </StackPanel>
     </TabItem>
     <TabItem Header="{Binding Text[NetAdaptersHeading]}" AutomationProperties.Name="{Binding Text[NetAdaptersHeading]}">
      <StackPanel Margin="{StaticResource WinoraSpace.T16}">
    <!-- Adapters -->
    <ctl:EmptyState Icon="Globe24" Headline="{Binding Text[NetEmpty]}" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}"/>
    <ItemsControl x:Name="AdapterList" ItemsSource="{Binding Adapters}" ItemTemplate="{StaticResource AdapterTemplate}" IsTabStop="False" Focusable="False" AutomationProperties.Name="{Binding Text[NetAdaptersHeading]}"/>

      </StackPanel>
     </TabItem>
    </ctl:TabBody>
  </ctl:SettingsPage.Body>
  <ctl:SettingsPage.Footer>
    <!-- History -->
    <ctl:PageHistory DataContext="{Binding HistoryList}"/>
  </ctl:SettingsPage.Footer>
 </ctl:SettingsPage>
</UserControl>
