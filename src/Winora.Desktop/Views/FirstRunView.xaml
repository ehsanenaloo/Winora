<UserControl x:Class="Winora.Desktop.FirstRunView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ctl="clr-namespace:Winora.Desktop.Controls"
 xmlns:local="clr-namespace:Winora.Desktop" xmlns:vm="clr-namespace:Winora.Desktop;assembly=Winora.Presentation"
 AutomationProperties.Name="{Binding Title}" Focusable="False">
 <UserControl.Resources>
  <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:FirstRunProfileCard}">
   <RadioButton GroupName="FirstRunProfile" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="{StaticResource WinoraSpace.B8}" Padding="{StaticResource WinoraSpace.H12V8}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
    MinHeight="{DynamicResource MinHitTarget}" AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.HelpText="{Binding ChooseHelp}">
    <StackPanel>
     <WrapPanel>
      <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Name}" Margin="{StaticResource WinoraSpace.R8}" VerticalAlignment="Center"/>
      <ctl:StatusBadge Kind="Info" Text="{Binding RecommendedText}" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}"/>
     </WrapPanel>
     <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding Description}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T2B4}"/>
     <TextBlock Style="{StaticResource WinoraCaption}" TextWrapping="Wrap"><Run Text="{Binding CountText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding RiskText, Mode=OneWay}"/></TextBlock>
     <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding NoHighRiskText}" TextWrapping="Wrap"/>
    </StackPanel>
   </RadioButton>
  </DataTemplate>

  <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:FirstRunRow}">
   <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="{StaticResource WinoraSpace.B8}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="{DynamicResource MinHitTarget}"
    AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.HelpText="{Binding DataContext.Text[FirstRunRowHelp], RelativeSource={RelativeSource AncestorType=UserControl}}">
    <StackPanel>
     <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Title}" TextWrapping="Wrap"/>
     <ctl:DiffView Margin="{StaticResource WinoraSpace.T4}" Before="{Binding Before}" After="{Binding After}" BeforeLabel="{Binding DataContext.Text[DiffBefore], RelativeSource={RelativeSource AncestorType=UserControl}}"
      AfterLabel="{Binding DataContext.Text[DiffAfter], RelativeSource={RelativeSource AncestorType=UserControl}}"/>
     <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Reason}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T4}"/>
     <WrapPanel Margin="{StaticResource WinoraSpace.T4}">
      <ctl:RiskChip Level="{Binding RiskLevel}" Text="{Binding Risk}"/>
      <ctl:StatusBadge Kind="Neutral" Text="{Binding Scope}"/>
      <ctl:StatusBadge Kind="Restart" Text="{Binding Restart}" Visibility="{Binding HasRestart, Converter={StaticResource BoolToVisibility}}"/>
     </WrapPanel>
    </StackPanel>
   </CheckBox>
  </DataTemplate>

  <DataTemplate x:Key="GroupTemplate" DataType="{x:Type vm:FirstRunGroup}">
   <StackPanel Margin="{StaticResource WinoraSpace.B8}" AutomationProperties.Name="{Binding AutomationName}">
    <TextBlock Style="{StaticResource WinoraSectionHeading}" Text="{Binding Heading}" Margin="{StaticResource WinoraSpace.T8B4}"/>
    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" IsTabStop="False" Focusable="False"/>
   </StackPanel>
  </DataTemplate>

  <Style x:Key="FactIcon" TargetType="ui:SymbolIcon"><Setter Property="FontSize" Value="{StaticResource WinoraIconSizeLead}"/><Setter Property="Margin" Value="{StaticResource WinoraSpace.T2R12}"/><Setter Property="VerticalAlignment" Value="Top"/></Style>
 </UserControl.Resources>

 <Grid Background="{DynamicResource WinoraSurfacePageBrush}">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
   <StackPanel MaxWidth="640" Margin="{StaticResource WinoraSpace.L24T32R24B16}" HorizontalAlignment="Center">
    <TextBlock x:Name="StepLabel" Style="{StaticResource WinoraCaption}" Text="{Binding StepLabel}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding StepLabel}"/>
    <ProgressBar x:Name="StepBar" Minimum="0" Maximum="1" Value="{Binding StepFraction, Mode=OneWay}" Height="4" Margin="{StaticResource WinoraSpace.T4B16}" Focusable="False" IsTabStop="False" AutomationProperties.Name="{Binding StepLabel}"/>
    <TextBlock x:Name="TitleText" Style="{StaticResource WinoraDisplay}" Text="{Binding Title}" Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource WinoraFocusRect}"
     AutomationProperties.HeadingLevel="Level1" Margin="{StaticResource WinoraSpace.B12}"/>

    <ctl:InfoBanner IsOpen="{Binding HasNotice, Mode=OneWay}" IsClosable="False" Severity="Warning" Title="{Binding Notice}" Margin="{StaticResource WinoraSpace.B8}" AutomationProperties.Name="{Binding Notice}"/>

    <!-- 1. Welcome -->
    <StackPanel x:Name="WelcomePanel" Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}">
     <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding Text[WelcomeLead]}" Margin="{StaticResource WinoraSpace.B16}"/>
     <Grid Margin="{StaticResource WinoraSpace.B12}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ui:SymbolIcon Symbol="ShieldLock24" Style="{StaticResource FactIcon}"/>
      <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource WinoraSectionHeading}" Text="{Binding Text[WelcomeNothingSentTitle]}"/><TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding Text[WelcomeNothingSentBody]}"/></StackPanel></Grid>
     <Grid Margin="{StaticResource WinoraSpace.B12}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ui:SymbolIcon Symbol="DocumentSearch24" Style="{StaticResource FactIcon}"/>
      <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource WinoraSectionHeading}" Text="{Binding Text[FirstRunReviewedTitle]}"/><TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding Text[FirstRunReviewedBody]}"/></StackPanel></Grid>
     <Grid Margin="{StaticResource WinoraSpace.B16}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ui:SymbolIcon Symbol="ArrowUndo24" Style="{StaticResource FactIcon}"/>
      <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource WinoraSectionHeading}" Text="{Binding Text[FirstRunUndoneTitle]}"/><TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding Text[FirstRunUndoneBody]}"/></StackPanel></Grid>

     <TextBlock Style="{StaticResource WinoraSectionHeading}" Text="{Binding Text[FirstRunEnvTitle]}" Margin="{StaticResource WinoraSpace.B4}"/>
     <StackPanel x:Name="EnvironmentLines" AutomationProperties.Name="{Binding Text[FirstRunEnvTitle]}">
      <StackPanel Orientation="Horizontal" Margin="{StaticResource WinoraSpace.B4}"><ui:SymbolIcon Symbol="{Binding AdminSymbol, Converter={x:Static ctl:IconKeys.Symbol}}" FontSize="16" Margin="{StaticResource WinoraSpace.T2R8}" VerticalAlignment="Top"/><TextBlock x:Name="AdminText" Style="{StaticResource WinoraBody}" Text="{Binding AdminLine}" MaxWidth="580"/></StackPanel>
      <StackPanel Orientation="Horizontal" Margin="{StaticResource WinoraSpace.B16}"><ui:SymbolIcon Symbol="{Binding LocationSymbol, Converter={x:Static ctl:IconKeys.Symbol}}" FontSize="16" Margin="{StaticResource WinoraSpace.T2R8}" VerticalAlignment="Top"/><TextBlock x:Name="LocationText" Style="{StaticResource WinoraBody}" Text="{Binding LocationLine}" MaxWidth="580"/></StackPanel>
     </StackPanel>

     <TextBlock Style="{StaticResource WinoraSectionHeading}" Text="{Binding Text[WelcomeChooseTitle]}" Margin="{StaticResource WinoraSpace.B4}"/>
     <WrapPanel>
      <StackPanel Margin="{StaticResource WinoraSpace.R16B8}">
       <TextBlock x:Name="LanguageLabel" Style="{StaticResource WinoraCaption}" Text="{Binding Text[Language]}"/>
       <ComboBox x:Name="LanguageBox" DataContext="{Binding Settings}" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LanguageCode, Mode=TwoWay}" MinWidth="160"
        AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}" AutomationProperties.Name="{Binding Text[Language]}" AutomationProperties.HelpText="{Binding Text[LanguageHelp]}"/>
      </StackPanel>
      <StackPanel Margin="{StaticResource WinoraSpace.B8}">
       <TextBlock x:Name="ThemeLabel" Style="{StaticResource WinoraCaption}" Text="{Binding Text[Theme]}"/>
       <ComboBox x:Name="ThemeBox" DataContext="{Binding Settings}" ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ThemeCode, Mode=TwoWay}" MinWidth="160"
        AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}" AutomationProperties.Name="{Binding Text[Theme]}" AutomationProperties.HelpText="{Binding Text[ThemeHelp]}"/>
      </StackPanel>
     </WrapPanel>

     <TextBlock x:Name="DataTitle" Style="{StaticResource WinoraSectionHeading}" Text="{Binding Text[WelcomeDataTitle]}" Margin="{StaticResource WinoraSpace.T8B2}"/>
     <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding Text[WelcomeDataBody]}"/>
     <Grid Margin="{StaticResource WinoraSpace.T4}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="PathBox" Style="{StaticResource WinoraLtrText}" Text="{Binding DataFolder, Mode=OneWay}" AutomationProperties.LabeledBy="{Binding ElementName=DataTitle}" AutomationProperties.Name="{Binding Text[WelcomeDataTitle]}" AutomationProperties.HelpText="{Binding Text[WelcomeDataBody]}"/>
      <ui:Button x:Name="CopyPathButton" Grid.Column="1" DataContext="{Binding Settings}" Content="{Binding Text[CopyPath]}" Command="{Binding CopyPathCommand}" CommandParameter="{Binding DataFolder}" Margin="{StaticResource WinoraSpace.L8}" VerticalAlignment="Top"
       AutomationProperties.Name="{Binding Text[CopyPath]}" AutomationProperties.HelpText="{Binding Text[CopyPathHelp]}"/>
     </Grid>
     <TextBlock DataContext="{Binding Settings}" Style="{StaticResource WinoraCaption}" Text="{Binding CopyStatus}" Margin="{StaticResource WinoraSpace.T4}" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>

    <!-- 2. Restore point -->
    <StackPanel x:Name="RestorePanel" Visibility="{Binding IsRestorePoint, Converter={StaticResource BoolToVisibility}}">
     <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding Text[FirstRunRestoreBody]}" Margin="{StaticResource WinoraSpace.B8}"/>
     <TextBlock x:Name="RestoreLineText" Style="{StaticResource WinoraBodyStrong}" Text="{Binding RestoreLine}" Margin="{StaticResource WinoraSpace.B8}" AutomationProperties.LiveSetting="Polite"/>
     <ctl:InfoBanner x:Name="ProtectionBanner" IsOpen="{Binding ProtectionOff, Mode=OneWay}" IsClosable="False" Severity="Informational" Title="{Binding Text[FirstRunRestoreOffTitle]}" Message="{Binding Text[FirstRunRestoreOff]}" Margin="{StaticResource WinoraSpace.B8}"
      AutomationProperties.Name="{Binding Text[FirstRunRestoreOffTitle]}"/>
     <ui:Button x:Name="OpenProtectionButton" Content="{Binding Text[FirstRunRestoreOpen]}" Command="{Binding OpenProtectionCommand}" Icon="{ui:SymbolIcon Open24}" Margin="{StaticResource WinoraSpace.B8}" HorizontalAlignment="Left"
      Visibility="{Binding ProtectionOff, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Text[FirstRunRestoreOpen]}" AutomationProperties.HelpText="{Binding Text[FirstRunRestoreOpenHelp]}"/>
     <WrapPanel>
      <ui:Button x:Name="CreateRestoreButton" Content="{Binding Text[FirstRunRestoreCreate]}" Command="{Binding CreateRestorePointCommand}" Appearance="Primary" Icon="{ui:SymbolIcon Shield24}" Margin="{StaticResource WinoraSpace.R8B8}"
       AutomationProperties.Name="{Binding Text[FirstRunRestoreCreate]}" AutomationProperties.HelpText="{Binding Text[FirstRunRestoreCreateHelp]}"/>
      <ui:Button x:Name="SkipRestoreButton" Content="{Binding Text[FirstRunRestoreSkip]}" Command="{Binding SkipRestorePointCommand}" Margin="{StaticResource WinoraSpace.R8B8}"
       AutomationProperties.Name="{Binding Text[FirstRunRestoreSkip]}" AutomationProperties.HelpText="{Binding Text[FirstRunRestoreSkipHelp]}"/>
     </WrapPanel>
     <ctl:ProgressPanel x:Name="RestoreProgress" Title="{Binding ProgressText}" IsDeterminate="False" IsRunning="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
      CancelText="{Binding Text[ProfileCancel]}" CancelHelp="{Binding Text[FirstRunCancelHelp]}" CancelCommand="{Binding CancelCommand}" ElapsedFormat="{Binding Text[ProgElapsed]}"/>
     <TextBlock x:Name="RestoreOutcomeText" Style="{StaticResource WinoraBody}" Text="{Binding RestoreOutcome}" Margin="{StaticResource WinoraSpace.T8}" Visibility="{Binding HasRestoreOutcome, Converter={StaticResource BoolToVisibility}}"
      AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding RestoreOutcome}"/>
    </StackPanel>

    <!-- 3. Choose a profile -->
    <StackPanel x:Name="ProfilePanel" Visibility="{Binding IsProfile, Converter={StaticResource BoolToVisibility}}">
     <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding Text[FirstRunProfileLead]}" Margin="{StaticResource WinoraSpace.B12}"/>
     <StackPanel AutomationProperties.Name="{Binding Text[FirstRunProfileTitle]}">
      <ItemsControl x:Name="CardList" ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}" IsTabStop="False" Focusable="False"/>
      <RadioButton x:Name="NoProfileRadio" GroupName="FirstRunProfile" IsChecked="{Binding NoProfileSelected, Mode=TwoWay}" Padding="{StaticResource WinoraSpace.H12V8}" HorizontalAlignment="Stretch" MinHeight="{DynamicResource MinHitTarget}"
       Content="{Binding Text[FirstRunProfileNone]}" AutomationProperties.Name="{Binding Text[FirstRunProfileNone]}" AutomationProperties.HelpText="{Binding Text[FirstRunProfileNoneHelp]}"/>
     </StackPanel>
    </StackPanel>

    <!-- 4. Review the plan -->
    <StackPanel x:Name="ReviewPanel" Visibility="{Binding IsReview, Converter={StaticResource BoolToVisibility}}">
     <TextBlock x:Name="ReviewHeaderText" Style="{StaticResource WinoraSubtitle}" Text="{Binding ReviewHeader}" AutomationProperties.HeadingLevel="Level2"/>
     <ctl:InfoBanner IsOpen="True" IsClosable="False" Severity="Informational" Title="{Binding Text[ProfilePlanNothingYet]}" Margin="{StaticResource WinoraSpace.V8}" AutomationProperties.Name="{Binding Text[ProfilePlanNothingYet]}"/>
     <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding Text[FirstRunReviewNone]}" Visibility="{Binding NothingToChange, Converter={StaticResource BoolToVisibility}}"/>
     <ItemsControl x:Name="PlanList" ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupTemplate}" IsTabStop="False" Focusable="False" AutomationProperties.Name="{Binding Text[FirstRunReviewTitle]}"/>
    </StackPanel>

    <!-- 5. Result -->
    <StackPanel x:Name="ResultPanel" Visibility="{Binding IsResult, Converter={StaticResource BoolToVisibility}}">
     <ctl:ProgressPanel x:Name="ApplyProgress" Title="{Binding Text[FirstRunApplying]}" StepText="{Binding ProgressText}" IsDeterminate="True" Value="{Binding ProgressFraction}" IsRunning="{Binding IsApplying}"
      Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisibility}}" CancelText="{Binding Text[ProfileCancel]}" CancelHelp="{Binding Text[ProfileCancelHelp]}" CancelCommand="{Binding CancelCommand}" ElapsedFormat="{Binding Text[ProgElapsed]}"/>
     <StackPanel Visibility="{Binding ShowResultBody, Converter={StaticResource BoolToVisibility}}">
      <TextBlock x:Name="ResultHeadingText" Style="{StaticResource WinoraSubtitle}" Text="{Binding ResultHeading}" AutomationProperties.HeadingLevel="Level2" AutomationProperties.LiveSetting="Polite"/>
      <ctl:ResultReport x:Name="ReportPanel" Model="{Binding Report}" Margin="{StaticResource WinoraSpace.V8}" Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}"/>
      <TextBlock Style="{StaticResource WinoraSectionHeading}" Text="{Binding Text[FirstRunWhereTitle]}" Margin="{StaticResource WinoraSpace.T12B2}"/>
      <TextBlock x:Name="WhereText" Style="{StaticResource WinoraBody}" Text="{Binding ResultBody}"/>
      <WrapPanel Margin="{StaticResource WinoraSpace.T12}">
       <ui:Button x:Name="OverviewButton" Content="{Binding Text[FirstRunOverview]}" Command="{Binding OverviewCommand}" Appearance="Primary" Icon="{ui:SymbolIcon Home24}" Margin="{StaticResource WinoraSpace.R8B8}"
        AutomationProperties.Name="{Binding Text[FirstRunOverview]}" AutomationProperties.HelpText="{Binding Text[FirstRunOverviewHelp]}"/>
       <ui:Button x:Name="ProfilesButton" Content="{Binding Text[FirstRunProfilesLink]}" Command="{Binding ProfilesCommand}" Icon="{ui:SymbolIcon Sparkle24}" Margin="{StaticResource WinoraSpace.R8B8}"
        AutomationProperties.Name="{Binding Text[FirstRunProfilesLink]}" AutomationProperties.HelpText="{Binding Text[FirstRunProfilesLinkHelp]}"/>
      </WrapPanel>
     </StackPanel>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>

  <!-- Footer: Back, Continue, Skip setup -->
  <Border Grid.Row="1" Background="{DynamicResource WinoraSurfaceRaisedBrush}" BorderBrush="{DynamicResource WinoraCardBorderBrush}" BorderThickness="0,1,0,0" Padding="{StaticResource WinoraSpace.H24V12}">
   <Grid MaxWidth="640">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <WrapPanel>
     <ui:Button x:Name="BackButton" Content="{Binding Text[FirstRunBack]}" Command="{Binding BackCommand}" Margin="{StaticResource WinoraSpace.R8}" MinHeight="44" Visibility="{Binding ShowBack, Converter={StaticResource BoolToVisibility}}"
      AutomationProperties.Name="{Binding Text[FirstRunBack]}" AutomationProperties.HelpText="{Binding Text[FirstRunBackHelp]}"/>
     <ui:Button x:Name="SkipButton" Content="{Binding Text[FirstRunSkip]}" Command="{Binding SkipCommand}" Appearance="Transparent" MinHeight="44" Visibility="{Binding ShowContinue, Converter={StaticResource BoolToVisibility}}"
      AutomationProperties.Name="{Binding Text[FirstRunSkip]}" AutomationProperties.HelpText="{Binding Text[FirstRunSkipHelp]}"/>
    </WrapPanel>
    <ui:Button x:Name="ContinueButton" Grid.Column="2" Content="{Binding ContinueLabel}" Command="{Binding ContinueCommand}" Appearance="Primary" MinHeight="44" MinWidth="140" Visibility="{Binding ShowContinue, Converter={StaticResource BoolToVisibility}}"
     AutomationProperties.Name="{Binding ContinueLabel}" AutomationProperties.HelpText="{Binding ContinueHelp}"/>
   </Grid>
  </Border>
 </Grid>
</UserControl>
