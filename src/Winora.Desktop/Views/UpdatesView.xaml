<UserControl x:Class="Winora.Desktop.UpdatesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:local="clr-namespace:Winora.Desktop" xmlns:vm="clr-namespace:Winora.Desktop;assembly=Winora.Presentation" xmlns:ctl="clr-namespace:Winora.Desktop.Controls"
 AutomationProperties.Name="{Binding Title}" Focusable="False">
 <UserControl.Resources>
  <!-- A mode in the list: one card of a radio group, the same choice card as a built-in profile. The header picks the mode; the picked card has the accent edge and a filled check
 mark and shows the before and after view and the options of the mode. The mode in effect carries the Active badge. A risk badge shows only for Medium and High. -->
  <DataTemplate x:Key="ModeTemplate" DataType="{x:Type vm:UpdateModeCard}">
   <Border x:Name="Card" Style="{StaticResource WinoraActionCard}" Padding="{StaticResource WinoraSpace.None}">
    <StackPanel>
     <RadioButton x:Name="Choice" Style="{StaticResource WinoraProfileChoice}" GroupName="WinoraUpdateMode" IsChecked="{Binding IsPicked, Mode=TwoWay}" IsEnabled="{Binding CanPick}"
      AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.HelpText="{Binding DataContext.Text[UpdatesPickerChoiceHelp], RelativeSource={RelativeSource AncestorType=UserControl}}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center">
        <WrapPanel>
         <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Name}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.R8}" VerticalAlignment="Center"/>
         <ctl:StatusBadge Kind="Success" Text="{Binding ActiveText}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>
         <ctl:RiskChip Level="{Binding Risk}" Text="{Binding RiskText}" HideWhenLow="True"/>
        </WrapPanel>
        <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Description}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T2}"/>
        <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding ReleaseText}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T4}" Visibility="{Binding HasReleaseText, Converter={StaticResource BoolToVisibility}}"/>
        <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding UnavailableText}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T4}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
         Visibility="{Binding HasUnavailableText, Converter={StaticResource BoolToVisibility}}"/>
       </StackPanel>
       <Grid Grid.Column="1" Width="24" Height="24" Margin="{StaticResource WinoraSpace.L12}" VerticalAlignment="Top">
        <Ellipse x:Name="Ring" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="2"/>
        <Ellipse x:Name="Fill" Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
        <ui:SymbolIcon x:Name="Check" Symbol="Checkmark16" FontSize="14" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
       </Grid>
      </Grid>
     </RadioButton>
     <StackPanel x:Name="Options" Visibility="Collapsed" Margin="{StaticResource WinoraSpace.H16V8}">
      <ctl:DiffView x:Name="ModeDiff" Before="{Binding DataContext.PickerBefore, RelativeSource={RelativeSource AncestorType=UserControl}}" After="{Binding DataContext.PickerAfter, RelativeSource={RelativeSource AncestorType=UserControl}}"
       BeforeLabel="{Binding DataContext.Text[DiffBefore], RelativeSource={RelativeSource AncestorType=UserControl}}" AfterLabel="{Binding DataContext.Text[DiffAfter], RelativeSource={RelativeSource AncestorType=UserControl}}"
       Visibility="{Binding DataContext.PickerChanges, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"/>
      <Grid Visibility="{Binding ShowDays, Converter={StaticResource BoolToVisibility}}" Margin="{StaticResource WinoraSpace.T12}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock x:Name="FeatureLabel" Style="{StaticResource WinoraBody}" VerticalAlignment="Center" Margin="{StaticResource WinoraSpace.R16B8}" Text="{Binding DataContext.Text[UpdatesFeatureDays], RelativeSource={RelativeSource AncestorType=UserControl}}"/>
       <ComboBox Grid.Column="1" ItemsSource="{Binding FeatureDays}" SelectedItem="{Binding SelectedFeatureDays, Mode=TwoWay}" MinWidth="160" HorizontalAlignment="Right" Margin="{StaticResource WinoraSpace.B8}"
        IsEnabled="{Binding DataContext.IsElevated, RelativeSource={RelativeSource AncestorType=UserControl}}"
        AutomationProperties.LabeledBy="{Binding ElementName=FeatureLabel}" AutomationProperties.Name="{Binding DataContext.Text[UpdatesFeatureDays], RelativeSource={RelativeSource AncestorType=UserControl}}"
        AutomationProperties.HelpText="{Binding DataContext.Text[UpdatesDaysHelp], RelativeSource={RelativeSource AncestorType=UserControl}}"/>
       <TextBlock x:Name="QualityLabel" Grid.Row="1" Style="{StaticResource WinoraBody}" VerticalAlignment="Center" Margin="{StaticResource WinoraSpace.R16}" Text="{Binding DataContext.Text[UpdatesQualityDays], RelativeSource={RelativeSource AncestorType=UserControl}}"/>
       <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding QualityDays}" SelectedItem="{Binding SelectedQualityDays, Mode=TwoWay}" MinWidth="160" HorizontalAlignment="Right"
        IsEnabled="{Binding DataContext.IsElevated, RelativeSource={RelativeSource AncestorType=UserControl}}"
        AutomationProperties.LabeledBy="{Binding ElementName=QualityLabel}" AutomationProperties.Name="{Binding DataContext.Text[UpdatesQualityDays], RelativeSource={RelativeSource AncestorType=UserControl}}"
        AutomationProperties.HelpText="{Binding DataContext.Text[UpdatesDaysHelp], RelativeSource={RelativeSource AncestorType=UserControl}}"/>
      </Grid>
      <CheckBox IsChecked="{Binding ExcludeDrivers, Mode=TwoWay}" MinHeight="32" Margin="{StaticResource WinoraSpace.T8}"
       Visibility="{Binding ShowDriverOption, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding DataContext.IsElevated, RelativeSource={RelativeSource AncestorType=UserControl}}"
       AutomationProperties.Name="{Binding DataContext.Text[UpdatesExcludeDrivers], RelativeSource={RelativeSource AncestorType=UserControl}}">
       <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding DataContext.Text[UpdatesExcludeDrivers], RelativeSource={RelativeSource AncestorType=UserControl}}" TextWrapping="Wrap"/>
      </CheckBox>
     </StackPanel>
    </StackPanel>
   </Border>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding IsPicked}" Value="True">
     <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
     <Setter TargetName="Ring" Property="Visibility" Value="Collapsed"/><Setter TargetName="Fill" Property="Visibility" Value="Visible"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/>
     <Setter TargetName="Options" Property="Visibility" Value="Visible"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding CanPick}" Value="False"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextFillColorDisabledBrush}"/></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate x:Key="PolicyTemplate" DataType="{x:Type vm:UpdatePolicyRowItem}">
   <Border Style="{StaticResource WinoraSectionRow}" AutomationProperties.Name="{Binding AutomationName}">
    <StackPanel VerticalAlignment="Center">
     <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding Text}" TextWrapping="Wrap"/>
     <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding SourceText}" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
  </DataTemplate>

  <DataTemplate x:Key="FactTemplate" DataType="{x:Type vm:UpdateFactItem}">
   <Grid Margin="{StaticResource WinoraSpace.V4}" AutomationProperties.Name="{Binding AutomationName}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="320"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
    <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding Label}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.R16}"/>
    <TextBlock Grid.Column="1" Style="{StaticResource WinoraBody}" Text="{Binding Value}" TextWrapping="Wrap"/>
   </Grid>
  </DataTemplate>

 </UserControl.Resources>

 <ctl:SettingsPage x:Name="Workspace">
  <ctl:SettingsPage.Header>
   <ctl:PageHeader Title="{Binding Title}" Subtitle="{Binding Text[UpdatesIntro]}">
     <ctl:PageHeader.Actions><WrapPanel><ui:Button Margin="{StaticResource WinoraSpace.A4}" ToolTip="{Binding Text[DiscRefresh]}" Style="{StaticResource WinoraHeaderIconButton}" Command="{Binding RefreshCommand}" Icon="{ui:SymbolIcon ArrowClockwise24}"
      AutomationProperties.Name="{Binding Text[DiscRefresh]}" AutomationProperties.HelpText="{Binding Text[UpdatesRefreshHelp]}"/></WrapPanel></ctl:PageHeader.Actions>
    </ctl:PageHeader>
  </ctl:SettingsPage.Header>
  <ctl:SettingsPage.Tabs>
   <ctl:TabRail x:Name="Rail" ContentTabs="{Binding ElementName=Tabs}" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Text[V2PaTabsHelp]}" Visibility="{Binding Visibility, ElementName=Tabs}"/>
  </ctl:SettingsPage.Tabs>
  <ctl:SettingsPage.Banners>
   <StackPanel>
    <ctl:AdminNotice IsOpen="{Binding ShowNeedsAdministrator, Mode=OneWay}" Title="{Binding NeedsAdministratorTitle}" Message="{Binding NeedsAdministratorText, Mode=OneWay}" ShowLink="{Binding ShowAdminHowTo}" LinkText="{Binding Text[AdminNoticeLink]}" LinkHelp="{Binding Text[AdminNoticeLinkHelp]}"/>
    <ctl:InfoBanner Kind="ProtectedByPolicy" IsOpen="{Binding ShowOrganization, Mode=OneWay}" IsClosable="False" Severity="Warning" Title="{Binding Text[UpdatesOrgTitle]}" Message="{Binding Text[UpdatesOrgBody]}" Margin="{StaticResource WinoraSpace.B8}"
     AutomationProperties.Name="{Binding Text[UpdatesOrgTitle]}"/>
    <ctl:InfoBanner IsOpen="{Binding ShowPaused, Mode=OneWay}" IsClosable="False" Severity="Warning" Title="{Binding Text[UpdatesPausedTitle]}" Message="{Binding PausedText, Mode=OneWay}" Margin="{StaticResource WinoraSpace.B8}"
     AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding PausedText}"/>
    <ctl:InfoBanner Kind="RestartNeeded" IsOpen="{Binding ShowRestart, Mode=OneWay}" IsClosable="False" Severity="Informational" Title="{Binding Text[UpdatesRestartTitle]}" Message="{Binding Text[UpdatesRestartBody]}" Margin="{StaticResource WinoraSpace.B8}"
     AutomationProperties.Name="{Binding Text[UpdatesRestartTitle]}"/>
    <ctl:InfoBanner IsOpen="{Binding ShowNoticeBanner, Mode=OneWay}" IsClosable="False" Severity="Warning" Title="{Binding Text[PowerResult]}" Message="{Binding Notice}" Margin="{StaticResource WinoraSpace.B8}"
     AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Notice}"/>

    <ctl:LoadingSkeleton x:Name="LoadingState" Message="{Binding Text[Working]}" Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}"/>
    <ctl:ErrorState x:Name="ErrorPanel" Headline="{Binding Text[UpdatesLoadFailedTitle]}" Message="{Binding LoadError}" ActionText="{Binding Text[TryAgain]}" ActionCommand="{Binding RefreshCommand}" ActionHelp="{Binding Text[UpdatesRefreshHelp]}"
     Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibility}}"/>
    <ctl:EmptyState x:Name="CatalogMissing" Icon="Warning24" Headline="{Binding Text[OptimizeCode_optimize_no_catalog]}" Visibility="{Binding ShowCatalogMissing, Converter={StaticResource BoolToVisibility}}"/>

    
   </StackPanel>
  </ctl:SettingsPage.Banners>
  <ctl:SettingsPage.Body>
   <ctl:TabBody x:Name="Tabs" Style="{StaticResource WinoraTabContentStyle}" Visibility="{Binding ShowContent, Converter={StaticResource BoolToVisibility}}" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
     <TabItem Header="{Binding Text[UpdatesModesHeading]}" AutomationProperties.Name="{Binding Text[UpdatesModesHeading]}">
      <StackPanel Margin="{StaticResource WinoraSpace.T16}">
    <!-- Pick a mode: the cards below are one radio group. -->
    <TextBlock x:Name="PickerHelp" Style="{StaticResource WinoraCaption}" Text="{Binding Text[UpdatesPickerHelp]}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.B8}"/>
    <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding CurrentModeText}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.Tn4B8}" AutomationProperties.LiveSetting="Polite"/>
    <ItemsControl x:Name="ModeList" ItemsSource="{Binding Modes}" ItemTemplate="{StaticResource ModeTemplate}" IsTabStop="False" Focusable="False" AutomationProperties.Name="{Binding Text[UpdatesModesHeading]}"/>

    <Border Style="{StaticResource WinoraActionCard}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Text[UpdatesPauseHeading]}" TextWrapping="Wrap"/>
       <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Text[UpdatesPauseBody]}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T2}"/>
      </StackPanel>
      <ui:Button Grid.Column="1" Style="{StaticResource WinoraRowButton}" Content="{Binding Text[UpdatesOpenSettings]}" Command="{Binding OpenSettingsCommand}" Icon="{ui:SymbolIcon Open24}" Margin="{StaticResource WinoraSpace.L16}"
       AutomationProperties.Name="{Binding Text[UpdatesOpenSettings]}" AutomationProperties.HelpText="{Binding Text[UpdatesOpenSettingsHelp]}"/>
     </Grid>
    </Border>

    <!-- Advanced (High risk): closed until opened, with the warning inside. -->
    <ctl:CardExpander x:Name="AdvancedExpander" Header="{Binding Text[UpdatesAdvancedHeading]}" Subtitle="{Binding Text[V2TuAdvancedSub]}" Warning="{Binding Text[UpdatesAdvancedIntro]}" Icon="Warning24"
     Margin="{StaticResource WinoraSpace.T16B8}" Visibility="{Binding HasAdvanced, Converter={StaticResource BoolToVisibility}}">
     <ItemsControl x:Name="AdvancedList" ItemsSource="{Binding AdvancedModes}" ItemTemplate="{StaticResource ModeTemplate}" IsTabStop="False" Focusable="False" AutomationProperties.Name="{Binding Text[UpdatesAdvancedHeading]}"/>
    </ctl:CardExpander>

      </StackPanel>
     </TabItem>
     <TabItem Header="{Binding Text[UpdatesFactsHeading]}" AutomationProperties.Name="{Binding Text[UpdatesFactsHeading]}">
      <StackPanel Margin="{StaticResource WinoraSpace.T16}">
    <Border Style="{StaticResource WinoraActionCard}">
     <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource FactTemplate}" IsTabStop="False" Focusable="False" AutomationProperties.Name="{Binding Text[UpdatesFactsHeading]}"/>
    </Border>
    <ctl:CardHeader Title="{Binding Text[UpdatesPolicyHeading]}"/>
    <Border Style="{StaticResource WinoraSectionRow}" Visibility="{Binding ShowNoPolicyRows, Converter={StaticResource BoolToVisibility}}">
     <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding Text[UpdatesPolicyNone]}" TextWrapping="Wrap"/>
    </Border>
    <ItemsControl ItemsSource="{Binding PolicyRows}" ItemTemplate="{StaticResource PolicyTemplate}" IsTabStop="False" Focusable="False" AutomationProperties.Name="{Binding Text[UpdatesPolicyHeading]}"/>
    <Border Style="{StaticResource WinoraCardCap}"/>

      </StackPanel>
     </TabItem>
    </ctl:TabBody>
  </ctl:SettingsPage.Body>
  <ctl:SettingsPage.Footer>
    <ctl:PageHistory DataContext="{Binding HistoryList}"/>
  </ctl:SettingsPage.Footer>
 </ctl:SettingsPage>
</UserControl>
