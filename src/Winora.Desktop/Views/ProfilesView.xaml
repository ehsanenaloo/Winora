<UserControl x:Class="Winora.Desktop.ProfilesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:local="clr-namespace:Winora.Desktop" xmlns:vm="clr-namespace:Winora.Desktop;assembly=Winora.Presentation" xmlns:ctl="clr-namespace:Winora.Desktop.Controls"
 AutomationProperties.Name="{Binding Title}" Focusable="False" SizeChanged="OnSizeChanged">
 <UserControl.Resources>
  <!-- A built-in profile: one card of a radio group. The header chooses it; "What changes" opens the list of settings. The chosen card has the accent edge and a filled check mark, the same
 cue as the chosen mode on Windows Update, so the choice does not rest on color. -->
  <DataTemplate x:Key="BuiltInTemplate" DataType="{x:Type vm:ProfileCardRow}">
   <Border x:Name="Card" Style="{StaticResource WinoraListCard}" Margin="{StaticResource WinoraSpace.R12B12}" SnapsToDevicePixels="True">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="ProfileHeader"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <RadioButton Grid.Row="0" Style="{StaticResource WinoraProfileChoice}" GroupName="WinoraProfileChoice" IsChecked="{Binding IsChecked, Mode=TwoWay}" Command="{Binding ChooseCommand}" CommandParameter="{Binding}"
      AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Description}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource WinoraSurfaceSunkenBrush}" VerticalAlignment="Top" Margin="{StaticResource WinoraSpace.R12}">
        <ui:SymbolIcon Symbol="{Binding IconSymbol, Converter={x:Static ctl:IconKeys.Symbol}}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
       </Border>
       <StackPanel Grid.Column="1">
        <WrapPanel>
         <TextBlock Style="{StaticResource WinoraCardTitle}" Text="{Binding Name}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.R8}" VerticalAlignment="Center"/>
         <ctl:StatusBadge Kind="Info" Text="{Binding RecommendedText}" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center"/>
        </WrapPanel>
        <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding Description}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T2}"/>
       </StackPanel>
       <Grid Grid.Column="2" Width="24" Height="24" Margin="{StaticResource WinoraSpace.L12}" VerticalAlignment="Top">
        <Ellipse x:Name="Ring" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="2"/>
        <Ellipse x:Name="Fill" Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
        <ui:SymbolIcon x:Name="Check" Symbol="Checkmark16" FontSize="14" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
       </Grid>
      </Grid>
     </RadioButton>
     <WrapPanel Grid.Row="1" Margin="{StaticResource WinoraSpace.L16R16B4}" VerticalAlignment="Center">
      <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding ChangeCountText}" Margin="{StaticResource WinoraSpace.R12}" VerticalAlignment="Center"/>
      <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding AlreadySetText}" Margin="{StaticResource WinoraSpace.R12}" VerticalAlignment="Center" Visibility="{Binding HasAlreadySet, Converter={StaticResource BoolToVisibility}}"/>
      <ctl:RiskChip Level="{Binding RiskLevel}" Text="{Binding RiskBadgeText}" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center"/>
     </WrapPanel>
     <StackPanel Grid.Row="2" Margin="{StaticResource WinoraSpace.L8R8B8}">
      <ctl:ChevronToggle IsChecked="{Binding IsExpanded, Mode=TwoWay}" Content="{Binding WhatChangesText}" HorizontalAlignment="Left" AutomationProperties.Name="{Binding WhatChangesHelp}"/>
      <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" Margin="{StaticResource WinoraSpace.H8}">
       <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding AllSetText}" TextWrapping="Wrap" Visibility="{Binding HasNoChanges, Converter={StaticResource BoolToVisibility}}"/>
       <ItemsControl ItemsSource="{Binding Changes}" IsTabStop="False" Focusable="False" AutomationProperties.Name="{Binding WhatChangesText}">
        <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ProfileCardChange}">
         <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WinoraCardBorderBrush}" Padding="{StaticResource WinoraSpace.V4}" AutomationProperties.Name="{Binding AutomationName}">
          <StackPanel>
           <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding Title}" TextWrapping="Wrap"/>
           <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding ChangeText}" TextWrapping="Wrap"/>
          </StackPanel>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </StackPanel>
    </Grid>
   </Border>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding IsChosen}" Value="True">
     <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
     <Setter TargetName="Ring" Property="Visibility" Value="Collapsed"/>
     <Setter TargetName="Fill" Property="Visibility" Value="Visible"/>
     <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
    </DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:ProfileCardRow}">
   <Border CornerRadius="{StaticResource WinoraCornerRadius}" BorderThickness="1" Padding="{StaticResource WinoraSpace.A16}" Margin="{StaticResource WinoraSpace.R12B12}" Background="{DynamicResource WinoraSurfaceCardBrush}" BorderBrush="{DynamicResource WinoraCardBorderBrush}"
    AutomationProperties.Name="{Binding AutomationName}">
    <StackPanel>
     <TextBlock Style="{StaticResource WinoraSubtitle}" Text="{Binding Name}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
     <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding Description}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T2B4}"/>
     <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding CountText}" TextWrapping="Wrap"/>
     <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding PreviewText}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T4}"/>
     <ctl:RiskChip Level="{Binding RiskLevel}" Text="{Binding RiskBadgeText}" Margin="{StaticResource WinoraSpace.T4}" Visibility="{Binding HasRisk, Converter={StaticResource BoolToVisibility}}"/>
     <ItemsControl ItemsSource="{Binding Categories}" IsTabStop="False" Focusable="False" Margin="{StaticResource WinoraSpace.T8}" Visibility="{Binding HasCategories, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><ctl:StatusBadge Kind="Neutral" Text="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <WrapPanel Margin="{StaticResource WinoraSpace.T8}">
      <ui:Button Content="{Binding ReviewLabel}" Command="{Binding ReviewCommand}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon DocumentSearch24}" Margin="{StaticResource WinoraSpace.R8B4}"
       ctl:A11y.Label="{Binding ReviewLabel}" ctl:A11y.Item="{Binding Name}" AutomationProperties.HelpText="{Binding ReviewHelp}"/>
      <ui:Button Content="{Binding DataContext.Text[ProfileExport], RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding ExportCommand}" CommandParameter="{Binding}" Margin="{StaticResource WinoraSpace.R8B4}"
       Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}" ctl:A11y.Label="{Binding DataContext.Text[ProfileExport], RelativeSource={RelativeSource AncestorType=UserControl}}" ctl:A11y.Item="{Binding Name}"
       AutomationProperties.HelpText="{Binding DataContext.Text[ProfileExportHelp], RelativeSource={RelativeSource AncestorType=UserControl}}"/>
      <ui:Button Content="{Binding DataContext.Text[ProfileDelete], RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding DeleteCommand}" CommandParameter="{Binding}" Margin="{StaticResource WinoraSpace.R8B4}"
       Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}" ctl:A11y.Label="{Binding DataContext.Text[ProfileDelete], RelativeSource={RelativeSource AncestorType=UserControl}}" ctl:A11y.Item="{Binding Name}"
       AutomationProperties.HelpText="{Binding DataContext.Text[ProfileDeleteHelp], RelativeSource={RelativeSource AncestorType=UserControl}}"/>
     </WrapPanel>
    </StackPanel>
   </Border>
  </DataTemplate>

  <DataTemplate x:Key="PlanRowTemplate" DataType="{x:Type vm:ProfilePlanRowView}">
   <Border Padding="{StaticResource WinoraSpace.V4}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" AutomationProperties.Name="{Binding AutomationName}">
    <StackPanel>
     <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Title}" TextWrapping="Wrap"/>
     <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding ChangeText}" TextWrapping="Wrap" Visibility="{Binding IsChange, Converter={StaticResource BoolToVisibility}}"/>
     <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding Status}" TextWrapping="Wrap" Visibility="{Binding IsSkipped, Converter={StaticResource BoolToVisibility}}"/>
     <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Reason}" TextWrapping="Wrap"/>
     <WrapPanel Margin="{StaticResource WinoraSpace.T2}">
      <ctl:RiskChip Level="{Binding RiskLevel}" Text="{Binding Risk}" HideWhenLow="True"/>
      <ctl:StatusBadge Kind="Neutral" Text="{Binding Scope}"/>
      <ctl:StatusBadge Kind="Restart" Text="{Binding Restart}" Visibility="{Binding HasRestart, Converter={StaticResource BoolToVisibility}}"/>
     </WrapPanel>
    </StackPanel>
   </Border>
  </DataTemplate>

  <DataTemplate x:Key="PlanGroupTemplate" DataType="{x:Type vm:ProfilePlanGroupView}">
   <StackPanel Margin="{StaticResource WinoraSpace.B8}" AutomationProperties.Name="{Binding AutomationName}">
    <TextBlock Style="{StaticResource WinoraSectionHeading}" Text="{Binding Heading}" Margin="{StaticResource WinoraSpace.T4B2}"/>
    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource PlanRowTemplate}" IsTabStop="False" Focusable="False"/>
   </StackPanel>
  </DataTemplate>


 </UserControl.Resources>

 <ctl:SettingsPage x:Name="Workspace">
  <ctl:SettingsPage.Header>
   <ctl:PageHeader Title="{Binding Title}" Subtitle="{Binding Text[ProfileIntro]}">
     <ctl:PageHeader.Actions><WrapPanel><ui:Button Margin="{StaticResource WinoraSpace.A4}" x:Name="RefreshButton" ToolTip="{Binding Text[DiscRefresh]}" Style="{StaticResource WinoraHeaderIconButton}" Command="{Binding RefreshCommand}" Icon="{ui:SymbolIcon ArrowClockwise24}"
      AutomationProperties.Name="{Binding Text[DiscRefresh]}" AutomationProperties.HelpText="{Binding Text[ProfileRefreshHelp]}"/></WrapPanel></ctl:PageHeader.Actions>
    </ctl:PageHeader>
  </ctl:SettingsPage.Header>
  <ctl:SettingsPage.Banners>
   <StackPanel>
    <ctl:AdminNotice IsOpen="{Binding ShowNeedsAdministrator, Mode=OneWay}" Title="{Binding NeedsAdministratorTitle}" Message="{Binding NeedsAdministratorText, Mode=OneWay}" ShowLink="{Binding ShowAdminHowTo}" LinkText="{Binding Text[AdminNoticeLink]}" LinkHelp="{Binding Text[AdminNoticeLinkHelp]}"/>
    <ctl:InfoBanner x:Name="NoticeBar" IsOpen="{Binding ShowNoticeBanner, Mode=OneWay}" IsClosable="False" Severity="{Binding NoticeSeverity, Converter={x:Static ctl:BannerLook.Severity}}" Title="{Binding Text[ProfileResultTitle]}" Message="{Binding Notice}"
     AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Notice}"/>

    <!-- Page states: the first read, or profile files that could not be used. -->
    <ctl:LoadingSkeleton x:Name="LoadingState" Message="{Binding Text[ProfileLoading]}" Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}"/>
    <ctl:ErrorState x:Name="FailureState" Headline="{Binding Text[ProfileLoadErrorTitle]}" Message="{Binding LoadFailedText}" ActionText="{Binding Text[TryAgain]}" ActionCommand="{Binding RefreshCommand}"
     ActionHelp="{Binding Text[ProfileRefreshHelp]}" Visibility="{Binding ShowLoadFailed, Converter={StaticResource BoolToVisibility}}"/>
   </StackPanel>
  </ctl:SettingsPage.Banners>
  <ctl:SettingsPage.Body>
   <StackPanel HorizontalAlignment="Left">
    <!-- Built-in profiles -->
    <TextBlock Style="{StaticResource WinoraSectionHeading}" Text="{Binding Text[ProfileBuiltInHeading]}" Margin="{StaticResource WinoraSpace.T8B4}"/>
    <ItemsControl x:Name="BuiltInList" Grid.IsSharedSizeScope="True" ItemsSource="{Binding BuiltInCards}" ItemTemplate="{StaticResource BuiltInTemplate}" IsTabStop="False" Focusable="False" AutomationProperties.Name="{Binding Text[ProfileBuiltInHeading]}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding CardColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>

    <Grid Margin="{StaticResource WinoraSpace.B12}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Text[V2PfSafe]}" TextWrapping="Wrap" VerticalAlignment="Center"/>
     <ui:Button x:Name="ReviewChosenButton" Grid.Column="1" Content="{Binding ReviewChosenLabel}" Command="{Binding ReviewChosenCommand}" Appearance="Primary" Icon="{ui:SymbolIcon DocumentSearch24}" Margin="{StaticResource WinoraSpace.L12}"
      AutomationProperties.Name="{Binding ReviewChosenLabel}" AutomationProperties.HelpText="{Binding ReviewChosenHelp}"/>
    </Grid>

    <!-- Last applied run and the comparison table -->
    <Grid x:Name="LastAppliedRow" Margin="{StaticResource WinoraSpace.B8}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="LastAppliedText" Style="{StaticResource WinoraBody}" Text="{Binding LastAppliedText}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
     <WrapPanel Grid.Column="1">
      <ui:Button x:Name="UndoLastButton" Content="{Binding Text[ProfileUndoAll]}" Command="{Binding UndoCommand}" CommandParameter="{Binding LastApplied}" Icon="{ui:SymbolIcon ArrowUndo24}" Margin="{StaticResource WinoraSpace.L12}"
       Visibility="{Binding HasLastApplied, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Text[ProfileUndoAll]}" AutomationProperties.HelpText="{Binding Text[ProfileUndoHelp]}"/>
      <ui:Button x:Name="CompareButton" Content="{Binding CompareLabel}" Command="{Binding ToggleCompareCommand}" Margin="{StaticResource WinoraSpace.L8}" Visibility="{Binding HasCompare, Converter={StaticResource BoolToVisibility}}"
       AutomationProperties.Name="{Binding CompareLabel}" AutomationProperties.HelpText="{Binding Text[ProfileCompareHelp]}"/>
     </WrapPanel>
    </Grid>
    <Border x:Name="ComparePanel" CornerRadius="{StaticResource WinoraCornerRadius}" BorderThickness="1" Padding="{StaticResource WinoraSpace.A16}" Margin="{StaticResource WinoraSpace.B12}" Background="{DynamicResource WinoraSurfaceCardBrush}" BorderBrush="{DynamicResource WinoraCardBorderBrush}"
     Visibility="{Binding ShowCompare, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Text[ProfileCompareHeading]}">
     <StackPanel>
      <TextBlock Style="{StaticResource WinoraSectionHeading}" Text="{Binding Text[ProfileCompareHeading]}" AutomationProperties.HeadingLevel="Level2"/>
      <ItemsControl x:Name="CompareList" ItemsSource="{Binding CompareRows}" IsTabStop="False" Focusable="False" Margin="{StaticResource WinoraSpace.T8}" AutomationProperties.Name="{Binding Text[ProfileCompareHeading]}">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource WinoraCardBorderBrush}" Padding="{StaticResource WinoraSpace.V4}" AutomationProperties.Name="{Binding AutomationName}">
          <StackPanel>
           <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Title}" TextWrapping="Wrap"/>
           <ItemsControl ItemsSource="{Binding Cells}" IsTabStop="False" Focusable="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding}" Margin="{StaticResource WinoraSpace.R16}" MinWidth="110"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </Border>

    <!-- The open plan -->
    <StackPanel x:Name="PlanPanel" Margin="{StaticResource WinoraSpace.T12}" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
     <Border Style="{StaticResource WinoraCardBorder}">
      <StackPanel>
       <TextBlock x:Name="PlanHeading" Style="{StaticResource WinoraSectionHeading}" Text="{Binding PlanTitle}" TextWrapping="Wrap"/>
       <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding PlanSummary}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.V2}"/>
       <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Text[ProfilePlanNothingYet]}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.B4}"/>
       <ItemsControl x:Name="PlanList" ItemsSource="{Binding PlanGroups}" ItemTemplate="{StaticResource PlanGroupTemplate}" IsTabStop="False" Focusable="False" AutomationProperties.Name="{Binding PlanTitle}"/>
       <WrapPanel Margin="{StaticResource WinoraSpace.T8}">
        <ui:Button x:Name="ApplyButton" Content="{Binding ApplyLabel}" Command="{Binding ApplyCommand}" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Margin="{StaticResource WinoraSpace.R8B4}"
         AutomationProperties.Name="{Binding ApplyLabel}" AutomationProperties.HelpText="{Binding Text[ProfileApplyHelp]}"/>
        <ui:Button x:Name="CloseButton" Content="{Binding Text[ProfileClose]}" Command="{Binding CloseCommand}" Margin="{StaticResource WinoraSpace.R8B4}"
         AutomationProperties.Name="{Binding Text[ProfileClose]}" AutomationProperties.HelpText="{Binding Text[ProfileCloseHelp]}"/>
       </WrapPanel>
      </StackPanel>
     </Border>
    </StackPanel>

    <!-- The report of the last run or undo -->
    <ctl:ResultReport x:Name="ReportPanel" Model="{Binding Report}" Margin="{StaticResource WinoraSpace.T12}" Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}"/>

    <!-- Custom profiles -->
    <TextBlock Style="{StaticResource WinoraSectionHeading}" Text="{Binding Text[ProfileCustomHeading]}" Margin="{StaticResource WinoraSpace.T20B2}"/>
    <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding Text[ProfileCustomIntro]}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.B4}" Visibility="{Binding HasCustom, Converter={StaticResource BoolToVisibility}}"/>
    <ctl:EmptyState x:Name="NoCustomState" Icon="Sparkle24" Headline="{Binding Text[ProfileCustomEmptyTitle]}" Message="{Binding Text[ProfileCustomIntro]}" Margin="{StaticResource WinoraSpace.T8B16}"
     Visibility="{Binding ShowNoCustom, Converter={StaticResource BoolToVisibility}}"/>
    <ItemsControl x:Name="CustomList" ItemsSource="{Binding CustomCards}" ItemTemplate="{StaticResource CardTemplate}" IsTabStop="False" Focusable="False" AutomationProperties.Name="{Binding Text[ProfileCustomHeading]}"
     Visibility="{Binding HasCustom, Converter={StaticResource BoolToVisibility}}"/>
    <Border Style="{StaticResource WinoraCardBorder}">
     <StackPanel>
      <TextBlock x:Name="SaveNameLabel" Style="{StaticResource WinoraCaption}" Text="{Binding Text[ProfileNameLabel]}"/>
      <TextBox x:Name="SaveNameBox" Text="{Binding SaveName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" MinWidth="260" MaxWidth="480" HorizontalAlignment="Left"
       AutomationProperties.LabeledBy="{Binding ElementName=SaveNameLabel}" AutomationProperties.Name="{Binding Text[ProfileNameLabel]}" AutomationProperties.HelpText="{Binding Text[ProfileNameHelp]}"/>
      <WrapPanel Margin="{StaticResource WinoraSpace.T8}">
       <ui:Button x:Name="SavePendingButton" Content="{Binding Text[ProfileSavePending]}" Command="{Binding SavePendingCommand}" Margin="{StaticResource WinoraSpace.R8B4}"
        AutomationProperties.Name="{Binding Text[ProfileSavePending]}" AutomationProperties.HelpText="{Binding Text[ProfileSavePendingHelp]}"/>
       <ui:Button x:Name="SaveChangedButton" Content="{Binding Text[ProfileSaveChanged]}" Command="{Binding SaveChangedCommand}" Margin="{StaticResource WinoraSpace.R8B4}"
        AutomationProperties.Name="{Binding Text[ProfileSaveChanged]}" AutomationProperties.HelpText="{Binding Text[ProfileSaveChangedHelp]}"/>
       <ui:Button x:Name="ImportButton" Content="{Binding Text[ProfileImport]}" Command="{Binding ImportCommand}" Icon="{ui:SymbolIcon FolderOpen24}" Margin="{StaticResource WinoraSpace.R8B4}"
        AutomationProperties.Name="{Binding Text[ProfileImport]}" AutomationProperties.HelpText="{Binding Text[ProfileImportHelp]}"/>
      </WrapPanel>
     </StackPanel>
    </Border>
   </StackPanel>
  </ctl:SettingsPage.Body>
  <ctl:SettingsPage.Footer>
    <!-- History -->
    <ctl:PageHistory DataContext="{Binding HistoryList}"/>
  </ctl:SettingsPage.Footer>
 </ctl:SettingsPage>
</UserControl>
