<UserControl x:Class="Winora.Desktop.OverviewView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ctl="clr-namespace:Winora.Desktop.Controls"
 AutomationProperties.Name="{Binding Title}" Focusable="False" SizeChanged="OnSizeChanged">
 <ctl:DashboardPage x:Name="Workspace">
  <ctl:DashboardPage.Header>
   <ctl:PageHeader Title="{Binding Title}" Subtitle="{Binding Text[OverviewSubtitle]}" MetaText="{Binding MetaText}">
    <ctl:PageHeader.Actions>
     <WrapPanel>
      <ui:ProgressRing IsIndeterminate="{Binding IsVisible, RelativeSource={RelativeSource Self}, Mode=OneWay}" Margin="{StaticResource WinoraSpace.A4}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Text[DashReading]}"/>
      <ui:Button x:Name="ScanCancel" Content="{Binding Text[OverviewCancelScan]}" Command="{Binding CancelScanCommand}" Margin="{StaticResource WinoraSpace.A4}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"
       AutomationProperties.Name="{Binding Text[OverviewCancelScan]}" AutomationProperties.HelpText="{Binding Text[DiscCancelHelp]}"/>
      <ui:Button x:Name="ScanButton" Content="{Binding Text[OverviewScanThisPc]}" Command="{Binding ScanCommand}" Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="{StaticResource WinoraSpace.A4}"
       AutomationProperties.Name="{Binding Text[OverviewScanThisPc]}" AutomationProperties.HelpText="{Binding Text[OverviewScanHelp]}"/>
      <ui:Button x:Name="DashboardCopy" Margin="{StaticResource WinoraSpace.A4}" DataContext="{Binding Dashboard}" Content="{Binding DataContext.Text[DashCopy], RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding CopyCommand}" Icon="{ui:SymbolIcon Copy24}"
       Visibility="{Binding DataContext.HasDashboard, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"
       AutomationProperties.Name="{Binding DataContext.Text[DashCopy], RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.HelpText="{Binding DataContext.Text[DashCopyHelp], RelativeSource={RelativeSource AncestorType=UserControl}}"/>
     </WrapPanel>
    </ctl:PageHeader.Actions>
   </ctl:PageHeader>
  </ctl:DashboardPage.Header>
  <ctl:DashboardPage.Tabs>
   <ctl:TabRail x:Name="Rail" ContentTabs="{Binding ElementName=Tabs}" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Text[V2PaTabsHelp]}"/>
  </ctl:DashboardPage.Tabs>
  <ctl:DashboardPage.Banners>
   <StackPanel>
   <!-- A partial or failed apply: one bar with a way to the details. -->
   <ctl:InfoBanner x:Name="FailureBar" DataContext="{Binding Recent}" IsOpen="{Binding ShowFailure, Mode=TwoWay}" IsClosable="True" CloseText="{Binding DataContext.Text[BannerDismiss], RelativeSource={RelativeSource AncestorType=UserControl}}"
    Severity="Error" Title="{Binding FailureTitle}" Message="{Binding FailureMessage}" AutomationProperties.Name="{Binding FailureTitle}">
    
     <ui:Button Content="{Binding FailureAction}" Margin="{StaticResource WinoraSpace.T8}" HorizontalAlignment="Left" Command="{Binding OpenHistoryCommand}" AutomationProperties.Name="{Binding FailureAction}" AutomationProperties.HelpText="{Binding FailureActionHelp}"/>
    
   </ctl:InfoBanner>

   
   </StackPanel>
  </ctl:DashboardPage.Banners>
  <ctl:DashboardPage.Body>
   <StackPanel x:Name="Page">
   <ctl:TabBody x:Name="Tabs" Style="{StaticResource WinoraTabContentStyle}" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Margin="{StaticResource WinoraSpace.B16}">
   <TabItem Header="{Binding Text[V2OvTabSummary]}" AutomationProperties.Name="{Binding Text[V2OvTabSummary]}">
    <StackPanel Margin="{StaticResource WinoraSpace.T16}">
   <!-- Setup score: the share of recommended settings in place. It is not a speed measurement and says so. -->
   <Border x:Name="ScoreCard" Style="{StaticResource WinoraSurfaceCard}" Margin="{StaticResource WinoraSpace.B16}" Padding="{StaticResource WinoraSpace.A24}" DataContext="{Binding Score}" Visibility="{Binding HasScore, Converter={StaticResource BoolToVisibility}}"
    AutomationProperties.Name="{Binding AutomationName}">
    <Grid x:Name="ScoreGrid">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="RingColumn" Width="Auto"/><ColumnDefinition x:Name="BodyColumn" Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="BodyRow" Height="0"/></Grid.RowDefinitions>
     <Grid x:Name="RingBox" Width="160" Height="160" Margin="{StaticResource WinoraSpace.R24}" VerticalAlignment="Top">
      <ctl:ScoreRing x:Name="Ring" Value="{Binding Value}" AnimationToken="{Binding AnimationToken}" Thickness="12" ArcBrush="{DynamicResource AccentFillColorDefaultBrush}" TrackBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
       AutomationProperties.Name="{Binding RingName}"/>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
       <TextBlock x:Name="RingNumber" Style="{StaticResource WinoraRingNumber}" HorizontalAlignment="Center" Text="{Binding DisplayNumber, ElementName=Ring}"/>
       <TextBlock Style="{StaticResource WinoraCaption}" HorizontalAlignment="Center" Text="{Binding Of100}"/>
      </StackPanel>
     </Grid>
     <StackPanel x:Name="ScoreBody" Grid.Column="1">
      <ctl:StatusBadge StatusTone="{Binding BandTone}" Text="{Binding BandLabel}" HorizontalAlignment="Left"/>
      <TextBlock Style="{StaticResource WinoraSubtitle}" Text="{Binding Headline}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T8}" AutomationProperties.HeadingLevel="Level2"/>
      <TextBlock x:Name="ScoreDetail" Style="{StaticResource WinoraBody}" Text="{Binding Detail}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T4B12}"/>
      <ItemsControl x:Name="ScoreCategories" ItemsSource="{Binding Categories}" IsTabStop="False" Focusable="False" AutomationProperties.Name="{Binding CategoriesTitle}">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Grid Margin="{StaticResource WinoraSpace.B4}" AutomationProperties.Name="{Binding AutomationName}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap"/>
          <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="6" Margin="{StaticResource WinoraSpace.H8}" Focusable="False" IsTabStop="False" VerticalAlignment="Center" Foreground="{DynamicResource WinoraRingGoodBrush}"/>
          <TextBlock Grid.Column="2" Style="{StaticResource WinoraCaption}" Text="{Binding CountText}" VerticalAlignment="Center" MinWidth="48"/>
         </Grid>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      <WrapPanel Margin="{StaticResource WinoraSpace.T12}">
       <ui:Button x:Name="ScoreReview" Content="{Binding ReviewLabel}" Command="{Binding ReviewCommand}" Icon="{ui:SymbolIcon DocumentSearch24}" Margin="{StaticResource WinoraSpace.R8B4}"
        AutomationProperties.Name="{Binding ReviewLabel}" AutomationProperties.HelpText="{Binding ReviewHelp}"/>
      </WrapPanel>
      <Grid Margin="{StaticResource WinoraSpace.T8}" MaxWidth="560" HorizontalAlignment="Left">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ui:SymbolIcon Symbol="Info24" FontSize="16" Margin="{StaticResource WinoraSpace.T2R8}" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
       <TextBlock x:Name="ScoreNote" Grid.Column="1" Style="{StaticResource WinoraCaption}" Text="{Binding Note}" TextWrapping="Wrap"/>
      </Grid>
     </StackPanel>
    </Grid>
   </Border>
   <!-- Recommended next steps: a fixed rule table over facts read from this PC. Each row is one button with a chevron. -->
   <StackPanel x:Name="NextStepsPanel" Margin="{StaticResource WinoraSpace.B16}" Visibility="{Binding HasNextSteps, Converter={StaticResource BoolToVisibility}}">
    <TextBlock Style="{StaticResource WinoraSubtitle}" Text="{Binding Text[OverviewNextStepsTitle]}" AutomationProperties.HeadingLevel="Level2"/>
    <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Text[OverviewNextStepsHelp]}" Margin="{StaticResource WinoraSpace.T2B8}" TextWrapping="Wrap"/>
    <ItemsControl x:Name="NextStepList" ItemsSource="{Binding NextSteps.Rows}" IsTabStop="False" Focusable="False" AutomationProperties.Name="{Binding Text[OverviewNextStepsTitle]}">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <Border Style="{StaticResource WinoraSurfaceCard}" Margin="{StaticResource WinoraSpace.B8}" Padding="{StaticResource WinoraSpace.None}" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding AutomationName}">
        <StackPanel>
         <Button x:Name="StepAction" Style="{StaticResource WinoraCardActionButton}" Command="{Binding ActionCommand}" IsEnabled="{Binding HasAction}"
          AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.HelpText="{Binding ActionHelp}">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <ui:SymbolIcon Symbol="{Binding Icon, Converter={x:Static ctl:IconKeys.Symbol}}" FontSize="24" Margin="{StaticResource WinoraSpace.R12}" VerticalAlignment="Center"/>
           <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"/>
            <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding ActionText}" Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}"/>
           </StackPanel>
           <ui:SymbolIcon Grid.Column="2" Symbol="{Binding Chevron, Converter={x:Static ctl:IconKeys.Symbol}}" FontSize="16" Margin="{StaticResource WinoraSpace.L12}" VerticalAlignment="Center" Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}"/>
          </Grid>
         </Button>
         <ui:Button Command="{Binding ToggleWhyCommand}" Appearance="Transparent" Padding="{StaticResource WinoraSpace.H8V2}" Margin="{StaticResource WinoraSpace.L40B4}" HorizontalAlignment="Left"
          ctl:A11y.Label="{Binding WhyLabel}" ctl:A11y.Item="{Binding ItemName}" AutomationProperties.HelpText="{Binding WhyHelp}">
          <TextBlock Text="{Binding WhyLabel}" TextWrapping="Wrap"/>
         </ui:Button>
         <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding WhyText}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="{StaticResource WinoraSpace.L52R16B12}" Visibility="{Binding ShowWhy, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>
       </Border>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ctl:EmptyState x:Name="NextStepsEmpty" Icon="CheckmarkCircle24" Headline="{Binding NextSteps.EmptyTitle}" Message="{Binding NextSteps.EmptyBody}" Visibility="{Binding NextSteps.ShowEmpty, Converter={StaticResource BoolToVisibility}}"/>
   </StackPanel>
   <!-- Quick profile: pick a profile and open its review. Nothing is applied here. -->
   <Border Style="{StaticResource WinoraCardBorder}" x:Name="QuickProfileCard" Margin="{StaticResource WinoraSpace.B16}" Padding="{StaticResource WinoraSpace.A16}" HorizontalAlignment="Stretch" Visibility="{Binding HasQuickProfile, Converter={StaticResource BoolToVisibility}}"
    AutomationProperties.Name="{Binding QuickProfile.Title}">
    <StackPanel DataContext="{Binding QuickProfile}">
     <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Sparkle24" FontSize="24" Margin="{StaticResource WinoraSpace.R8}"/><TextBlock Style="{StaticResource WinoraSubtitle}" Text="{Binding Title}" AutomationProperties.HeadingLevel="Level2"/></StackPanel>
     <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Help}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="{StaticResource WinoraSpace.T4B8}"/>
     <TextBlock x:Name="QuickProfileLabel" Style="{StaticResource WinoraCaption}" Text="{Binding ComboLabel}"/>
     <ComboBox x:Name="QuickProfileBox" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}" DisplayMemberPath="Name" MinWidth="220" HorizontalAlignment="Left"
      AutomationProperties.LabeledBy="{Binding ElementName=QuickProfileLabel}" AutomationProperties.Name="{Binding ComboLabel}" AutomationProperties.HelpText="{Binding ComboHelp}"/>
     <TextBlock x:Name="QuickProfileSummary" Style="{StaticResource WinoraBody}" Text="{Binding Summary}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T8}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Summary}"/>
     <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding RiskNote}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="{StaticResource WinoraSpace.T2}"/>
     <TextBlock x:Name="QuickProfileLast" Style="{StaticResource WinoraCaption}" Text="{Binding LastApplied}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T2}" Visibility="{Binding HasLastApplied, Converter={StaticResource BoolToVisibility}}"/>
     <ui:Button x:Name="QuickProfileReview" Content="{Binding ReviewLabel}" Command="{Binding ReviewCommand}" Icon="{ui:SymbolIcon DocumentSearch24}" Margin="{StaticResource WinoraSpace.T12}" HorizontalAlignment="Left"
      AutomationProperties.Name="{Binding ReviewLabel}" AutomationProperties.HelpText="{Binding ReviewHelp}"/>
    </StackPanel>
   </Border>
    </StackPanel>
   </TabItem>
   <TabItem Header="{Binding Text[V2OvTabPerformance]}" AutomationProperties.Name="{Binding Text[V2OvTabPerformance]}">
    <StackPanel Margin="{StaticResource WinoraSpace.T16}">
   <!-- Performance check: five values measured on this PC when the user presses Measure, each with its limit, and one score. Never on a timer. -->
   <Border x:Name="PerfCard" Style="{StaticResource WinoraSurfaceCard}" Margin="{StaticResource WinoraSpace.B16}" Padding="{StaticResource WinoraSpace.A24}" DataContext="{Binding Performance}"
    Visibility="{Binding DataContext.HasPerformance, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding AutomationName}">
    <StackPanel>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Style="{StaticResource WinoraSubtitle}" Text="{Binding Title}" AutomationProperties.HeadingLevel="Level2"/>
       <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Intro}" Margin="{StaticResource WinoraSpace.T2}" TextWrapping="Wrap"/>
      </StackPanel>
      <WrapPanel Grid.Column="1" VerticalAlignment="Top" Margin="{StaticResource WinoraSpace.L16}">
       <ui:ProgressRing IsIndeterminate="{Binding IsVisible, RelativeSource={RelativeSource Self}, Mode=OneWay}" Margin="{StaticResource WinoraSpace.A4}" Visibility="{Binding IsMeasuring, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding StageText}"/>
       <ui:Button x:Name="PerfMeasure" Content="{Binding MeasureLabel}" Command="{Binding MeasureCommand}" Icon="{ui:SymbolIcon Pulse24}" Margin="{StaticResource WinoraSpace.A4}"
        AutomationProperties.Name="{Binding MeasureLabel}" AutomationProperties.HelpText="{Binding MeasureHelp}"/>
      </WrapPanel>
     </Grid>
     <TextBlock x:Name="PerfStage" Style="{StaticResource WinoraBodySecondary}" Text="{Binding StageText}" Margin="{StaticResource WinoraSpace.T8}" AutomationProperties.LiveSetting="Polite" Visibility="{Binding IsMeasuring, Converter={StaticResource BoolToVisibility}}"/>
     <Grid x:Name="PerfBody" Margin="{StaticResource WinoraSpace.T16}" Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid x:Name="PerfRingBox" Width="140" Height="140" Margin="{StaticResource WinoraSpace.R24}" VerticalAlignment="Top" Visibility="{Binding HasScore, Converter={StaticResource BoolToVisibility}}">
       <ctl:ScoreRing x:Name="PerfRing" Value="{Binding Value}" AnimationToken="{Binding AnimationToken}" Thickness="12" TrackBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        AutomationProperties.Name="{Binding RingName}">
        <!-- The arc takes the color of the band (the band is also named in words next to the ring). -->
        <ctl:ScoreRing.Style>
         <Style TargetType="ctl:ScoreRing">
          <Setter Property="ArcBrush" Value="{DynamicResource WinoraRingGoodBrush}"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding Band}" Value="Fair"><Setter Property="ArcBrush" Value="{DynamicResource WinoraRingFairBrush}"/></DataTrigger>
           <DataTrigger Binding="{Binding Band}" Value="Low"><Setter Property="ArcBrush" Value="{DynamicResource WinoraRingLowBrush}"/></DataTrigger>
          </Style.Triggers>
         </Style>
        </ctl:ScoreRing.Style>
       </ctl:ScoreRing>
       <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
        <TextBlock Style="{StaticResource WinoraRingNumberSmall}" HorizontalAlignment="Center" Text="{Binding DisplayNumber, ElementName=PerfRing}"/>
        <TextBlock Style="{StaticResource WinoraCaption}" HorizontalAlignment="Center" Text="{Binding Of100}"/>
       </StackPanel>
      </Grid>
      <StackPanel Grid.Column="1">
       <ctl:StatusBadge StatusTone="{Binding BandTone}" Text="{Binding BandLabel}" HorizontalAlignment="Left" Visibility="{Binding HasScore, Converter={StaticResource BoolToVisibility}}"/>
       <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Headline}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T4B2}"/>
       <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding MeasuredText}" Margin="{StaticResource WinoraSpace.B8}"/>
       <ItemsControl x:Name="PerfRows" ItemsSource="{Binding Rows}" IsTabStop="False" Focusable="False" AutomationProperties.Name="{Binding Title}">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Grid Margin="{StaticResource WinoraSpace.B8}" AutomationProperties.Name="{Binding AutomationName}">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Name}"/>
            <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Limit}" TextWrapping="Wrap"/>
           </StackPanel>
           <TextBlock Grid.Column="1" Style="{StaticResource WinoraBody}" Text="{Binding ValueText}" VerticalAlignment="Center" Margin="{StaticResource WinoraSpace.H12}"/>
           <ctl:StatusBadge Grid.Column="2" StatusTone="{Binding Tone}" Text="{Binding StatusText}" VerticalAlignment="Center"/>
          </Grid>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </Grid>
     <Grid Margin="{StaticResource WinoraSpace.T8}" MaxWidth="640" HorizontalAlignment="Left">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ui:SymbolIcon Symbol="Info24" FontSize="16" Margin="{StaticResource WinoraSpace.T2R8}" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      <TextBlock Grid.Column="1" Style="{StaticResource WinoraCaption}" Text="{Binding Note}" TextWrapping="Wrap"/>
     </Grid>
    </StackPanel>
   </Border>
    </StackPanel>
   </TabItem>
   <TabItem Header="{Binding Text[V2OvTabThisPc]}" AutomationProperties.Name="{Binding Text[V2OvTabThisPc]}">
    <StackPanel Margin="{StaticResource WinoraSpace.T16}">
   <!-- This PC: facts read from Windows, once when the page opens and again on request. No timer runs while the page is idle. -->
   <!-- The first read of the facts, or a read that failed -->
   <ctl:LoadingSkeleton x:Name="DashboardLoading" DataContext="{Binding Dashboard}" Message="{Binding UpdatedText}" Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"/>
   <ctl:ErrorState x:Name="DashboardFailure" DataContext="{Binding Dashboard}" Headline="{Binding DataContext.Text[DashReadFailedTitle], RelativeSource={RelativeSource AncestorType=UserControl}}"
    Message="{Binding DataContext.Text[DashReadFailedBody], RelativeSource={RelativeSource AncestorType=UserControl}}" ActionText="{Binding DataContext.Text[TryAgain], RelativeSource={RelativeSource AncestorType=UserControl}}"
    ActionCommand="{Binding RefreshCommand}" ActionHelp="{Binding DataContext.Text[DashRefreshHelp], RelativeSource={RelativeSource AncestorType=UserControl}}" Visibility="{Binding ShowFailure, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"/>
   <StackPanel Visibility="{Binding HasDashboard, Converter={StaticResource BoolToVisibility}}" Margin="{StaticResource WinoraSpace.B16}" DataContext="{Binding}">
    <StackPanel Margin="{StaticResource WinoraSpace.B8}" DataContext="{Binding Dashboard}" AutomationProperties.Name="{Binding DataContext.Text[DashSystemTitle], RelativeSource={RelativeSource AncestorType=UserControl}}">
     <TextBlock Style="{StaticResource WinoraSubtitle}" Text="{Binding DataContext.Text[DashSystemTitle], RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.HeadingLevel="Level2"/>
     <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding DataContext.Text[DashSystemHelp], RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="{StaticResource WinoraSpace.T2}" TextWrapping="Wrap"/>
    </StackPanel>
    <TextBlock DataContext="{Binding Dashboard}" Style="{StaticResource WinoraCaption}" Text="{Binding CopyNotice}" Visibility="{Binding HasCopyNotice, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite" Margin="{StaticResource WinoraSpace.B8}"/>
    <Border Style="{StaticResource WinoraCardBorder}" Margin="{StaticResource WinoraSpace.R12B12}" Padding="{StaticResource WinoraSpace.A16}" HorizontalAlignment="Stretch" DataContext="{Binding Dashboard.Platform}" AutomationProperties.Name="{Binding AutomationName}"
     Visibility="{Binding DataContext.Dashboard.HasPlatform, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="32" Margin="{StaticResource WinoraSpace.T2R16}" VerticalAlignment="Top"/>
      <StackPanel Grid.Column="1">
       <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Title}" AutomationProperties.HeadingLevel="Level3"/>
       <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding Subtitle}" Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}"/>
       <ItemsControl ItemsSource="{Binding Chips}" IsTabStop="False" Focusable="False" Margin="{StaticResource WinoraSpace.T8}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
           <DataTemplate>
            <Border CornerRadius="{StaticResource WinoraCornerRadiusSmall}" Padding="{StaticResource WinoraSpace.H8V4}" Margin="{StaticResource WinoraSpace.R4B4}" Background="{DynamicResource WinoraStatusNeutralBackground}" x:Name="ChipFrame">
             <TextBlock Text="{Binding Text}" Style="{StaticResource WinoraChipText}" Foreground="{DynamicResource WinoraStatusNeutralForeground}" x:Name="ChipText"/>
            </Border>
            <DataTemplate.Triggers>
             <DataTrigger Binding="{Binding Emphasis}" Value="True">
              <Setter TargetName="ChipFrame" Property="Background" Value="{DynamicResource WinoraStatusWarningBackground}"/>
              <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource WinoraStatusWarningForeground}"/>
             </DataTrigger>
            </DataTemplate.Triggers>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
      </StackPanel>
     </Grid>
    </Border>
    <ItemsControl x:Name="FactCards" ItemsSource="{Binding Dashboard.Cards}" IsTabStop="False" Focusable="False">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding CardColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <Border Style="{StaticResource WinoraCardBorder}" Margin="{StaticResource WinoraSpace.R12B12}" Padding="{StaticResource WinoraSpace.A16}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="{Binding AutomationName}">
        <StackPanel>
         <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="{Binding Icon, Converter={x:Static ctl:IconKeys.Symbol}}" FontSize="24" Margin="{StaticResource WinoraSpace.R8}"/><TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Title}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level3"/></StackPanel>
         <ItemsControl ItemsSource="{Binding Lines}" IsTabStop="False" Focusable="False" Margin="{StaticResource WinoraSpace.T8}">
          <ItemsControl.ItemTemplate>
           <DataTemplate>
            <StackPanel Margin="{StaticResource WinoraSpace.B4}">
             <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Label}"/>
             <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding Value}" TextWrapping="Wrap"/>
            </StackPanel>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
       </Border>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Text[DashStorage]}" Margin="{StaticResource WinoraSpace.T4B8}" AutomationProperties.HeadingLevel="Level3"/>
    <ctl:ErrorState x:Name="DrivesFailure" Headline="{Binding Text[DashDrivesUnknown]}" ActionText="{Binding Text[TryAgain]}" ActionCommand="{Binding Dashboard.RefreshCommand}" ActionHelp="{Binding Text[DashRefreshHelp]}"
     Margin="{StaticResource WinoraSpace.T8B16}" Visibility="{Binding Dashboard.DrivesUnknown, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"/>
    <ItemsControl ItemsSource="{Binding Dashboard.Drives}" ItemTemplate="{StaticResource WinoraDriveRowTemplate}" IsTabStop="False" Focusable="False">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><ctl:DiskGridPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>
   </StackPanel>
   <!-- Inventory counts: one row of four small stats, each opening its page. -->
   <StackPanel Margin="{StaticResource WinoraSpace.B16}" AutomationProperties.Name="{Binding Text[OverviewCountsTitle]}">
    <TextBlock Style="{StaticResource WinoraSubtitle}" Text="{Binding Text[OverviewCountsTitle]}" AutomationProperties.HeadingLevel="Level2"/>
    <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Inventory.LastScannedText}" Margin="{StaticResource WinoraSpace.T2B8}" AutomationProperties.LiveSetting="Polite"/>
    <ItemsControl x:Name="StatTiles" ItemsSource="{Binding Inventory.Tiles}" IsTabStop="False" Focusable="False">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding TileColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <ui:Button Margin="{StaticResource WinoraSpace.R12B12}" Padding="{StaticResource WinoraSpace.H16V12}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
        CommandParameter="{Binding Key}" AutomationProperties.Name="{Binding AutomationName}">
        <StackPanel>
         <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="{Binding Icon, Converter={x:Static ctl:IconKeys.Symbol}}" FontSize="24" Margin="{StaticResource WinoraSpace.R8}"/><TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></StackPanel>
         <TextBlock Style="{StaticResource WinoraValue}" Margin="{StaticResource WinoraSpace.T8}" Text="{Binding CountText}"/>
         <TextBlock Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.T2}" Text="{Binding Caption}" TextWrapping="Wrap"/>
        </StackPanel>
       </ui:Button>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Style="{StaticResource WinoraCaption}" MaxWidth="640" HorizontalAlignment="Left" Text="{Binding Text[InvReadOnlyNote]}"/>
   </StackPanel>
    </StackPanel>
   </TabItem>
   <TabItem Header="{Binding Text[V2OvTabRecent]}" AutomationProperties.Name="{Binding Text[V2OvTabRecent]}">
    <StackPanel Margin="{StaticResource WinoraSpace.T16}">
   <!-- Recent changes: the shared change history block (the same as on every page), filled from the History page's journals. -->
   <StackPanel x:Name="RecentPanel" Margin="{StaticResource WinoraSpace.B16}" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}">
    <ctl:PageHistory x:Name="RecentHistory" DataContext="{Binding Recent}" Margin="{StaticResource WinoraSpace.Tn24}"/>
    <ctl:EmptyState x:Name="RecentEmpty" Icon="History24" Headline="{Binding Recent.EmptyTitle}" Message="{Binding Recent.EmptyBody}" Visibility="{Binding Recent.ShowEmpty, Converter={StaticResource BoolToVisibility}}"/>
   </StackPanel>
    </StackPanel>
   </TabItem>
   </ctl:TabBody>

   <!-- Developer simulation: debug builds only. -->
   <StackPanel x:Name="SimulationPanel" Visibility="{Binding ShowSimulation, Converter={StaticResource BoolToVisibility}}">
    <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Text[SimulationSectionTitle]}" Margin="{StaticResource WinoraSpace.T12B8}" AutomationProperties.HeadingLevel="Level2"/>
    <UniformGrid x:Name="CardGrid" Columns="{Binding CardColumns, RelativeSource={RelativeSource AncestorType=UserControl}}">
     <Border Style="{StaticResource WinoraCardBorder}" MinHeight="164" VerticalAlignment="Stretch" Margin="{StaticResource WinoraSpace.R12B12}" Padding="{StaticResource WinoraSpace.A16}" AutomationProperties.Name="{Binding Text[CardSimulationTitle]}">
      <StackPanel>
       <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Beaker24" FontSize="24" Margin="{StaticResource WinoraSpace.R8}"/><TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Text[CardSimulationTitle]}"/></StackPanel>
       <TextBlock Style="{StaticResource WinoraValue}" Margin="{StaticResource WinoraSpace.T12}" Text="{Binding ActualLabel}"/>
       <TextBlock Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.T4}" Text="{Binding Text[SimulatedSettingCaption]}"/>
       <TextBlock Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.T8}" Text="{Binding Text[CardSimulationBody]}"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource WinoraCardBorder}" MinHeight="164" VerticalAlignment="Stretch" Margin="{StaticResource WinoraSpace.R12B12}" Padding="{StaticResource WinoraSpace.A16}" AutomationProperties.Name="{Binding Text[CardLastOperation]}">
      <StackPanel>
       <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="History24" FontSize="24" Margin="{StaticResource WinoraSpace.R8}"/><TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Text[CardLastOperation]}"/></StackPanel>
       <StackPanel Visibility="{Binding HasLast, Converter={StaticResource BoolToVisibility}}" Margin="{StaticResource WinoraSpace.T12}">
        <ctl:StatusBadge StatusTone="{Binding LastTone}" Text="{Binding LastStateLabel}"/>
        <TextBlock Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.T8}" Text="{Binding LastWhen}"/>
       </StackPanel>
       <TextBlock Style="{StaticResource WinoraBodySecondary}" Margin="{StaticResource WinoraSpace.T12}" Text="{Binding Text[NoOperationsYet]}" Visibility="{Binding HasNoLast, Converter={StaticResource BoolToVisibility}}"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource WinoraCardBorder}" MinHeight="164" VerticalAlignment="Stretch" Margin="{StaticResource WinoraSpace.R12B12}" Padding="{StaticResource WinoraSpace.A16}" AutomationProperties.Name="{Binding Text[CardPlanned]}">
      <StackPanel>
       <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Clock24" FontSize="24" Margin="{StaticResource WinoraSpace.R8}"/><TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Text[CardPlanned]}"/></StackPanel>
       <TextBlock Style="{StaticResource WinoraBody}" Margin="{StaticResource WinoraSpace.T12}" Text="{Binding PlannedAreasText}"/>
       <TextBlock Style="{StaticResource WinoraCaption}" Margin="{StaticResource WinoraSpace.T8}" Text="{Binding Text[PlannedAreasBody]}"/>
      </StackPanel>
     </Border>
    </UniformGrid>
   </StackPanel>

   <Grid Margin="{StaticResource WinoraSpace.T12}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ui:SymbolIcon Symbol="Info24" FontSize="16" Margin="{StaticResource WinoraSpace.T2R8}" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    <TextBlock Grid.Column="1" Style="{StaticResource WinoraCaption}" MaxWidth="640" HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding Text[OverviewNotMeasured]}"/>
   </Grid>

   </StackPanel>
  </ctl:DashboardPage.Body>
 </ctl:DashboardPage>
</UserControl>
