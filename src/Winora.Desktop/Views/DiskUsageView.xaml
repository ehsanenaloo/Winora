<UserControl x:Class="Winora.Desktop.DiskUsageView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ctl="clr-namespace:Winora.Desktop.Controls"
 xmlns:local="clr-namespace:Winora.Desktop" xmlns:vm="clr-namespace:Winora.Desktop;assembly=Winora.Presentation"
 AutomationProperties.Name="{Binding Text[DiskUsage]}" Focusable="False">
 <UserControl.Resources>
  <!-- One file or folder on the shared inventory row. The thin bar at the start of the content is the colour of its kind in the map and the legend. -->
  <DataTemplate x:Key="ItemTemplate" DataType="{x:Type vm:DiskItemRow}">
   <ctl:InventoryRow StacksWhenNarrow="False" AutomationProperties.Name="{Binding AutomationName}">
    <ctl:InventoryRow.Lead>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border Width="4" Height="32" Background="{Binding Kind, Converter={x:Static ctl:DiskLook.KindBrushOf}}" CornerRadius="2" Margin="{StaticResource WinoraSpace.R8}"/>
      <ui:SymbolIcon Symbol="{Binding Symbol, Converter={x:Static ctl:IconKeys.Symbol}}" FontSize="20" VerticalAlignment="Center"/>
     </StackPanel>
    </ctl:InventoryRow.Lead>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/>
     <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="4" Margin="{StaticResource WinoraSpace.T4B2}" Focusable="False" IsTabStop="False"/>
     <TextBlock Style="{StaticResource WinoraCaption}" TextTrimming="CharacterEllipsis">
      <Run Text="{Binding PercentText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding FilesText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding KindText, Mode=OneWay}"/>
     </TextBlock>
    </StackPanel>
    <ctl:InventoryRow.Control><TextBlock Style="{StaticResource WinoraBody}" Text="{Binding SizeText}" VerticalAlignment="Center"/></ctl:InventoryRow.Control>
   </ctl:InventoryRow>
  </DataTemplate>
  <DataTemplate x:Key="SortTemplate" DataType="{x:Type vm:DiskSortHeader}">
   <ui:Button Command="{Binding Command}" CommandParameter="{Binding Key}" Appearance="Transparent" Padding="{StaticResource WinoraSpace.H8V4}" Margin="{StaticResource WinoraSpace.R4}" AutomationProperties.Name="{Binding AutomationName}">
    <ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Appearance" Value="Secondary"/></DataTrigger></Style.Triggers></Style></ui:Button.Style>
    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Label}"/><TextBlock Text="{Binding Arrow}" Margin="{StaticResource WinoraSpace.L4}" FontWeight="SemiBold"/></StackPanel>
   </ui:Button>
  </DataTemplate>
  <DataTemplate x:Key="LegendTemplate" DataType="{x:Type vm:LegendItem}">
   <StackPanel Orientation="Horizontal" Margin="{StaticResource WinoraSpace.R12B4}" AutomationProperties.Name="{Binding AutomationName}">
    <Border Width="16" Height="16" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource WinoraControlBorderBrush}" Margin="{StaticResource WinoraSpace.R4}" VerticalAlignment="Center" Background="{Binding Converter={x:Static ctl:DiskLook.LegendSwatchOf}}"/>
    <TextBlock Style="{StaticResource WinoraCaption}" VerticalAlignment="Center" Text="{Binding Caption}"/>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="CrumbTemplate" DataType="{x:Type vm:BreadcrumbItem}">
   <StackPanel Orientation="Horizontal">
    <TextBlock Text="{Binding DataContext.Text[BreadcrumbSeparator], RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="{StaticResource WinoraSpace.H2}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    <Button Content="{Binding Label}" Command="{Binding Navigate}" CommandParameter="{Binding Node}" Style="{StaticResource WinoraFlatPathButton}" AutomationProperties.Name="{Binding Label}"/>
   </StackPanel>
  </DataTemplate>
 </UserControl.Resources>

 <ctl:ReportPage x:Name="Workspace">
  <ctl:ReportPage.Body>
 <Grid x:Name="Root">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <!-- Location and scan controls -->
  <StackPanel Grid.Row="0">
  <ItemsControl x:Name="DiskCards" ItemsSource="{Binding Disks}" IsTabStop="False" Focusable="False" Margin="{StaticResource WinoraSpace.B8}" Visibility="{Binding HasDisks, Converter={StaticResource BoolToVisibility}}"
   AutomationProperties.Name="{Binding Text[DiskDisks]}">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><ctl:DiskGridPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate>
    <DataTemplate>
     <Button Command="{Binding ChooseCommand}" Margin="{StaticResource WinoraSpace.R12B12}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="{StaticResource WinoraSpace.None}" Cursor="Hand" AutomationProperties.Name="{Binding AutomationName}"
      AutomationProperties.HelpText="{Binding DataContext.Text[DiskCardHelp], RelativeSource={RelativeSource AncestorType=UserControl}}" FocusVisualStyle="{StaticResource WinoraFocusRect}">
      <Button.Template>
       <ControlTemplate TargetType="Button">
        <Border x:Name="Frame" CornerRadius="{StaticResource WinoraCornerRadius}" Padding="{StaticResource WinoraSpace.A16}" Background="{DynamicResource WinoraSurfaceCardBrush}" BorderBrush="{DynamicResource WinoraCardBorderBrush}" BorderThickness="1">
         <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
         <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></DataTrigger>
        </ControlTemplate.Triggers>
       </ControlTemplate>
      </Button.Template>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ui:SymbolIcon Symbol="HardDrive20" FontSize="32" Margin="{StaticResource WinoraSpace.R16}" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
       <StackPanel Grid.Column="1">
        <WrapPanel>
         <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Row.Title}" Margin="{StaticResource WinoraSpace.R8}" VerticalAlignment="Center"/>
         <ItemsControl ItemsSource="{Binding Row.Chips}" IsTabStop="False" Focusable="False" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
         <DataTemplate><ctl:StatusBadge Kind="Neutral" Text="{Binding Text}"/></DataTemplate>
        </ItemsControl.ItemTemplate>
             </ItemsControl>
        </WrapPanel>
        <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding Row.Model}" Margin="{StaticResource WinoraSpace.T2}" Visibility="{Binding Row.HasModel, Converter={StaticResource BoolToVisibility}}"/>
        <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Row.Details}" Margin="{StaticResource WinoraSpace.T2}" HorizontalAlignment="Left" Visibility="{Binding Row.HasDetails, Converter={StaticResource BoolToVisibility}}"/>
        <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding Row.UsedText}" Margin="{StaticResource WinoraSpace.T2}"/>
        <ProgressBar x:Name="UsageBar" Minimum="0" Maximum="100" Value="{Binding Row.UsedPercent, Mode=OneWay}" Height="6" Margin="{StaticResource WinoraSpace.T8}" Focusable="False" IsTabStop="False" Foreground="{DynamicResource WinoraRingGoodBrush}"/>
       </StackPanel>
      </Grid>
     </Button>
     <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Row.Band}" Value="Fair"><Setter TargetName="UsageBar" Property="Foreground" Value="{DynamicResource WinoraRingFairBrush}"/></DataTrigger>
      <DataTrigger Binding="{Binding Row.Band}" Value="Low"><Setter TargetName="UsageBar" Property="Foreground" Value="{DynamicResource WinoraRingLowBrush}"/></DataTrigger>
     </DataTemplate.Triggers>
    </DataTemplate>
   </ItemsControl.ItemTemplate>
  </ItemsControl>
  <WrapPanel Orientation="Horizontal">
   <StackPanel Margin="{StaticResource WinoraSpace.R12B8}">
    <TextBlock x:Name="LocationLabel" Style="{StaticResource WinoraCaption}" Text="{Binding Text[DiskLocation]}"/>
    <ComboBox x:Name="LocationBox" ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation, Mode=TwoWay}" DisplayMemberPath="Display" MinWidth="260"
     IsEnabled="{Binding IsNotScanning}" AutomationProperties.LabeledBy="{Binding ElementName=LocationLabel}" AutomationProperties.Name="{Binding Text[DiskLocation]}" AutomationProperties.HelpText="{Binding Text[DiskLocationHelp]}"/>
   </StackPanel>
   <ui:Button x:Name="ChooseButton" Content="{Binding Text[DiskChooseFolder]}" Command="{Binding ChooseFolderCommand}" Icon="{ui:SymbolIcon Folder24}" VerticalAlignment="Bottom" Margin="{StaticResource WinoraSpace.R8B8}"
    AutomationProperties.Name="{Binding Text[DiskChooseFolder]}" AutomationProperties.HelpText="{Binding Text[DiskChooseFolderHelp]}"/>
   <ui:ProgressRing IsIndeterminate="{Binding IsVisible, RelativeSource={RelativeSource Self}, Mode=OneWay}" Margin="{StaticResource WinoraSpace.L4R8B12}" VerticalAlignment="Bottom"
    Visibility="{Binding ShowScanRing, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding ProgressText}"/>
   <TextBlock x:Name="ProgressLine" Style="{StaticResource WinoraBodySecondary}" Text="{Binding ProgressText}" VerticalAlignment="Bottom" Margin="{StaticResource WinoraSpace.B12}" MaxWidth="520" TextTrimming="CharacterEllipsis"
    AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding ProgressText}"/>
  </WrapPanel>
  </StackPanel>

  <!-- A failed scan is the only notice that can block the page; the rest are small lines under the map -->
  <StackPanel Grid.Row="1">
   <ctl:ErrorState x:Name="FailureState" Headline="{Binding Text[DiskScanFailedTitle]}" Message="{Binding ErrorText}" ActionText="{Binding Text[TryAgain]}" ActionCommand="{Binding ScanCommand}"
    ActionHelp="{Binding Text[DiskScanHelp]}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
  </StackPanel>

  <!-- Where am I: up button, path, size of this folder -->
  <Grid Grid.Row="2" Margin="{StaticResource WinoraSpace.B8}" Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisibility}}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="UpButton" Grid.Column="0" Command="{Binding UpCommand}" Style="{StaticResource WinoraFlatPathButton}" Margin="{StaticResource WinoraSpace.R4}" VerticalAlignment="Center" ToolTip="{Binding Text[DiskUp]}"
    AutomationProperties.Name="{Binding Text[DiskUp]}" AutomationProperties.HelpText="{Binding Text[DiskUpHelp]}"><ui:SymbolIcon Symbol="ArrowUp24" FontSize="16"/></Button>
   <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" FlowDirection="LeftToRight">
    <ItemsControl x:Name="Crumbs" ItemsSource="{Binding Breadcrumbs}" ItemTemplate="{StaticResource CrumbTemplate}" IsTabStop="False" Focusable="False" AutomationProperties.Name="{Binding Text[DiskPath]}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>
   </ScrollViewer>
   <TextBlock Grid.Column="2" Style="{StaticResource WinoraBodySecondary}" Text="{Binding CurrentSummary}" VerticalAlignment="Center" Margin="{StaticResource WinoraSpace.L12}"/>
   <ListBox x:Name="ViewSwitch" Grid.Column="3" Style="{DynamicResource SegmentedList}" ItemsSource="{Binding ViewChoices}" SelectedItem="{Binding SelectedView, Mode=TwoWay}" Margin="{StaticResource WinoraSpace.L12}"
    AutomationProperties.Name="{Binding ViewName}">
    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextAlignment="Center"/></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </Grid>

  <!-- Result: the map and the list -->
  <Grid x:Name="ResultGrid" Grid.Row="3" Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisibility}}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
   <Border x:Name="MapBorder" Grid.Column="0" Visibility="{Binding ShowMap, Converter={StaticResource BoolToVisibility}}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="{StaticResource WinoraCornerRadiusSmall}" ClipToBounds="True" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
    <local:TreemapControl x:Name="Map" Node="{Binding Current}" SelectedNode="{Binding SelectedNode, Mode=TwoWay}" CellDescriber="{Binding DescribeCellFunc}" Labeler="{Binding DisplayFunc}" SizeLabeler="{Binding SizeFunc}" RestLabeler="{Binding RestFunc}" ShowPatterns="{Binding ShowPatterns}" TypeName="{Binding Text[DiskMapType]}"
     AutomationProperties.Name="{Binding MapAutomationName}" AutomationProperties.HelpText="{Binding Text[DiskMapHelp]}"/>
   </Border>
   <Grid x:Name="ListPanel">
    <Grid.Style>
     <Style TargetType="Grid">
      <Setter Property="Grid.Column" Value="2"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding ShowMap}" Value="False"><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="3"/></DataTrigger>
      </Style.Triggers>
     </Style>
    </Grid.Style>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ItemsControl x:Name="SortBar" Grid.Row="0" ItemsSource="{Binding SortHeaders}" ItemTemplate="{StaticResource SortTemplate}" IsTabStop="False" Focusable="False" Margin="{StaticResource WinoraSpace.B4}" AutomationProperties.Name="{Binding Text[DiskSortBy]}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>
    <ui:ListView x:Name="ItemList" Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" ItemTemplate="{StaticResource ItemTemplate}"
     SelectionMode="Single" SelectionChanged="OnListSelectionChanged" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding Text[DiskItems]}" AutomationProperties.HelpText="{Binding Text[DiskItemsHelp]}" PreviewKeyDown="OnListKeyDown">
     <ui:ListView.ItemContainerStyle>
      <Style TargetType="ui:ListViewItem" BasedOn="{StaticResource WinoraInventoryItem}">
       <Setter Property="ContextMenu"><Setter.Value><ContextMenu/></Setter.Value></Setter>
       <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick"/>
       <EventSetter Event="ContextMenuOpening" Handler="OnItemContextMenuOpening"/>
      </Style>
     </ui:ListView.ItemContainerStyle>
    </ui:ListView>
    <TextBlock x:Name="ListCapLine" Grid.Row="2" Style="{StaticResource WinoraCaption}" Text="{Binding ListCapText}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T4}"
     Visibility="{Binding IsListCapped, Converter={StaticResource BoolToVisibility}}"/>
   </Grid>
  </Grid>

  <!-- The first scan of a location -->
  <ctl:LoadingSkeleton x:Name="ScanningState" Grid.Row="3" VerticalAlignment="Top" Message="{Binding Text[DiscScanning]}" Visibility="{Binding ShowScanSkeleton, Converter={StaticResource BoolToVisibility}}"/>

  <!-- Before the first scan -->
  <ctl:EmptyState Grid.Row="3" VerticalAlignment="Center" Icon="DataTreemap24" Headline="{Binding Text[DiskEmptyTitle]}" Message="{Binding Text[DiskEmptyBody]}" MaxWidth="520"
   Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"/>

  <!-- Legend, totals and the selection -->
  <StackPanel Grid.Row="4" Margin="{StaticResource WinoraSpace.T8}" Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisibility}}">
   <CheckBox x:Name="PatternsBox" IsChecked="{Binding ShowPatterns, Mode=TwoWay}" Content="{Binding Text[DiskShowPatterns]}" Margin="{StaticResource WinoraSpace.B4}" Visibility="{Binding ShowMap, Converter={StaticResource BoolToVisibility}}"
    AutomationProperties.Name="{Binding Text[DiskShowPatterns]}" AutomationProperties.HelpText="{Binding Text[DiskShowPatternsHelp]}"/>
   <ItemsControl ItemsSource="{Binding Legend}" ItemTemplate="{StaticResource LegendTemplate}" IsTabStop="False" Focusable="False" AutomationProperties.Name="{Binding Text[DiskLegend]}" Visibility="{Binding ShowMap, Converter={StaticResource BoolToVisibility}}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   </ItemsControl>
   <StackPanel x:Name="InaccessibleLine" Orientation="Horizontal" Margin="{StaticResource WinoraSpace.T2}" Visibility="{Binding HasInaccessible, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding InaccessibleText}">
    <ui:SymbolIcon Symbol="Warning24" FontSize="14" Margin="{StaticResource WinoraSpace.R4}" VerticalAlignment="Center"/>
    <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding InaccessibleText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
   </StackPanel>
   <StackPanel x:Name="SkippedLine" Orientation="Horizontal" Margin="{StaticResource WinoraSpace.T2}" Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding SkippedText}">
    <ui:SymbolIcon Symbol="Info24" FontSize="14" Margin="{StaticResource WinoraSpace.R4}" VerticalAlignment="Center"/>
    <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding SkippedText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
   </StackPanel>
   <TextBlock x:Name="SelectedLine" Style="{StaticResource WinoraBody}" Text="{Binding SelectedSummary}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T4}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding SelectedSummary}"/>
   <TextBlock x:Name="StatusLine" Style="{StaticResource WinoraCaption}" Text="{Binding StatusText}" Margin="{StaticResource WinoraSpace.T2}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding StatusText}"/>
   <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding ResultSummary}" Margin="{StaticResource WinoraSpace.T2}"/>
  </StackPanel>
 </Grid>
  </ctl:ReportPage.Body>
 </ctl:ReportPage>
</UserControl>
