<UserControl x:Class="Winora.Desktop.PermissionsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ctl="clr-namespace:Winora.Desktop.Controls"
 AutomationProperties.Name="{Binding Title}" Focusable="False">
 <UserControl.CommandBindings>
  <CommandBinding Command="ApplicationCommands.Find" Executed="OnFind"/>
 </UserControl.CommandBindings>
 <!-- The shared settings page: switches are staged, the pending bar collects them and one review applies them. The quick switches stage their group and open the same review. -->
 <ctl:SettingsPageView x:Name="PageView" FooterContext="{Binding HistoryList}">
  <ctl:SettingsPageView.Header>
   <ctl:PageHeader Title="{Binding Title}" Subtitle="{Binding Text[PermIntro]}">
    <ctl:PageHeader.Actions><WrapPanel><ui:Button Margin="{StaticResource WinoraSpace.A4}" AutomationProperties.AutomationId="RefreshButton" ToolTip="{Binding Text[DiscRefresh]}" Style="{StaticResource WinoraHeaderIconButton}" Command="{Binding RefreshCommand}" Icon="{ui:SymbolIcon ArrowClockwise24}"
     AutomationProperties.Name="{Binding Text[DiscRefresh]}" AutomationProperties.HelpText="{Binding Text[PermRefreshHelp]}"/></WrapPanel></ctl:PageHeader.Actions>
   </ctl:PageHeader>
  </ctl:SettingsPageView.Header>
  <ctl:SettingsPageView.Banners>
   <StackPanel>
    <ctl:InfoBanner AutomationProperties.AutomationId="NoticeBar" IsOpen="{Binding ShowNoticeBanner, Mode=OneWay}" IsClosable="False" Severity="{Binding NoticeSeverity, Converter={x:Static ctl:BannerLook.Severity}}" Title="{Binding Text[PermResult]}" Message="{Binding Notice}"
     AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Notice}"/>
    <ctl:InfoBanner AutomationProperties.AutomationId="UndoOfferBar" IsOpen="{Binding ShowUndoOffer, Mode=OneWay}" IsClosable="False" Severity="Informational" Message="{Binding Text[PermUndoNowHelp]}">
     <ui:Button AutomationProperties.AutomationId="UndoOfferButton" Content="{Binding Text[PermUndoNow]}" Command="{Binding UndoLastCommand}" Appearance="Primary" Icon="{ui:SymbolIcon ArrowUndo24}" Margin="{StaticResource WinoraSpace.T8}" HorizontalAlignment="Left"
      AutomationProperties.Name="{Binding Text[PermUndoNow]}" AutomationProperties.HelpText="{Binding Text[PermUndoNowHelp]}"/>
    </ctl:InfoBanner>
    <!-- Quick switches: each stages the values of its group and opens the review. -->
    <ctl:CardHeader Title="{Binding Text[PermQuickHeading]}" Description="{Binding Text[PermQuickIntro]}" Margin="{StaticResource WinoraSpace.None}" Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}"/>
    <ctl:InventoryRow IsFirst="False" IsLast="False" Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding CameraMicrophoneState}">
     <ctl:InventoryRow.Lead><ui:SymbolIcon Symbol="Mic24" FontSize="24"/></ctl:InventoryRow.Lead>
     <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding CameraMicrophoneState}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
     <ctl:InventoryRow.Control>
      <ui:Button AutomationProperties.AutomationId="CameraMicrophoneButton" Style="{StaticResource WinoraRowButton}" Content="{Binding CameraMicrophoneButton}" Command="{Binding CameraMicrophoneCommand}" Appearance="Primary"
       AutomationProperties.Name="{Binding CameraMicrophoneButton}" AutomationProperties.HelpText="{Binding Text[PermQuickHelp]}"/>
     </ctl:InventoryRow.Control>
    </ctl:InventoryRow>
    <ctl:InventoryRow IsFirst="False" IsLast="True" Margin="{StaticResource WinoraSpace.B16}" Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Text[PermLockdown]}">
     <ctl:InventoryRow.Lead><ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="24"/></ctl:InventoryRow.Lead>
     <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding Text[PermLockdownHelp]}" TextWrapping="Wrap" VerticalAlignment="Center"/>
     <ctl:InventoryRow.Control>
      <ui:Button AutomationProperties.AutomationId="LockdownButton" Style="{StaticResource WinoraRowButton}" Content="{Binding Text[PermLockdown]}" Command="{Binding LockdownCommand}"
       AutomationProperties.Name="{Binding Text[PermLockdown]}" AutomationProperties.HelpText="{Binding Text[PermLockdownHelp]}"/>
     </ctl:InventoryRow.Control>
    </ctl:InventoryRow>
   </StackPanel>
  </ctl:SettingsPageView.Banners>
  <ctl:SettingsPageView.States>
   <StackPanel>
    <ctl:LoadingSkeleton AutomationProperties.AutomationId="LoadingState" Message="{Binding Text[PermLoading]}" Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}"/>
    <ctl:ErrorState AutomationProperties.AutomationId="FailureState" Headline="{Binding Text[PermLoadFailedTitle]}" Message="{Binding LoadError}" ActionText="{Binding Text[TryAgain]}" ActionCommand="{Binding RefreshCommand}"
     ActionHelp="{Binding Text[PermRefreshHelp]}" Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibility}}"/>
    <ctl:EmptyState AutomationProperties.AutomationId="EmptyListState" Icon="ShieldLock24" Headline="{Binding Text[PermEmptyTitle]}" Message="{Binding Text[PermEmpty]}" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}"/>
   </StackPanel>
  </ctl:SettingsPageView.States>
  <ctl:SettingsPageView.Footer>
   <ctl:PageHistory/>
  </ctl:SettingsPageView.Footer>
 </ctl:SettingsPageView>
</UserControl>
