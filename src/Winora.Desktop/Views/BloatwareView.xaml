<UserControl x:Class="Winora.Desktop.BloatwareView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:local="clr-namespace:Winora.Desktop" xmlns:vm="clr-namespace:Winora.Desktop;assembly=Winora.Presentation" xmlns:ctl="clr-namespace:Winora.Desktop.Controls"
 AutomationProperties.Name="{Binding Title}" Focusable="False">
 <UserControl.Resources>
  <!-- One app on the shared inventory row: tick box (none for an app Winora keeps, which carries the Managed badge), icon, name and reason, size, details. The stripe shows a ticked app. -->
  <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:BloatRow}">
   <ctl:InventoryRow x:Name="Frame" IsFirst="False" IsLast="False" IsMarked="{Binding IsSelected}" AutomationProperties.Name="{Binding AutomationName}">
    <ctl:InventoryRow.InputBindings><MouseBinding Gesture="LeftDoubleClick" Command="{Binding DetailsCommand}" CommandParameter="{Binding}"/></ctl:InventoryRow.InputBindings>
    <ctl:InventoryRow.Lead>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <CheckBox x:Name="Tick" Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" MinWidth="0" Padding="{StaticResource WinoraSpace.None}" VerticalAlignment="Center"
       Visibility="{Binding CanSelect, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.HelpText="{Binding HelpText}"/>
      <ctl:AppIcon Grid.Column="1" NameText="{Binding Title}" Source="{Binding Icon.Source}" VerticalAlignment="Center"/>
     </Grid>
    </ctl:InventoryRow.Lead>
    <StackPanel VerticalAlignment="Center">
     <WrapPanel>
      <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Title}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.R8}" VerticalAlignment="Center"/>
      <ctl:StatusBadge x:Name="Lock" Kind="Managed" Text="{Binding ProtectedText}" MaxWidth="{StaticResource WinoraLockBadgeMaxWidth}" ToolTip="{Binding ProtectedText}"
       Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}"/>
      <ctl:RiskChip Level="{Binding Risk}" Text="{Binding RiskText}" Visibility="{Binding ShowMedium, Converter={StaticResource BoolToVisibility}}"/>
     </WrapPanel>
     <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Subtitle}" FlowDirection="LeftToRight" HorizontalAlignment="Left" TextWrapping="Wrap"/>
     <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Reason}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T2}"/>
     <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding BlockText}" TextWrapping="Wrap" Visibility="{Binding HasBlock, Converter={StaticResource BoolToVisibility}}"/>
     <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding SizeText}" Margin="{StaticResource WinoraSpace.T2}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
    </StackPanel>
    <ctl:InventoryRow.Menu>
     <ctl:RowMenuButton DetailsCommand="{Binding DetailsCommand}" DetailsParameter="{Binding}" MoreName="{Binding MoreName}"
      DetailsText="{Binding DataContext.Text[RowDetails], RelativeSource={RelativeSource AncestorType=local:BloatwareView}}" MoreHelp="{Binding DataContext.Text[RowMoreDetailsHelp], RelativeSource={RelativeSource AncestorType=local:BloatwareView}}"/>
    </ctl:InventoryRow.Menu>
   </ctl:InventoryRow>
  </DataTemplate>

  <DataTemplate x:Key="GroupTemplate" DataType="{x:Type vm:BloatGroup}">
   <StackPanel Margin="{StaticResource WinoraSpace.None}" AutomationProperties.Name="{Binding AutomationName}">
    <ctl:CardHeader Title="{Binding Heading}" Description="{Binding Description}" Margin="{StaticResource WinoraSpace.T8}">
     <ctl:CardHeader.Actions>
      <ui:Button Content="{Binding SelectLabel}" Command="{Binding SelectCommand}" Appearance="Transparent" Visibility="{Binding CanSelectAll, Converter={StaticResource BoolToVisibility}}"
       ctl:A11y.Label="{Binding SelectLabel}" ctl:A11y.Item="{Binding Heading}"/>
     </ctl:CardHeader.Actions>
    </ctl:CardHeader>
    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" IsTabStop="False" Focusable="False"/>
    <Border Style="{StaticResource WinoraCardCap}"/>
   </StackPanel>
  </DataTemplate>

  <!-- One removed app on the shared inventory row: icon, name, how it comes back, Restore and the Store page. -->
  <DataTemplate x:Key="RemovedTemplate" DataType="{x:Type vm:RemovedAppRow}">
   <ctl:InventoryRow Style="{StaticResource WinoraInventoryRowGap}" AutomationProperties.Name="{Binding AutomationName}">
    <ctl:InventoryRow.Lead><ctl:AppIcon NameText="{Binding Title}" Source="{Binding Icon.Source}" VerticalAlignment="Center"/></ctl:InventoryRow.Lead>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Title}" TextWrapping="Wrap"/>
      <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Subtitle}" FlowDirection="LeftToRight" HorizontalAlignment="Left" TextWrapping="Wrap"/>
      <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding HowText}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T2}"/>
      <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding When}" TextWrapping="Wrap"/>
     </StackPanel>
    <ctl:InventoryRow.Control>
     <StackPanel VerticalAlignment="Center">
      <ui:Button Style="{StaticResource WinoraRowButton}" Content="{Binding RestoreLabel}" Command="{Binding RestoreCommand}" CommandParameter="{Binding}"
       Visibility="{Binding CanRestore, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding RestoreName}"
       AutomationProperties.HelpText="{Binding DataContext.Text[V2BlRestoreHelp], RelativeSource={RelativeSource AncestorType=UserControl}}"/>
      <ui:Button Style="{StaticResource WinoraRowButton}" Content="{Binding StoreLabel}" Command="{Binding OpenStoreCommand}" CommandParameter="{Binding}" Margin="{StaticResource WinoraSpace.T4}"
       Visibility="{Binding CanOpenStore, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding StoreName}"
       AutomationProperties.HelpText="{Binding DataContext.Text[V2BlOpenStoreHelp], RelativeSource={RelativeSource AncestorType=UserControl}}"/>
     </StackPanel>
    </ctl:InventoryRow.Control>
   </ctl:InventoryRow>
  </DataTemplate>
 </UserControl.Resources>

 <ctl:ListPage x:Name="Workspace">
  <ctl:ListPage.Header>
   <ctl:PageHeader Title="{Binding Title}" Subtitle="{Binding Text[BloatIntro]}">
     <ctl:PageHeader.Actions><WrapPanel><ui:Button Margin="{StaticResource WinoraSpace.A4}" x:Name="RefreshButton" ToolTip="{Binding Text[DiscRefresh]}" Style="{StaticResource WinoraHeaderIconButton}" Command="{Binding RefreshCommand}" Icon="{ui:SymbolIcon ArrowClockwise24}"
      AutomationProperties.Name="{Binding Text[DiscRefresh]}" AutomationProperties.HelpText="{Binding Text[BloatRefreshHelp]}"/></WrapPanel></ctl:PageHeader.Actions>
    </ctl:PageHeader>
  </ctl:ListPage.Header>
  <ctl:ListPage.Tabs>
   <ctl:TabRail x:Name="Rail" ContentTabs="{Binding ElementName=Tabs}" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Text[V2BlTabsHelp]}"/>
  </ctl:ListPage.Tabs>
  <ctl:ListPage.Toolbar>
        <!-- The one toolbar: search and the class and scope filters. -->
        <ctl:FilterBar x:Name="Toolbar" Visibility="{Binding SelectedIndex, ElementName=Tabs, Converter={x:Static ctl:IndexVisibility.First}}" GroupName="{Binding Text[FbGroup]}"
         SearchText="{Binding SearchText, Mode=TwoWay}" SearchLabel="{Binding Text[DiscSearchLabel]}" SearchPlaceholder="{Binding Text[BloatSearch]}" SearchHelp="{Binding Text[BloatSearchHelp]}"
         HasFilters="True" FiltersText="{Binding FiltersText}" FiltersHelp="{Binding Text[DiscFiltersHelp]}" FiltersOpen="{Binding FiltersOpen, Mode=TwoWay}"
         ClearCommand="{Binding ClearFiltersCommand}" ClearText="{Binding Text[DiscClearFilters]}" ClearHelp="{Binding Text[DiscClearFiltersHelp]}" ShowClear="{Binding HasActiveFilter}"
         CountText="{Binding CountText}" ShowCount="True">
         <ctl:FilterBar.PanelContent>
          <WrapPanel>
           <StackPanel Margin="{StaticResource WinoraSpace.R12B8}">
            <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Text[BloatFilterClass]}"/>
            <ComboBox ItemsSource="{Binding ClassFilters}" SelectedItem="{Binding SelectedClassFilter, Mode=TwoWay}" DisplayMemberPath="Label" MinWidth="160"
             AutomationProperties.Name="{Binding Text[BloatFilterClass]}" AutomationProperties.HelpText="{Binding Text[BloatFilterClassHelp]}"/>
           </StackPanel>
           <StackPanel Margin="{StaticResource WinoraSpace.R12B8}">
            <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Text[BloatFilterScope]}"/>
            <ComboBox ItemsSource="{Binding ScopeFilters}" SelectedItem="{Binding SelectedScopeFilter, Mode=TwoWay}" DisplayMemberPath="Label" MinWidth="160"
             AutomationProperties.Name="{Binding Text[BloatFilterScope]}" AutomationProperties.HelpText="{Binding Text[BloatFilterScopeHelp]}"/>
           </StackPanel>
          </WrapPanel>
         </ctl:FilterBar.PanelContent>
        </ctl:FilterBar>
  </ctl:ListPage.Toolbar>
  <ctl:ListPage.Banners>
   <StackPanel>
    <ctl:AdminNotice IsOpen="{Binding ShowNeedsAdministrator, Mode=OneWay}" Title="{Binding NeedsAdministratorTitle}" Message="{Binding NeedsAdministratorText, Mode=OneWay}" ShowLink="{Binding ShowAdminHowTo}" LinkText="{Binding Text[AdminNoticeLink]}" LinkHelp="{Binding Text[AdminNoticeLinkHelp]}"/>
    <ctl:InfoBanner IsOpen="{Binding ShowPartial, Mode=OneWay}" IsClosable="False" Severity="Warning" Title="{Binding Text[BloatPartialTitle]}" Message="{Binding Text[BloatPartialBody]}" AutomationProperties.Name="{Binding Text[BloatPartialTitle]}"/>
    <ctl:InfoBanner IsOpen="{Binding ShowProvisionedUnknown, Mode=OneWay}" IsClosable="False" Severity="Informational" Title="{Binding Text[BloatProvisionedUnknownTitle]}" Message="{Binding Text[BloatProvisionedUnknownBody]}" AutomationProperties.Name="{Binding Text[BloatProvisionedUnknownTitle]}"/>
    <ctl:InfoBanner x:Name="NoticeBar" IsOpen="{Binding ShowNoticeBanner, Mode=OneWay}" IsClosable="False" Severity="Warning" Title="{Binding Text[BloatResult]}" Message="{Binding Notice}"
     AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Notice}"/>
    <ctl:InfoBanner IsOpen="True" IsClosable="False" Severity="Informational" Title="{Binding Text[V2BlRestoreBannerTitle]}" Message="{Binding Text[V2BlRestoreBannerBody]}" AutomationProperties.Name="{Binding Text[V2BlRestoreBannerTitle]}"/>

    <!-- Page states: the first read, or a read that failed -->
    <ctl:LoadingSkeleton x:Name="LoadingState" Message="{Binding Text[BloatLoading]}" Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}"/>
    <ctl:ErrorState x:Name="FailureState" Headline="{Binding Text[BloatLoadFailedTitle]}" Message="{Binding LoadError}" ActionText="{Binding Text[TryAgain]}" ActionCommand="{Binding RefreshCommand}"
     ActionHelp="{Binding Text[BloatRefreshHelp]}" Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibility}}"/>

    <!-- Report of the last removal -->
    <ctl:ResultReport x:Name="ReportPanel" Model="{Binding Report}" Margin="{StaticResource WinoraSpace.T12}" Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}"/>

    
   </StackPanel>
  </ctl:ListPage.Banners>
  <ctl:ListPage.Body>
   <ctl:TabBody x:Name="Tabs" Style="{StaticResource WinoraTabContentStyle}" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
     <TabItem Header="{Binding AppsTabTitle}" AutomationProperties.Name="{Binding AppsTabTitle}">
      <StackPanel>


        <!-- Selection: each group header has its own "Select all"; this clears the ticks of every group. -->
        <WrapPanel Margin="{StaticResource WinoraSpace.T4}">
         <ui:Button x:Name="ClearButton" Content="{Binding Text[BloatClear]}" Command="{Binding ClearCommand}" Icon="{ui:SymbolIcon Dismiss24}" Margin="{StaticResource WinoraSpace.R8B8}"
          AutomationProperties.Name="{Binding Text[BloatClear]}" AutomationProperties.HelpText="{Binding Text[BloatClearHelp]}"/>
        </WrapPanel>
        <!-- Packages -->
        <ctl:EmptyState x:Name="NoMatchesState" Icon="Search24" Headline="{Binding Text[DiscNoMatchesTitle]}" Message="{Binding Text[BloatEmpty]}" ActionText="{Binding Text[DiscClearFilters]}" ActionCommand="{Binding ClearFiltersCommand}"
         ActionHelp="{Binding Text[DiscClearFiltersHelp]}" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}"/>
        <ItemsControl x:Name="GroupList" ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupTemplate}" IsTabStop="False" Focusable="False" AutomationProperties.Name="{Binding Text[BloatPackages]}"/>

        <ctl:PageHistory DataContext="{Binding HistoryList}"/>
      </StackPanel>
     </TabItem>
     <TabItem Header="{Binding RemovedTabTitle}" AutomationProperties.Name="{Binding RemovedTabTitle}">
      <StackPanel Margin="{StaticResource WinoraSpace.T12}">
       <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding Text[V2BlRemovedIntro]}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.B8}"/>
       <ctl:EmptyState x:Name="NoRemovedState" Icon="ArrowUndo24" Headline="{Binding Text[V2BlNoRemovedTitle]}" Message="{Binding Text[V2BlNoRemoved]}" Visibility="{Binding ShowNoRemoved, Converter={StaticResource BoolToVisibility}}"/>
       <ItemsControl ItemsSource="{Binding RemovedApps}" ItemTemplate="{StaticResource RemovedTemplate}" IsTabStop="False" Focusable="False" AutomationProperties.Name="{Binding RemovedTabTitle}"
        Visibility="{Binding HasRemoved, Converter={StaticResource BoolToVisibility}}"/>
      </StackPanel>
     </TabItem>
    </ctl:TabBody>
  </ctl:ListPage.Body>
 </ctl:ListPage>
</UserControl>
