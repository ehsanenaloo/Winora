<UserControl x:Class="Winora.Desktop.ToolsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ctl="clr-namespace:Winora.Desktop.Controls"
 xmlns:local="clr-namespace:Winora.Desktop" xmlns:vm="clr-namespace:Winora.Desktop;assembly=Winora.Presentation"
 AutomationProperties.Name="{Binding Title}" Focusable="False">
 <UserControl.Resources>
  <!-- One repair tool on the shared row: an icon for what the tool works on (top aligned, as the card is tall), what it does and its facts, the badges, the exact command on request, and one Run button as the control. -->
  <DataTemplate x:Key="ToolTemplate" DataType="{x:Type vm:RepairToolRow}">
   <ctl:InventoryRow Style="{StaticResource WinoraInventoryRowGap}" VerticalContentAlignment="Top" AutomationProperties.Name="{Binding AutomationName}">
    <ctl:InventoryRow.Lead><ui:SymbolIcon Symbol="{Binding Icon, Converter={x:Static ctl:IconKeys.Symbol}}" FontSize="24"/></ctl:InventoryRow.Lead>
    <StackPanel>
     <WrapPanel>
      <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Title}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.R8}" VerticalAlignment="Center"/>
      <ctl:StatusBadge Kind="Warning" Text="{Binding RiskText}" Margin="{StaticResource WinoraSpace.R4}" VerticalAlignment="Center" Visibility="{Binding IsMediumRisk, Converter={StaticResource BoolToVisibility}}"/>
      <ctl:StatusBadge x:Name="ToolState" StatusTone="{Binding StateTone}" Text="{Binding StateText}" VerticalAlignment="Center" Visibility="{Binding HasState, Converter={StaticResource BoolToVisibility}}"/>
     </WrapPanel>
     <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding Description}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T4}"/>
     <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding ChangesText}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T4}"/>
     <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding MetaText}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T8}"/>
     <StackPanel Margin="{StaticResource WinoraSpace.T8}" Visibility="{Binding NeedsVolume, Converter={StaticResource BoolToVisibility}}">
      <TextBlock x:Name="VolumeLabel" Style="{StaticResource WinoraCaption}" Text="{Binding VolumeLabel}"/>
      <ComboBox ItemsSource="{Binding Volumes}" SelectedItem="{Binding SelectedVolume, Mode=TwoWay}" FlowDirection="LeftToRight" MinWidth="120" MinHeight="36" HorizontalAlignment="Left"
       AutomationProperties.LabeledBy="{Binding ElementName=VolumeLabel}" AutomationProperties.Name="{Binding VolumeLabel}" AutomationProperties.HelpText="{Binding VolumeHelp}"/>
     </StackPanel>
     <ctl:ChevronToggle x:Name="CommandToggle" IsChecked="{Binding IsCommandShown, Mode=TwoWay}" Content="{Binding DataContext.Text[V2MaToolCommand], RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Left" Margin="{StaticResource WinoraSpace.Ln8T4}"
      Visibility="{Binding HasCommand, Converter={StaticResource BoolToVisibility}}" ctl:A11y.Label="{Binding DataContext.Text[V2MaToolCommand], RelativeSource={RelativeSource AncestorType=UserControl}}" ctl:A11y.Item="{Binding Title}" AutomationProperties.HelpText="{Binding DataContext.Text[V2MaToolCommandHelp], RelativeSource={RelativeSource AncestorType=UserControl}}"/>
     <Border x:Name="CommandBox" Margin="{StaticResource WinoraSpace.T4}" Padding="{StaticResource WinoraSpace.H12V8}" CornerRadius="{DynamicResource WinoraCornerRadius}" Background="{DynamicResource WinoraSurfaceSunkenBrush}" Visibility="{Binding IsCommandShown, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
       <TextBox Text="{Binding CommandText, Mode=OneWay}" Style="{StaticResource WinoraSelectableText}" FlowDirection="LeftToRight" FontFamily="{StaticResource WinoraMonoFontFamily}" FontSize="{StaticResource WinoraFontSizeCaption}" TextWrapping="Wrap" HorizontalAlignment="Stretch"
        AutomationProperties.Name="{Binding DataContext.Text[V2MaToolCommand], RelativeSource={RelativeSource AncestorType=UserControl}}"/>
       <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding DataContext.Text[V2MaToolCommandNote], RelativeSource={RelativeSource AncestorType=UserControl}}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T4}"/>
      </StackPanel>
     </Border>
    </StackPanel>
    <ctl:InventoryRow.Control>
     <ui:Button Style="{StaticResource WinoraRowButton}" Content="{Binding DataContext.Text[ToolsRun], RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding RunCommand}" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" VerticalAlignment="Top"
      ctl:A11y.Label="{Binding DataContext.Text[ToolsRun], RelativeSource={RelativeSource AncestorType=UserControl}}" ctl:A11y.Item="{Binding Title}" AutomationProperties.HelpText="{Binding DataContext.Text[ToolsRunHelp], RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </ctl:InventoryRow.Control>
   </ctl:InventoryRow>
  </DataTemplate>

  <!-- One optional feature on the shared row: letter avatar, name, state and source, and Turn on or Turn off as the control. -->
  <DataTemplate x:Key="FeatureTemplate" DataType="{x:Type vm:FeatureRow}">
   <ctl:InventoryRow Style="{StaticResource WinoraInventoryRowGap}" AutomationProperties.Name="{Binding AutomationName}">
    <ctl:InventoryRow.Lead><ctl:AvatarBadge NameText="{Binding Title}" Size="32" VerticalAlignment="Top"/></ctl:InventoryRow.Lead>
    <StackPanel VerticalAlignment="Center">
     <WrapPanel>
      <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Title}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.R8}" VerticalAlignment="Center"/>
      <ctl:StatusBadge Kind="Warning" Text="{Binding CautionText}" VerticalAlignment="Center" Visibility="{Binding IsCaution, Converter={StaticResource BoolToVisibility}}"/>
     </WrapPanel>
     <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding Description}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T4}" Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}"/>
     <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding MetaText}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T4}"/>
     <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding SourceText}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T2}" Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}"/>
     <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding RestartText}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T4}" Visibility="{Binding HasRestart, Converter={StaticResource BoolToVisibility}}"/>
     <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding ReadOnlyText}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.T4}" Visibility="{Binding HasReadOnly, Converter={StaticResource BoolToVisibility}}"/>
    </StackPanel>
    <ctl:InventoryRow.Control>
     <StackPanel VerticalAlignment="Top">
      <ui:Button Style="{StaticResource WinoraRowButton}" Content="{Binding EnableLabel}" Command="{Binding EnableCommand}" Visibility="{Binding ShowEnable, Converter={StaticResource BoolToVisibility}}"
       AutomationProperties.Name="{Binding EnableName}" AutomationProperties.HelpText="{Binding EnableHelp}"/>
      <ui:Button Style="{StaticResource WinoraRowButton}" Content="{Binding DisableLabel}" Command="{Binding DisableCommand}" Visibility="{Binding ShowDisable, Converter={StaticResource BoolToVisibility}}"
       AutomationProperties.Name="{Binding DisableName}" AutomationProperties.HelpText="{Binding DisableHelp}"/>
     </StackPanel>
    </ctl:InventoryRow.Control>
   </ctl:InventoryRow>
  </DataTemplate>

 </UserControl.Resources>

 <ctl:ToolPage x:Name="Workspace">
  <ctl:ToolPage.Header>
   <ctl:PageHeader Title="{Binding Title}" Subtitle="{Binding Text[ToolsIntro]}"/>
  </ctl:ToolPage.Header>
  <ctl:ToolPage.Tabs>
   <ctl:TabRail x:Name="Rail" ContentTabs="{Binding ElementName=Tabs}" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Text[V2PaTabsHelp]}" Visibility="{Binding Visibility, ElementName=Tabs}"/>
  </ctl:ToolPage.Tabs>
  <ctl:ToolPage.Toolbar>
   <!-- The feature tab: Load or Refresh, then the shared search with its count line. -->
   <ctl:FilterBar x:Name="FeatureToolbar" GroupName="{Binding Text[FbGroup]}" Visibility="{Binding SelectedTab, Converter={x:Static ctl:IndexVisibility.Second}}"
    SearchText="{Binding FeatureFilter, Mode=TwoWay}" SearchLabel="{Binding Text[ToolsFeatFilterLabel]}" SearchPlaceholder="{Binding Text[ToolsFeatFilterLabel]}" SearchHelp="{Binding Text[ToolsFeatFilterHelp]}"
    ClearCommand="{Binding ClearFeatureFilterCommand}" ClearText="{Binding Text[ToolsFeatClearFilter]}" ClearHelp="{Binding Text[ToolsFeatClearFilterHelp]}" ShowClear="{Binding HasFeatureFilter}"
    CountText="{Binding FeatureCountText}" ShowCount="{Binding FeaturesLoaded}">
    <ctl:FilterBar.ExtraContent>
     <ui:Button AutomationProperties.AutomationId="LoadButton" Content="{Binding LoadFeaturesLabel}" Command="{Binding LoadFeaturesCommand}" Icon="{ui:SymbolIcon ArrowClockwise24}" MinHeight="36" VerticalAlignment="Bottom"
      AutomationProperties.Name="{Binding LoadFeaturesLabel}" AutomationProperties.HelpText="{Binding Text[ToolsFeatLoadHelp]}"/>
    </ctl:FilterBar.ExtraContent>
   </ctl:FilterBar>
  </ctl:ToolPage.Toolbar>
  <ctl:ToolPage.Banners>
   <StackPanel>
    <ctl:AdminNotice IsOpen="{Binding ShowNeedsAdministrator, Mode=OneWay}" Title="{Binding NeedsAdministratorTitle}" Message="{Binding NeedsAdministratorText, Mode=OneWay}" ShowLink="{Binding ShowAdminHowTo}" LinkText="{Binding Text[AdminNoticeLink]}" LinkHelp="{Binding Text[AdminNoticeLinkHelp]}"/>
    <!-- A run past its usual time: how long it has run, the limit, and Stop. Winora never ends the program because of the time. -->
    <ctl:InfoBanner x:Name="StillRunningBar" IsOpen="{Binding ShowStillRunning, Mode=OneWay}" IsClosable="False" Severity="Informational" Title="{Binding Text[ToolsStillRunningTitle]}" Message="{Binding StillRunningText}"
     AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Text[ToolsStillRunningTitle]}">
     <ui:Button x:Name="StillRunningStop" Content="{Binding Text[ToolsStillRunningStop]}" Command="{Binding CancelCommand}" Icon="{ui:SymbolIcon Stop24}" Margin="{StaticResource WinoraSpace.T8}" HorizontalAlignment="Left"
      AutomationProperties.Name="{Binding Text[ToolsStillRunningStop]}" AutomationProperties.HelpText="{Binding Text[ToolsStillRunningStopHelp]}"/>
    </ctl:InfoBanner>
    <ctl:InfoBanner Kind="RestartNeeded" x:Name="RestartBar" IsOpen="{Binding ShowRestartBanner, Mode=OneWay}" IsClosable="False" Severity="Warning" Title="{Binding Text[ToolsRestartBannerTitle]}" Message="{Binding Text[ToolsRestartBannerBody]}"
     AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Text[ToolsRestartBannerBody]}"/>
    <ctl:InfoBanner x:Name="NoticeBar" IsOpen="{Binding ShowNoticeBanner, Mode=OneWay}" IsClosable="False" Severity="{Binding NoticeSeverity, Converter={x:Static ctl:BannerLook.Severity}}" Title="{Binding Text[ToolsResultHeading]}" Message="{Binding Notice}"
     AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Notice}"/>

    <!-- Last result: tone and title first; the log opens on request. -->
    <Border x:Name="ResultPanel" Style="{StaticResource WinoraCardBorder}" Margin="{StaticResource WinoraSpace.B8}"
     Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisibility}}">
     <StackPanel>
      <WrapPanel>
       <ctl:StatusBadge StatusTone="{Binding ResultTone}" Text="{Binding ResultBadgeText}" Margin="{StaticResource WinoraSpace.R8}" VerticalAlignment="Center"/>
       <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding ResultTitle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </WrapPanel>
      <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding ResultSummary}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.V4}"/>
      <ctl:ChevronToggle x:Name="LogToggle" IsChecked="{Binding ResultExpanded, Mode=TwoWay}" Content="{Binding Text[ToolsLogLabel]}" HorizontalAlignment="Left" Margin="{StaticResource WinoraSpace.Ln8}"/>
      <StackPanel Visibility="{Binding ResultExpanded, Converter={StaticResource BoolToVisibility}}">
       <TextBox x:Name="LogBox" Text="{Binding ResultLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="260" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" FontFamily="{StaticResource WinoraMonoFontFamily}" FontSize="{StaticResource WinoraFontSizeCaption}"
        AutomationProperties.Name="{Binding Text[ToolsLogLabel]}" AutomationProperties.HelpText="{Binding Text[ToolsCopyLogHelp]}"/>
      </StackPanel>
      <ui:Button x:Name="CopyButton" Content="{Binding Text[ToolsCopyLog]}" Command="{Binding CopyLogCommand}" Margin="{StaticResource WinoraSpace.T8}" MinHeight="36" HorizontalAlignment="Left" Icon="{ui:SymbolIcon Copy24}"
       AutomationProperties.Name="{Binding Text[ToolsCopyLog]}" AutomationProperties.HelpText="{Binding Text[ToolsCopyLogHelp]}"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ctl:ToolPage.Banners>
  <ctl:ToolPage.Body>
   <ctl:TabBody x:Name="Tabs" Style="{StaticResource WinoraTabContentStyle}" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
     <TabItem Header="{Binding Text[ToolsRepairHeading]}" AutomationProperties.Name="{Binding Text[ToolsRepairHeading]}">
      <StackPanel Margin="{StaticResource WinoraSpace.T16}">
       <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding Text[ToolsRepairIntro]}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.B8}"/>
       <ItemsControl x:Name="ToolList" ItemsSource="{Binding Tools}" ItemTemplate="{StaticResource ToolTemplate}" IsTabStop="False" Focusable="False" AutomationProperties.Name="{Binding Text[ToolsRepairHeading]}"/>
      </StackPanel>
     </TabItem>
     <TabItem Header="{Binding Text[ToolsFeaturesHeading]}" AutomationProperties.Name="{Binding Text[ToolsFeaturesHeading]}">
      <StackPanel Margin="{StaticResource WinoraSpace.T16}">
       <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{Binding Text[ToolsFeaturesIntro]}" TextWrapping="Wrap" Margin="{StaticResource WinoraSpace.B8}"/>
       <!-- The list states: not read yet (Load in the toolbar starts the read), reading, failed, none at all, none for the search. -->
       <ctl:EmptyState x:Name="NotLoadedState" Icon="Toolbox24" Headline="{Binding Text[ToolsFeatNotLoaded]}" Message="{Binding Text[ToolsFeatLoadHelp]}" Visibility="{Binding ShowFeaturesHint, Converter={StaticResource BoolToVisibility}}"/>
       <ctl:LoadingSkeleton x:Name="LoadingState" Message="{Binding Text[ToolsFeatLoading]}" Visibility="{Binding ShowFeaturesLoading, Converter={StaticResource BoolToVisibility}}"/>
       <ctl:ErrorState x:Name="FailureState" Headline="{Binding LoadError}" Message="{Binding Text[ToolsFeatLoadFailedBody]}" ActionText="{Binding Text[TryAgain]}" ActionCommand="{Binding LoadFeaturesCommand}"
        ActionHelp="{Binding Text[ToolsFeatLoadHelp]}" Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibility}}"/>
       <ctl:EmptyState x:Name="EmptyListState" Icon="Toolbox24" Headline="{Binding Text[ToolsFeatNoneTitle]}" Message="{Binding Text[ToolsFeatNoneBody]}" Visibility="{Binding ShowNoFeatures, Converter={StaticResource BoolToVisibility}}"/>
       <ctl:EmptyState x:Name="NoMatchesState" Icon="Search24" Headline="{Binding Text[DiscNoMatchesTitle]}" Message="{Binding Text[ToolsFeatEmpty]}" ActionText="{Binding Text[ToolsFeatClearFilter]}" ActionCommand="{Binding ClearFeatureFilterCommand}"
        ActionHelp="{Binding Text[ToolsFeatClearFilterHelp]}" Visibility="{Binding ShowFeatureNoMatches, Converter={StaticResource BoolToVisibility}}"/>
       <ItemsControl x:Name="FeatureList" ItemsSource="{Binding Features}" ItemTemplate="{StaticResource FeatureTemplate}" IsTabStop="False" Focusable="False" AutomationProperties.Name="{Binding Text[ToolsFeatListName]}"/>
      </StackPanel>
     </TabItem>
    </ctl:TabBody>
  </ctl:ToolPage.Body>
  <ctl:ToolPage.Footer>
    <ctl:PageHistory DataContext="{Binding HistoryList}"/>
  </ctl:ToolPage.Footer>
 </ctl:ToolPage>
</UserControl>
