<!-- Overview, History and Settings of the v2 design: the hero card, whole-row action cards, filter chips and the history rows. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ctl="clr-namespace:Winora.Desktop.Controls">
 <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="Tokens.xaml"/>
  <ResourceDictionary Source="Theme.xaml"/>
 </ResourceDictionary.MergedDictionaries>

 <!-- A plain card surface. -->
 <Style x:Key="WinoraSurfaceCard" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource WinoraSurfaceCardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WinoraCardBorderBrush}"/>
  <Setter Property="BorderThickness" Value="{StaticResource WinoraBorderThickness}"/><Setter Property="CornerRadius" Value="{StaticResource WinoraCornerRadius}"/><Setter Property="Padding" Value="16"/>
 </Style>

 <!-- A whole-row action: the button fills the card, so the icon, the text and the chevron are one target. -->
 <Style x:Key="WinoraCardActionButton" TargetType="Button">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,12"/><Setter Property="MinHeight" Value="{StaticResource MinHitTarget}"/>
  <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="{StaticResource WinoraCornerRadius}" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- A path part or the up arrow on Disk usage: plain text with no frame; a light fill shows on hover. -->
 <Style x:Key="WinoraFlatPathButton" TargetType="Button" BasedOn="{StaticResource WinoraCardActionButton}">
  <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="32"/><Setter Property="MinWidth" Value="32"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/>
 </Style>

 <!-- Filter chips: a pill per choice in a list box, so the arrow keys move the selection and the selected chip is announced. -->
 <!-- A single-choice chip: the same pill as the filter chips of the lists (WinoraFilterChipItem): accent fill and a check mark when selected. -->
 <Style x:Key="WinoraChipListItem" TargetType="ListBoxItem">
  <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="MinHeight" Value="{DynamicResource MinHitTarget}"/>
  <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/><Setter Property="FocusVisualStyle" Value="{DynamicResource WinoraFocusRect}"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
   <Border x:Name="Pill" Background="{DynamicResource WinoraSurfaceCardBrush}" BorderBrush="{DynamicResource WinoraCardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12,0" MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <ui:SymbolIcon x:Name="Mark" Symbol="Checkmark16" FontSize="14" Margin="0,0,4,0" Visibility="Collapsed" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
     <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="14"/>
    </StackPanel>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
    <Trigger Property="IsSelected" Value="True">
     <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
     <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
     <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
     <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
    </Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="WinoraChipList" TargetType="ListBox">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalAlignment" Value="Left"/>
  <Setter Property="ItemContainerStyle" Value="{StaticResource WinoraChipListItem}"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="KeyboardNavigation.TabNavigation" Value="Once"/>
  <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
  <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value></Setter>
  <Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
