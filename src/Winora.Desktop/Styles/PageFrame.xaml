<!-- Page frame styles: page header, info banner, empty state, error state and loading skeleton. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ctl="clr-namespace:Winora.Desktop.Controls">
 <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="Tokens.xaml"/>
  <ResourceDictionary Source="Theme.xaml"/>
 </ResourceDictionary.MergedDictionaries>

 <!-- Page header: the Level 1 title is a focusable text block (the page heading that takes keyboard focus after navigation). -->
 <Style x:Key="WinoraPageHeaderTitle" TargetType="TextBlock" BasedOn="{StaticResource WinoraPageHeading}">
  <Setter Property="FontSize" Value="24"/><Setter Property="LineHeight" Value="{DynamicResource WinoraLineValue}"/>
 </Style>
 <Style x:Key="WinoraPageHeaderMeta" TargetType="TextBlock" BasedOn="{StaticResource WinoraCaption}"><Setter Property="Foreground" Value="{DynamicResource WinoraTextTertiaryBrush}"/></Style>
 <!-- Refresh in the page header: an icon button, the name stays in the tooltip and the accessible name. -->
 <Style x:Key="WinoraHeaderIconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
  <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="36"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="0"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
 </Style>
 <!-- The "About this page" disclosure under the subtitle: icon and words, accent text, no button chrome. -->
 <Style x:Key="WinoraAboutToggle" TargetType="ToggleButton">
  <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0,4,8,4"/>
  <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
   <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="{StaticResource WinoraCornerRadius}" Padding="{TemplateBinding Padding}">
    <ContentPresenter VerticalAlignment="Center"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource WinoraFocusBrush}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- Page header: breadcrumb and status line on top, the page icon in a tile, the title (the Level 1 heading that takes keyboard focus after navigation), one sentence and the actions. -->
 <Style x:Key="WinoraPageHeaderStyle" TargetType="ctl:PageHeader">
  <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Margin" Value="0,0,0,16"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ctl:PageHeader">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid Grid.ColumnSpan="3" Margin="0,0,0,8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="PART_Breadcrumb" Style="{StaticResource WinoraCaption}" Text="{TemplateBinding Breadcrumb}" Foreground="{DynamicResource WinoraTextTertiaryBrush}"/>
     <TextBlock x:Name="PART_Meta" Grid.Column="1" Style="{StaticResource WinoraPageHeaderMeta}" Text="{TemplateBinding MetaText}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" MaxWidth="480" Margin="16,0,0,0"/>
    </Grid>
    <!-- 40 px tile at the top of the title block, pulled up 4 px so its middle meets the middle of the title line. -->
    <Border x:Name="PART_IconTile" Grid.Row="1" Width="{StaticResource WinoraSpace10}" Height="{StaticResource WinoraSpace10}" CornerRadius="{StaticResource WinoraCornerRadius}" Background="{DynamicResource WinoraChangedByWinoraBrush}" VerticalAlignment="Top" Margin="0,-4,12,0">
     <ui:SymbolIcon Symbol="{TemplateBinding Icon}" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top">
     <TextBlock x:Name="PART_Title" Style="{StaticResource WinoraPageHeaderTitle}" Text="{TemplateBinding Title}"/>
     <TextBlock x:Name="PART_Subtitle" Style="{StaticResource WinoraBodySecondary}" Text="{TemplateBinding SummaryText}" MaxWidth="{StaticResource WinoraProseMaxWidth}" HorizontalAlignment="Left" Margin="0,2,0,0"/>
     <ToggleButton x:Name="PART_About" Style="{StaticResource WinoraAboutToggle}" IsChecked="{Binding IsAboutOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
      AutomationProperties.Name="{TemplateBinding AboutLabel}" AutomationProperties.HelpText="{TemplateBinding AboutHelp}">
      <StackPanel Orientation="Horizontal">
       <ui:SymbolIcon Symbol="Info16" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
       <TextBlock Text="{TemplateBinding AboutLabel}" Style="{StaticResource WinoraCaption}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" VerticalAlignment="Center"/>
      </StackPanel>
     </ToggleButton>
     <TextBlock x:Name="PART_AboutText" Style="{StaticResource WinoraBodySecondary}" Text="{TemplateBinding AboutText}" MaxWidth="{StaticResource WinoraProseMaxWidth}" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="Collapsed"/>
    </StackPanel>
    <!-- The actions sit at the top like the icon tile, so they stay beside the title when the subtitle or the about text is long. -->
    <ContentPresenter x:Name="PART_Actions" Grid.Row="1" Grid.Column="2" Content="{TemplateBinding Actions}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="16,-4,0,0"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="HasIcon" Value="False"><Setter TargetName="PART_IconTile" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="HasSubtitle" Value="False"><Setter TargetName="PART_Subtitle" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="HasAbout" Value="False"><Setter TargetName="PART_About" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="IsAboutOpen" Value="True"><Setter TargetName="PART_AboutText" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="ShowTitle" Value="False"><Setter TargetName="PART_Title" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_Breadcrumb" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_IconTile" Property="Visibility" Value="Collapsed"/></Trigger>
    <!-- No breadcrumb (History, Settings): the line keeps its height, so the title sits at the same place on every page. -->
    <Trigger Property="Breadcrumb" Value=""><Setter TargetName="PART_Breadcrumb" Property="Visibility" Value="Hidden"/></Trigger>
    <Trigger Property="HasMeta" Value="False"><Setter TargetName="PART_Meta" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="IsShort" Value="True">
     <Setter TargetName="PART_Subtitle" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_About" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_AboutText" Property="Visibility" Value="Collapsed"/>
    </Trigger>
    <Trigger Property="IsCompact" Value="True">
     <Setter TargetName="PART_Meta" Property="Grid.Row" Value="1"/><Setter TargetName="PART_Meta" Property="Grid.Column" Value="0"/><Setter TargetName="PART_Meta" Property="Grid.ColumnSpan" Value="2"/>
     <Setter TargetName="PART_Meta" Property="HorizontalAlignment" Value="Left"/><Setter TargetName="PART_Meta" Property="MaxWidth" Value="Infinity"/><Setter TargetName="PART_Meta" Property="Margin" Value="0,2,0,0"/>
     <Setter TargetName="PART_Actions" Property="Grid.Row" Value="2"/><Setter TargetName="PART_Actions" Property="Grid.Column" Value="0"/><Setter TargetName="PART_Actions" Property="Grid.ColumnSpan" Value="3"/>
     <Setter TargetName="PART_Actions" Property="HorizontalAlignment" Value="Left"/><Setter TargetName="PART_Actions" Property="Margin" Value="0,12,0,0"/>
    </Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ctl:PageHeader" BasedOn="{StaticResource WinoraPageHeaderStyle}"/>

 <!-- Info banner: tinted by severity, icon plus text, optional action content, named close button. Based on the WPF-UI info bar so its properties stay. -->
 <Style x:Key="WinoraInfoBannerStyle" TargetType="ctl:InfoBanner">
  <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Margin" Value="{StaticResource WinoraBannerMargin}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ctl:InfoBanner">
   <Border x:Name="Root" Background="{DynamicResource WinoraStatusInfoBackground}" BorderBrush="{DynamicResource WinoraStatusInfoBorder}" BorderThickness="{DynamicResource WinoraChipBorderThickness}"
    CornerRadius="{StaticResource WinoraCornerRadius}" Padding="12,8">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ui:SymbolIcon x:Name="Icon" Symbol="Info20" FontSize="24" Foreground="{DynamicResource WinoraStatusInfoForeground}" VerticalAlignment="Top" Margin="0,0,12,0"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock x:Name="TitleText" Style="{StaticResource WinoraBodyStrong}" Text="{TemplateBinding Title}" Foreground="{DynamicResource WinoraStatusInfoForeground}"/>
      <TextBlock x:Name="MessageText" Style="{StaticResource WinoraBody}" Text="{TemplateBinding Message}" Foreground="{DynamicResource WinoraStatusInfoForeground}"/>
      <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
     </StackPanel>
     <ui:Button x:Name="CloseButton" Grid.Column="2" Icon="{ui:SymbolIcon Dismiss20}" Appearance="Transparent" Command="{TemplateBinding TemplateButtonCommand}" VerticalAlignment="Top" Margin="8,-4,-4,-4"
      AutomationProperties.Name="{Binding CloseText, RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.HelpText="{Binding CloseText, RelativeSource={RelativeSource TemplatedParent}}"
      Foreground="{DynamicResource WinoraStatusInfoForeground}"/>
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsClosable" Value="False"><Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="Message" Value=""><Setter TargetName="MessageText" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="Title" Value=""><Setter TargetName="TitleText" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="Severity" Value="Success">
     <Setter TargetName="Root" Property="Background" Value="{DynamicResource WinoraStatusSuccessBackground}"/><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource WinoraStatusSuccessBorder}"/>
     <Setter TargetName="Icon" Property="Symbol" Value="CheckmarkCircle20"/><Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource WinoraStatusSuccessForeground}"/>
     <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource WinoraStatusSuccessForeground}"/><Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource WinoraStatusSuccessForeground}"/>
     <Setter TargetName="CloseButton" Property="Foreground" Value="{DynamicResource WinoraStatusSuccessForeground}"/>
    </Trigger>
    <Trigger Property="Severity" Value="Warning">
     <Setter TargetName="Root" Property="Background" Value="{DynamicResource WinoraStatusWarningBackground}"/><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource WinoraStatusWarningBorder}"/>
     <Setter TargetName="Icon" Property="Symbol" Value="Warning20"/><Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource WinoraStatusWarningForeground}"/>
     <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource WinoraStatusWarningForeground}"/><Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource WinoraStatusWarningForeground}"/>
     <Setter TargetName="CloseButton" Property="Foreground" Value="{DynamicResource WinoraStatusWarningForeground}"/>
    </Trigger>
    <Trigger Property="Severity" Value="Error">
     <Setter TargetName="Root" Property="Background" Value="{DynamicResource WinoraStatusErrorBackground}"/><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource WinoraStatusErrorBorder}"/>
     <Setter TargetName="Icon" Property="Symbol" Value="ErrorCircle20"/><Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource WinoraStatusErrorForeground}"/>
     <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource WinoraStatusErrorForeground}"/><Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource WinoraStatusErrorForeground}"/>
     <Setter TargetName="CloseButton" Property="Foreground" Value="{DynamicResource WinoraStatusErrorForeground}"/>
    </Trigger>
    <Trigger Property="Kind" Value="AdminNeeded"><Setter TargetName="Icon" Property="Symbol" Value="Shield20"/></Trigger>
    <Trigger Property="Kind" Value="UnsafeLocation"><Setter TargetName="Icon" Property="Symbol" Value="FolderProhibited20"/></Trigger>
    <Trigger Property="Kind" Value="ProtectedByPolicy"><Setter TargetName="Icon" Property="Symbol" Value="LockClosed20"/></Trigger>
    <Trigger Property="Kind" Value="RestartNeeded"><Setter TargetName="Icon" Property="Symbol" Value="ArrowClockwise20"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
  <Style.Triggers>
   <Trigger Property="IsOpen" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="ctl:InfoBanner" BasedOn="{StaticResource WinoraInfoBannerStyle}"/>

 <!-- Empty state: icon, headline, one sentence, at most one action. -->
 <Style x:Key="WinoraEmptyStateStyle" TargetType="ctl:EmptyState">
  <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Margin" Value="0,32"/><Setter Property="MaxWidth" Value="440"/>
  <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ctl:EmptyState">
   <StackPanel>
    <ui:SymbolIcon Symbol="{TemplateBinding Icon}" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
    <TextBlock Style="{StaticResource WinoraSubtitle}" Text="{TemplateBinding Headline}" TextAlignment="Center" Margin="0,12,0,4"/>
    <TextBlock x:Name="MessageText" Style="{StaticResource WinoraBodySecondary}" Text="{TemplateBinding Message}" TextAlignment="Center"/>
    <ui:Button x:Name="ActionButton" Appearance="Primary" Content="{TemplateBinding ActionText}" Command="{TemplateBinding ActionCommand}" Icon="{TemplateBinding ActionIcon}" HorizontalAlignment="Center" Margin="0,16,0,0"
     AutomationProperties.Name="{Binding ActionText, RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.HelpText="{Binding ActionHelp, RelativeSource={RelativeSource TemplatedParent}}"/>
   </StackPanel>
   <ControlTemplate.Triggers>
    <Trigger Property="HasMessage" Value="False"><Setter TargetName="MessageText" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="HasAction" Value="False"><Setter TargetName="ActionButton" Property="Visibility" Value="Collapsed"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ctl:EmptyState" BasedOn="{StaticResource WinoraEmptyStateStyle}"/>

 <!-- Error state: warning icon, headline, cause, one next step, details with the reference code. Assertive once. -->
 <Style x:Key="WinoraErrorStateStyle" TargetType="ctl:ErrorState">
  <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Margin" Value="0,32"/><Setter Property="MaxWidth" Value="440"/>
  <Setter Property="AutomationProperties.LiveSetting" Value="Assertive"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ctl:ErrorState">
   <StackPanel>
    <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
    <TextBlock Style="{StaticResource WinoraSubtitle}" Text="{TemplateBinding Headline}" TextAlignment="Center" Margin="0,12,0,4"/>
    <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{TemplateBinding Message}" TextAlignment="Center"/>
    <ui:Button x:Name="ActionButton" Content="{TemplateBinding ActionText}" Command="{TemplateBinding ActionCommand}" Icon="{ui:SymbolIcon ArrowClockwise24}" HorizontalAlignment="Center" Margin="0,16,0,0"
     AutomationProperties.Name="{Binding ActionText, RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.HelpText="{Binding ActionHelp, RelativeSource={RelativeSource TemplatedParent}}"/>
    <Expander x:Name="DetailsExpander" Header="{TemplateBinding DetailsHeader}" Margin="0,12,0,0" HorizontalAlignment="Center">
     <TextBox Text="{Binding Details, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Style="{DynamicResource WinoraLtrText}" AutomationProperties.Name="{Binding DetailsHeader, RelativeSource={RelativeSource TemplatedParent}}"/>
    </Expander>
   </StackPanel>
   <ControlTemplate.Triggers>
    <Trigger Property="HasAction" Value="False"><Setter TargetName="ActionButton" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="HasDetails" Value="False"><Setter TargetName="DetailsExpander" Property="Visibility" Value="Collapsed"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ctl:ErrorState" BasedOn="{StaticResource WinoraErrorStateStyle}"/>

 <!-- Loading skeleton: the text is always visible; the blocks are decoration and are built in code. -->
 <Style x:Key="WinoraLoadingSkeletonStyle" TargetType="ctl:LoadingSkeleton">
  <Setter Property="Margin" Value="0,8,0,8"/><Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ctl:LoadingSkeleton">
   <StackPanel>
    <TextBlock Style="{StaticResource WinoraBodySecondary}" Text="{TemplateBinding Message}" Margin="0,0,0,12"/>
    <StackPanel x:Name="PART_Blocks"/>
   </StackPanel>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ctl:LoadingSkeleton" BasedOn="{StaticResource WinoraLoadingSkeletonStyle}"/>

 <!-- Category tab rail: one row, never wraps. A tab is text with a 3 px accent line under the selected one; the selected label is primary text and semibold, like the pivot tabs and the filter bar tabs. -->
 <Style x:Key="WinoraRailTabItem" TargetType="TabItem">
  <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
  <Setter Property="FocusVisualStyle" Value="{DynamicResource WinoraFocusRect}"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
   <Border x:Name="Bar" Padding="12,0" Margin="0,0,4,0" BorderThickness="0,0,0,3" BorderBrush="Transparent" Background="Transparent" MinHeight="{DynamicResource MinHitTarget}" SnapsToDevicePixels="True">
    <ContentPresenter x:Name="Label" ContentSource="Header" VerticalAlignment="Center" TextElement.FontWeight="Normal" TextElement.Foreground="{TemplateBinding Foreground}"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
    <Trigger Property="IsSelected" Value="True">
     <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
     <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
     <Setter TargetName="Bar" Property="TextElement.FontWeight" Value="SemiBold"/>
    </Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bar" Property="Opacity" Value="0.5"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- A tab of a rail that mirrors the tabs of a TabControl (TabRail.ContentTabs): header, name, shown and enabled are read from that tab. -->
 <Style x:Key="WinoraRailMirrorTabItem" TargetType="TabItem" BasedOn="{StaticResource WinoraRailTabItem}">
  <Setter Property="Visibility" Value="{Binding Header.Tab.Visibility, RelativeSource={RelativeSource Self}}"/>
  <Setter Property="IsEnabled" Value="{Binding Header.Tab.IsEnabled, RelativeSource={RelativeSource Self}}"/>
  <Setter Property="AutomationProperties.Name" Value="{Binding Header.Tab.(AutomationProperties.Name), RelativeSource={RelativeSource Self}}"/>
 </Style>
 <DataTemplate x:Key="WinoraRailMirrorHeader" DataType="{x:Type ctl:TabRailEntry}"><ContentPresenter Content="{Binding Tab.Header}"/></DataTemplate>
 <Style x:Key="WinoraTabRailStyle" TargetType="ctl:TabRail">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
  <Setter Property="KeyboardNavigation.TabNavigation" Value="Once"/><Setter Property="KeyboardNavigation.DirectionalNavigation" Value="None"/>
  <Setter Property="ItemContainerStyle" Value="{StaticResource WinoraRailMirrorTabItem}"/>
  <Setter Property="ItemTemplate" Value="{StaticResource WinoraRailMirrorHeader}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ctl:TabRail">
   <Grid x:Name="Root" Background="Transparent">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ui:Button x:Name="PART_Previous" Grid.Column="0" Appearance="Transparent" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0" Margin="0,0,4,0" VerticalAlignment="Center" Focusable="False" IsTabStop="False"
     IsEnabled="{TemplateBinding CanScrollPrevious}" Visibility="Collapsed"
     AutomationProperties.Name="{Binding PreviousText, RelativeSource={RelativeSource TemplatedParent}}" ToolTip="{Binding PreviousText, RelativeSource={RelativeSource TemplatedParent}}">
     <!-- The icon font does not mirror its glyphs: in right-to-left a trigger swaps the two chevrons, so each button points toward its end of the row. -->
     <ui:SymbolIcon x:Name="PreviousIcon" Symbol="ChevronLeft24" FontSize="16"/>
    </ui:Button>
    <ScrollViewer x:Name="PART_Scroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" CanContentScroll="False" PanningMode="HorizontalOnly">
     <StackPanel x:Name="PART_Items" IsItemsHost="True" Orientation="Horizontal"/>
    </ScrollViewer>
    <ui:Button x:Name="PART_Next" Grid.Column="2" Appearance="Transparent" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0" Margin="4,0,0,0" VerticalAlignment="Center" Focusable="False" IsTabStop="False"
     IsEnabled="{TemplateBinding CanScrollNext}" Visibility="Collapsed"
     AutomationProperties.Name="{Binding NextText, RelativeSource={RelativeSource TemplatedParent}}" ToolTip="{Binding NextText, RelativeSource={RelativeSource TemplatedParent}}">
     <ui:SymbolIcon x:Name="NextIcon" Symbol="ChevronRight24" FontSize="16"/>
    </ui:Button>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="FlowDirection" Value="RightToLeft"><Setter TargetName="PreviousIcon" Property="Symbol" Value="ChevronRight24"/><Setter TargetName="NextIcon" Property="Symbol" Value="ChevronLeft24"/></Trigger>
    <Trigger Property="HasOverflow" Value="True">
     <Setter TargetName="PART_Previous" Property="Visibility" Value="Visible"/><Setter TargetName="PART_Next" Property="Visibility" Value="Visible"/>
    </Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ctl:TabRail" BasedOn="{StaticResource WinoraTabRailStyle}"/>

 <!-- The content area of a TabControl whose tabs are drawn by a TabRail elsewhere: only the selected content. -->
 <Style x:Key="WinoraTabContentStyle" TargetType="TabControl">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
   <ContentPresenter ContentSource="SelectedContent" Focusable="False"/>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- The page frame: a fixed band (header, tab rail, toolbar) over one scrolling body. -->
 <Style x:Key="WinoraPageWorkspaceStyle" TargetType="ctl:PageWorkspace">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ctl:PageWorkspace">
   <!-- The band draws over the body (Panel.ZIndex), which also moves it last in the visual order. The grid, the band and the body are tab groups with indexes, so the keyboard order stays band, then body. -->
   <Grid KeyboardNavigation.TabNavigation="Local">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="PART_Band" Grid.Row="0" Background="{DynamicResource WinoraSurfaceCardBrush}" BorderBrush="{DynamicResource WinoraCardBorderBrush}" BorderThickness="0,0,0,1" Panel.ZIndex="1" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="0">
     <ScrollViewer x:Name="PART_BandScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel>
       <ContentPresenter x:Name="HeaderSlot" Content="{TemplateBinding Header}"/>
       <ContentPresenter x:Name="TabsSlot" Content="{TemplateBinding Tabs}"/>
       <ContentPresenter x:Name="ToolbarSlot" Content="{TemplateBinding Toolbar}"/>
      </StackPanel>
     </ScrollViewer>
    </Border>
    <ScrollViewer x:Name="PART_Scroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="1">
     <Border x:Name="PART_BodyInset">
      <Grid x:Name="PART_BodyGrid">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="PART_BodyRow" Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ContentPresenter x:Name="BannersSlot" Grid.Row="0" Content="{TemplateBinding Banners}"/>
       <ContentPresenter x:Name="BodySlot" Grid.Row="1" Content="{TemplateBinding Body}"/>
       <ContentPresenter x:Name="FooterSlot" Grid.Row="2" Content="{TemplateBinding Footer}"/>
      </Grid>
     </Border>
    </ScrollViewer>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="HasBand" Value="False"><Setter TargetName="PART_Band" Property="Visibility" Value="Collapsed"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ctl:DashboardPage" BasedOn="{StaticResource WinoraPageWorkspaceStyle}"/>
 <Style TargetType="ctl:SettingsPage" BasedOn="{StaticResource WinoraPageWorkspaceStyle}"/>
 <Style TargetType="ctl:ListPage" BasedOn="{StaticResource WinoraPageWorkspaceStyle}"/>
 <Style TargetType="ctl:ToolPage" BasedOn="{StaticResource WinoraPageWorkspaceStyle}"/>
 <Style TargetType="ctl:ReportPage" BasedOn="{StaticResource WinoraPageWorkspaceStyle}"/>

 <!-- Card header: the title of a grouped list as the top of its card. With rows under it the bottom corners and edge belong to the rows. -->
 <Style x:Key="WinoraCardHeaderStyle" TargetType="ctl:CardHeader">
  <Setter Property="Margin" Value="0,16,0,0"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ctl:CardHeader">
   <Border x:Name="Frame" Background="{DynamicResource WinoraSurfaceCardBrush}" BorderBrush="{DynamicResource WinoraCardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource WinoraCornerRadius}"
    Padding="{DynamicResource WinoraCardPadding}" SnapsToDevicePixels="True">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="TitleText" Style="{StaticResource WinoraBodyStrong}" Text="{TemplateBinding Title}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
      <TextBlock x:Name="DescriptionText" Style="{StaticResource WinoraCaption}" Text="{TemplateBinding Description}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>
     </StackPanel>
     <TextBlock x:Name="CountText" Grid.Column="1" Style="{StaticResource WinoraCaption}" Text="{TemplateBinding Count}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
     <ContentPresenter x:Name="ActionsHost" Grid.Column="2" Content="{TemplateBinding Actions}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
     <!-- At the end of the row, pointing down when folded, like the Startup groups and the change log card. -->
     <ctl:TurningChevron x:Name="Chevron" Grid.Column="3" IsOpen="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}}" Margin="16,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsFoldable" Value="True"><Setter TargetName="Chevron" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="HasDescription" Value="True"><Setter TargetName="DescriptionText" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="HasCount" Value="True"><Setter TargetName="CountText" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="HasActions" Value="True"><Setter TargetName="ActionsHost" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsHeading" Value="False"><Setter TargetName="TitleText" Property="AutomationProperties.HeadingLevel" Value="None"/></Trigger>
    <Trigger Property="ActionsBelow" Value="True">
     <Setter TargetName="ActionsHost" Property="Grid.Row" Value="1"/><Setter TargetName="ActionsHost" Property="Grid.Column" Value="0"/><Setter TargetName="ActionsHost" Property="Grid.ColumnSpan" Value="4"/>
     <Setter TargetName="ActionsHost" Property="Margin" Value="0,8,0,0"/><Setter TargetName="ActionsHost" Property="HorizontalAlignment" Value="Left"/>
    </Trigger>
    <Trigger Property="HasRows" Value="True">
     <Setter TargetName="Frame" Property="BorderThickness" Value="1,1,1,0"/><Setter TargetName="Frame" Property="CornerRadius" Value="8,8,0,0"/>
    </Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ctl:CardHeader" BasedOn="{StaticResource WinoraCardHeaderStyle}"/>
</ResourceDictionary>
