<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <!-- Design tokens: 4px grid, 8px corners, Fluent type ramp. Colors always come from theme brushes. -->
 <FontFamily x:Key="WinoraFontFamily">Segoe UI Variable Text, Segoe UI, Tahoma</FontFamily>
 <FontFamily x:Key="WinoraMonoFontFamily">Consolas, Courier New</FontFamily>
 <CornerRadius x:Key="WinoraCornerRadius">8</CornerRadius>
 <Thickness x:Key="PagePadding">32,16,32,32</Thickness>
 <Thickness x:Key="CompactPagePadding">16,12,16,24</Thickness>
 <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

 <Style x:Key="WinoraCaption" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="{DynamicResource WinoraLineCaption}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/></Style>
 <Style x:Key="WinoraBody" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="LineHeight" Value="{DynamicResource WinoraLineBody}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Style>
 <Style x:Key="WinoraBodySecondary" TargetType="TextBlock" BasedOn="{StaticResource WinoraBody}"><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/></Style>
 <Style x:Key="WinoraBodyStrong" TargetType="TextBlock" BasedOn="{StaticResource WinoraBody}"><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="WinoraSubtitle" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="LineHeight" Value="{DynamicResource WinoraLineSubtitle}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Style>
 <Style x:Key="WinoraTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="28"/><Setter Property="LineHeight" Value="{DynamicResource WinoraLineTitle}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Style>
 <!-- Keyboard focus outline for non-control targets (page headings). Uses the primary text brush so it keeps contrast in every theme. -->
 <Style x:Key="WinoraFocusRect"><Setter Property="Control.Template"><Setter.Value><ControlTemplate>
  <Rectangle Margin="-3" SnapsToDevicePixels="True" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="2" RadiusX="4" RadiusY="4"/>
 </ControlTemplate></Setter.Value></Setter></Style>
 <!-- Page heading: Level 1 heading for assistive technology and the target of keyboard focus after navigation (not a tab stop).
 It is text, not a control, so the focus is not drawn: a box around the title read as a selection and covered the subtitle. -->
 <Style x:Key="WinoraPageHeading" TargetType="TextBlock" BasedOn="{StaticResource WinoraTitle}">
  <Setter Property="Focusable" Value="True"/><Setter Property="KeyboardNavigation.IsTabStop" Value="False"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="AutomationProperties.HeadingLevel" Value="Level1"/>
 </Style>
 <Style x:Key="WinoraSectionHeading" TargetType="TextBlock" BasedOn="{StaticResource WinoraBodyStrong}"><Setter Property="FontSize" Value="16"/><Setter Property="LineHeight" Value="{DynamicResource WinoraLineSection}"/><Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/></Style>
 <!-- First-run titles only. Line height follows the language (Persian marks are taller). -->
 <Style x:Key="WinoraDisplay" TargetType="TextBlock"><Setter Property="FontSize" Value="32"/><Setter Property="LineHeight" Value="{DynamicResource WinoraLineDisplay}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Style>
 <!-- Paths, registry names and commands: always left to right. -->
 <Style x:Key="WinoraMono" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource WinoraMonoFontFamily}"/><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="{DynamicResource WinoraLineCaption}"/><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Style>
 <!-- Chip text: 12/16 semibold. -->
 <Style x:Key="WinoraChipText" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="{DynamicResource WinoraLineCaption}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
 <Style x:Key="WinoraValue" TargetType="TextBlock"><Setter Property="FontSize" Value="24"/><Setter Property="LineHeight" Value="{DynamicResource WinoraLineValue}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Style>
 <!-- Title bar and Action center button text. -->
 <Style x:Key="WinoraChromeText" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
 <Style x:Key="WinoraChromeTextStrong" TargetType="TextBlock" BasedOn="{StaticResource WinoraChromeText}"><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <!-- Count in a badge (11) and the mark beside the Action center label (10). -->
 <Style x:Key="WinoraBadgeText" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="WinoraBadgeMarkText" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <!-- Number inside a score ring: large on the Overview ring, a little smaller on the performance ring. -->
 <Style x:Key="WinoraRingNumber" TargetType="TextBlock" BasedOn="{StaticResource WinoraValue}"><Setter Property="FontSize" Value="40"/></Style>
 <Style x:Key="WinoraRingNumberSmall" TargetType="TextBlock" BasedOn="{StaticResource WinoraValue}"><Setter Property="FontSize" Value="36"/></Style>
 <!-- Title of a card that is not a page section (a profile): 16 semibold, a heading for assistive technology. -->
 <Style x:Key="WinoraCardTitle" TargetType="TextBlock" BasedOn="{StaticResource WinoraSubtitle}"><Setter Property="FontSize" Value="16"/><Setter Property="LineHeight" Value="{DynamicResource WinoraLineSection}"/><Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/></Style>
</ResourceDictionary>
