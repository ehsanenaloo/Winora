<!-- Tune pages of the new design (Optimize, Power, Network, Privacy, Windows Update): the action card (same chrome as a setting card), an equal-size row button and the card expander. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ctl="clr-namespace:Winora.Desktop.Controls">
 <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="Tokens.xaml"/>
  <ResourceDictionary Source="Theme.xaml"/>
 </ResourceDictionary.MergedDictionaries>

 <!-- A row card with text on one side and a control or button on the other: the same surface, edge, radius, gap and height as a setting card. -->
 <Style x:Key="WinoraActionCard" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource WinoraSurfaceCardBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource WinoraCardBorderBrush}"/>
  <Setter Property="BorderThickness" Value="{DynamicResource WinoraBorderThickness}"/>
  <Setter Property="CornerRadius" Value="{DynamicResource WinoraCornerRadius}"/>
  <Setter Property="Padding" Value="{DynamicResource WinoraCardPadding}"/>
  <Setter Property="MinHeight" Value="{DynamicResource WinoraRowMinHeight}"/>
  <Setter Property="Margin" Value="0,0,0,8"/>
  <Setter Property="SnapsToDevicePixels" Value="True"/>
 </Style>

 <!-- A row inside a section card: the card of the section is made of its header, these rows and the cap under the last one. -->
 <Style x:Key="WinoraSectionRow" TargetType="Border" BasedOn="{StaticResource WinoraActionCard}">
  <Setter Property="BorderThickness" Value="1,1,1,0"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Margin" Value="0"/>
 </Style>
 <!-- The bottom edge of a section card: rounded corners and the closing line under the last row. -->
 <Style x:Key="WinoraCardCap" TargetType="Border">
  <Setter Property="Height" Value="8"/><Setter Property="Margin" Value="0,0,0,8"/>
  <Setter Property="Background" Value="{DynamicResource WinoraSurfaceCardBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource WinoraCardBorderBrush}"/>
  <Setter Property="BorderThickness" Value="1,0,1,1"/>
  <Setter Property="CornerRadius" Value="0,0,8,8"/>
  <Setter Property="SnapsToDevicePixels" Value="True"/>
 </Style>

 <!-- The card of the row that is in use (the active plan or update mode): the edge takes the accent. -->
 <Style x:Key="WinoraActiveActionCard" TargetType="Border" BasedOn="{StaticResource WinoraActionCard}">
  <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
 </Style>

 <!-- One button size for every row action: buttons in a column line up and have the same height. -->
 <Style x:Key="WinoraRowButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
  <Setter Property="MinHeight" Value="{DynamicResource WinoraControlHeight}"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="HorizontalAlignment" Value="Right"/>
  <Setter Property="Margin" Value="0"/>
 </Style>
 <!-- A row action that removes or deletes something: transparent with red text, and the disabled text color while it cannot be used
      (a local red Foreground kept disabled buttons red, so they looked active). -->
 <Style x:Key="WinoraDangerRowButton" TargetType="ui:Button" BasedOn="{StaticResource WinoraRowButton}">
  <Setter Property="Appearance" Value="Transparent"/>
  <Setter Property="Foreground" Value="{DynamicResource WinoraRiskHighForeground}"/>
  <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/></Trigger></Style.Triggers>
 </Style>

 <!-- A heading between groups of cards. -->
 <Style x:Key="WinoraTuneSection" TargetType="TextBlock" BasedOn="{StaticResource WinoraSectionHeading}">
  <Setter Property="Margin" Value="0,16,0,8"/>
 </Style>

 <!-- A caption under a heading or a banner-like note inside a card. -->
 <Style x:Key="WinoraTuneNote" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource WinoraStatusWarningBackground}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource WinoraStatusWarningBorder}"/>
  <Setter Property="BorderThickness" Value="{DynamicResource WinoraChipBorderThickness}"/>
  <Setter Property="CornerRadius" Value="{DynamicResource WinoraCornerRadiusSmall}"/>
  <Setter Property="Padding" Value="12,8"/>
 </Style>

 <!-- Header of a card expander: the whole row is the toggle, the chevron sits at the end and turns. -->
 <Style x:Key="WinoraCardExpanderHeader" TargetType="ctl:ChevronToggle">
  <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
  <Setter Property="MinHeight" Value="{DynamicResource WinoraRowMinHeight}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="FocusVisualStyle" Value="{DynamicResource WinoraFocusRect}"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ctl:ChevronToggle">
   <Border x:Name="Frame" Background="Transparent" CornerRadius="{DynamicResource WinoraCornerRadius}" Padding="{DynamicResource WinoraCardPadding}" MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
     <ui:SymbolIcon x:Name="PART_Chevron" Grid.Column="1" Symbol="ChevronDown20" FontSize="16" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style TargetType="ctl:CardExpander">
  <Setter Property="Margin" Value="0,0,0,8"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ctl:CardExpander">
   <Border Background="{DynamicResource WinoraSurfaceCardBrush}" BorderBrush="{DynamicResource WinoraCardBorderBrush}" BorderThickness="{DynamicResource WinoraBorderThickness}"
    CornerRadius="{DynamicResource WinoraCornerRadius}" SnapsToDevicePixels="True">
    <StackPanel>
     <ctl:ChevronToggle x:Name="Toggle" Style="{StaticResource WinoraCardExpanderHeader}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
      AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ui:SymbolIcon x:Name="Lead" Symbol="{Binding Icon, RelativeSource={RelativeSource AncestorType=ctl:CardExpander}}" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
       <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Header, RelativeSource={RelativeSource AncestorType=ctl:CardExpander}}" TextWrapping="Wrap"/>
        <TextBlock x:Name="Sub" Style="{StaticResource WinoraCaption}" Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=ctl:CardExpander}}" TextWrapping="Wrap" Margin="0,2,0,0"/>
       </StackPanel>
      </Grid>
     </ctl:ChevronToggle>
     <StackPanel x:Name="Body" Margin="16,0,16,16">
      <Border x:Name="WarningBox" Style="{StaticResource WinoraTuneNote}" Margin="0,0,0,8">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ui:SymbolIcon Symbol="Warning20" FontSize="16" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{DynamicResource WinoraStatusWarningForeground}"/>
        <TextBlock Grid.Column="1" Style="{StaticResource WinoraCaption}" Text="{TemplateBinding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource WinoraStatusWarningForeground}"/>
       </Grid>
      </Border>
      <ContentPresenter/>
     </StackPanel>
    </StackPanel>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsExpanded" Value="False"><Setter TargetName="Body" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="Warning" Value=""><Setter TargetName="WarningBox" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="Subtitle" Value=""><Setter TargetName="Sub" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="Icon" Value="Empty"><Setter TargetName="Lead" Property="Visibility" Value="Collapsed"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- Recent changes: one card, closed at first; the open list scrolls inside the card and has compact rows. -->
 <Style TargetType="ctl:ChangeLogCard">
  <Setter Property="Margin" Value="0,16,0,0"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ctl:ChangeLogCard">
   <Border Background="{DynamicResource WinoraSurfaceCardBrush}" BorderBrush="{DynamicResource WinoraCardBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource WinoraCornerRadius}" SnapsToDevicePixels="True">
    <StackPanel>
     <ToggleButton x:Name="Toggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Cursor="Hand" FocusVisualStyle="{x:Null}"
      AutomationProperties.Name="{TemplateBinding ToggleName}" AutomationProperties.HelpText="{TemplateBinding ToggleName}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border x:Name="Frame" Background="Transparent" CornerRadius="7" MinHeight="48" Padding="16,8">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <ui:SymbolIcon Symbol="History20" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
         <ContentPresenter Grid.Column="1" Content="{Binding Header, RelativeSource={RelativeSource AncestorType=ctl:ChangeLogCard}}" TextElement.FontWeight="SemiBold" VerticalAlignment="Center"/>
         <TextBlock Grid.Column="2" Text="{Binding CountText, RelativeSource={RelativeSource AncestorType=ctl:ChangeLogCard}}" Style="{DynamicResource WinoraCaption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
         <ctl:TurningChevron Grid.Column="3" IsOpen="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </Grid>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource WinoraFocusBrush}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ScrollViewer x:Name="Body" Visibility="Collapsed" MaxHeight="{TemplateBinding MaxBodyHeight}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <ItemsPresenter/>
     </ScrollViewer>
    </StackPanel>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="WinoraChangeLogRow" TargetType="Border">
  <Setter Property="BorderBrush" Value="{DynamicResource WinoraCardBorderBrush}"/><Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="Padding" Value="16,8"/><Setter Property="MinHeight" Value="48"/>
 </Style>
 <Style x:Key="WinoraChangeLogUndo" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
  <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="12,4"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="16,0,0,0"/>
 </Style>

</ResourceDictionary>
