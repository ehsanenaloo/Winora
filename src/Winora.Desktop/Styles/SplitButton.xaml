<!-- The split button: icon and text with the command, a small arrow that opens the menu. One border around both parts and a thin line between them. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ctl="clr-namespace:Winora.Desktop.Controls">
 <Style TargetType="ctl:MenuSplitButton">
  <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ctl:MenuSplitButton">
   <Border CornerRadius="{StaticResource WinoraCornerRadiusSmall}" BorderThickness="1" BorderBrush="{DynamicResource WinoraControlBorderBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}" SnapsToDevicePixels="True">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ui:Button x:Name="PART_Main" Grid.Column="0" Appearance="Transparent" BorderThickness="0" Background="Transparent" CornerRadius="3,0,0,3" MinHeight="{DynamicResource WinoraControlHeight}" Padding="12,0"
      Command="{TemplateBinding Command}" CommandParameter="{TemplateBinding CommandParameter}" HorizontalContentAlignment="Center"
      AutomationProperties.Name="{TemplateBinding MainName}" AutomationProperties.HelpText="{TemplateBinding MainHelp}">
      <StackPanel Orientation="Horizontal">
       <ui:SymbolIcon Symbol="{TemplateBinding Symbol}" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <TextBlock Text="{TemplateBinding Text}" VerticalAlignment="Center"/>
      </StackPanel>
     </ui:Button>
     <Rectangle Grid.Column="1" Fill="{DynamicResource WinoraControlBorderBrush}" Margin="0,4"/>
     <ui:Button x:Name="PART_Drop" Grid.Column="2" Appearance="Transparent" BorderThickness="0" Background="Transparent" CornerRadius="0,3,3,0" MinWidth="32" MinHeight="{DynamicResource WinoraControlHeight}" Padding="8,0"
      AutomationProperties.Name="{TemplateBinding MenuName}" AutomationProperties.HelpText="{TemplateBinding MenuHelp}">
      <ui:SymbolIcon Symbol="ChevronDown16" FontSize="16"/>
     </ui:Button>
    </Grid>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
