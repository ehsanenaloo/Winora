<!-- Text boxes and drop-down lists: one height (36 px), one inner padding, a drop-down that is as wide as its text needs and no wider. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
  <Setter Property="MinHeight" Value="36"/><Setter Property="MinWidth" Value="140"/><Setter Property="Padding" Value="12,4,8,4"/><Setter Property="VerticalContentAlignment" Value="Center"/>
 </Style>
 <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
  <Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/>
 </Style>
 <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
  <Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/>
 </Style>
</ResourceDictionary>
