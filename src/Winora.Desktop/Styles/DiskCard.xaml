<!-- One disk, shown the same way on every page: icon, letter and kind, chips (SYSTEM, bus, disk type, file system), model, brand and serial number, used of total and a bar that turns amber and red. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:Winora.Desktop" xmlns:vm="clr-namespace:Winora.Desktop;assembly=Winora.Presentation" xmlns:ctl="clr-namespace:Winora.Desktop.Controls">
 <DataTemplate x:Key="WinoraDriveRowTemplate" DataType="{x:Type vm:DriveRow}">
   <Border Style="{StaticResource WinoraCardBorder}" Margin="0,0,12,8" Padding="16" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding AutomationName}">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ui:SymbolIcon Symbol="HardDrive20" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
     <StackPanel Grid.Column="1">
      <WrapPanel>
       <TextBlock Style="{StaticResource WinoraBodyStrong}" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <ItemsControl ItemsSource="{Binding Chips}" IsTabStop="False" Focusable="False" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
         <DataTemplate><ctl:StatusBadge Kind="Neutral" Text="{Binding Text}"/></DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </WrapPanel>
      <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding Model}" Margin="0,2,0,0" Visibility="{Binding HasModel, Converter={StaticResource BoolToVisibility}}"/>
      <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Details}" Margin="0,2,0,0" HorizontalAlignment="Left" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}"/>
      <TextBlock Style="{StaticResource WinoraBody}" Text="{Binding UsedText}" Margin="0,2,0,0"/>
      <ProgressBar x:Name="UsageBar" Minimum="0" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}" Height="6" Margin="0,8,0,0" Focusable="False" IsTabStop="False" AutomationProperties.Name="{Binding UsedText}"
       Foreground="{DynamicResource WinoraRingGoodBrush}"/>
      <TextBlock Style="{StaticResource WinoraCaption}" Text="{Binding Warning}" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" FontWeight="SemiBold" Margin="0,4,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding Band}" Value="Fair"><Setter TargetName="UsageBar" Property="Foreground" Value="{DynamicResource WinoraRingFairBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding Band}" Value="Low"><Setter TargetName="UsageBar" Property="Foreground" Value="{DynamicResource WinoraRingLowBrush}"/></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
