<!-- Layout, shape, elevation and motion tokens, and the disk map palette. Colors live in Colors.Light.xaml and Colors.Dark.xaml; density-dependent sizes live in the Density files. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" mc:Ignorable="po">
 <!-- 4 px grid -->
 <sys:Double x:Key="WinoraSpace1">4</sys:Double>
 <sys:Double x:Key="WinoraSpace2">8</sys:Double>
 <sys:Double x:Key="WinoraSpace3">12</sys:Double>
 <sys:Double x:Key="WinoraSpace4">16</sys:Double>
 <sys:Double x:Key="WinoraSpace5">20</sys:Double>
 <sys:Double x:Key="WinoraSpace6">24</sys:Double>
 <sys:Double x:Key="WinoraSpace8">32</sys:Double>
 <sys:Double x:Key="WinoraSpace10">40</sys:Double>
 <sys:Double x:Key="WinoraSpace12">48</sys:Double>
