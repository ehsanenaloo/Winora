 <Thickness x:Key="MediumPagePadding">24,16,24,32</Thickness>
 <sys:Double x:Key="WinoraProseMaxWidth">640</sys:Double>
 <!-- Space under every info banner, on every page. -->
 <Thickness x:Key="WinoraBannerMargin">0,0,0,8</Thickness>
 <!-- Widest "Part of Windows" or "Protected by Winora" badge on an inventory row; longer text is cut with an ellipsis. -->
 <sys:Double x:Key="WinoraLockBadgeMaxWidth">200</sys:Double>

 <!-- Type sizes that pages need outside a text style (a mono box, an implicit control style). -->
 <sys:Double x:Key="WinoraFontSizeCaption">12</sys:Double>
 <sys:Double x:Key="WinoraFontSizeBody">14</sys:Double>
 <sys:Double x:Key="WinoraIconSizeLead">24</sys:Double>

 <!-- Disk usage map: one color per kind of file, the same in every theme (a color-blind safe palette; the map also draws a pattern per kind). -->
 <Color x:Key="WinoraDiskKindDocuments">#0072B2</Color>
 <Color x:Key="WinoraDiskKindImages">#E69F00</Color>
 <Color x:Key="WinoraDiskKindVideo">#CC79A7</Color>
 <Color x:Key="WinoraDiskKindAudio">#009E73</Color>
 <Color x:Key="WinoraDiskKindArchives">#D55E00</Color>
 <Color x:Key="WinoraDiskKindCode">#56B4E9</Color>
 <Color x:Key="WinoraDiskKindPrograms">#F0E442</Color>
 <Color x:Key="WinoraDiskKindSystemData">#7F7F7F</Color>
 <Color x:Key="WinoraDiskKindOther">#B8B8B8</Color>
 <Color x:Key="WinoraDiskKindUnlisted">#D9D9D9</Color>
 <Color x:Key="WinoraDiskKindUnreadable">#444444</Color>
 <Color x:Key="WinoraDiskKindFolder">#8A96A8</Color>

 <!-- Radius -->
 <CornerRadius x:Key="WinoraCornerRadiusSmall">4</CornerRadius>
 <CornerRadius x:Key="WinoraCornerRadiusLarge">12</CornerRadius>
 <CornerRadius x:Key="WinoraCornerRadiusPill">11</CornerRadius>

 <!-- Borders -->
 <Thickness x:Key="WinoraBorderThickness">1</Thickness>
 <Thickness x:Key="WinoraFocusThickness">2</Thickness>
 <sys:Double x:Key="WinoraStripeWidth">3</sys:Double>
 <Thickness x:Key="WinoraChipBorderThickness">1</Thickness>

 <!-- Elevation: level 0 has no shadow. Level 1 is for the action bar, flyouts and toasts. Level 2 is for dialogs. -->
 <DropShadowEffect x:Key="WinoraElevation1Light" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.14" Color="Black" po:Freeze="True"/>
 <DropShadowEffect x:Key="WinoraElevation1Dark" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.40" Color="Black" po:Freeze="True"/>
 <DropShadowEffect x:Key="WinoraElevation2Light" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.22" Color="Black" po:Freeze="True"/>
 <DropShadowEffect x:Key="WinoraElevation2Dark" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.50" Color="Black" po:Freeze="True"/>

 <!-- Motion. Motion.cs returns zero durations when Windows animations are off. -->
 <Duration x:Key="WinoraDurationFast">0:0:0.083</Duration>
 <Duration x:Key="WinoraDurationNormal">0:0:0.167</Duration>
 <Duration x:Key="WinoraDurationSlow">0:0:0.25</Duration>
 <CubicEase x:Key="WinoraEaseEnter" EasingMode="EaseOut" po:Freeze="True"/>
 <CubicEase x:Key="WinoraEaseExit" EasingMode="EaseIn" po:Freeze="True"/>
 <sys:Double x:Key="WinoraPageEntranceOffset">8</sys:Double>

 <!-- Line heights. Typography.Apply rewrites them with the Persian scale (1.1) in the application resources. -->
 <sys:Double x:Key="WinoraLineHeightScale">1</sys:Double>
 <sys:Double x:Key="WinoraLineCaption">16</sys:Double>
 <sys:Double x:Key="WinoraLineBody">20</sys:Double>
 <sys:Double x:Key="WinoraLineSection">22</sys:Double>
 <sys:Double x:Key="WinoraLineSubtitle">28</sys:Double>
 <sys:Double x:Key="WinoraLineValue">32</sys:Double>
 <sys:Double x:Key="WinoraLineTitle">36</sys:Double>
 <sys:Double x:Key="WinoraLineDisplay">40</sys:Double>
</ResourceDictionary>
